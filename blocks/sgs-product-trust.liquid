{%- liquid
  assign bs = block.settings
-%}

{%- unless closest.product.gift_card? -%}
<div class="sgs-ptrust-wrap sgs-ptrust-wrap--{{ bs.layout | default: 'line' }}" {{ block.shopify_attributes }}>
<ul class="sgs-ptrust" role="list">
  {%- for i in (1..4) -%}
    {%- liquid
      assign text_key = 'item_' | append: i | append: '_text'
      assign link_key = 'item_' | append: i | append: '_link'
      assign icon_key = 'item_' | append: i | append: '_icon'
      assign text = bs[text_key]
      assign link = bs[link_key] | strip
      assign icon = bs[icon_key] | default: 'truck'
    -%}
    {%- if text != blank -%}
      <li class="sgs-ptrust__item">
        {%- case icon -%}
          {%- when 'truck' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M1.5 5.5h10v8h-10zM11.5 8.5h3.6l2.4 2.6v2.4h-6z"/><circle cx="5" cy="14.5" r="1.6" fill="var(--sgs-bg, #0b0b0b)"/><circle cx="14.5" cy="14.5" r="1.6" fill="var(--sgs-bg, #0b0b0b)"/></svg>
          {%- when 'shield' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M10 2l6.5 2.5v5c0 4-2.8 6.9-6.5 8.5-3.7-1.6-6.5-4.5-6.5-8.5v-5z"/><path d="M7 10l2.2 2.2L13.5 8" stroke-linecap="round"/></svg>
          {%- when 'return' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5a6.5 6.5 0 1 1 1.4 5"/><path d="M3.5 3.5v5h5"/></svg>
          {%- when 'printer' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M5.5 7.5V2.5h9v5M5.5 14.5h-3v-7h15v7h-3"/><path d="M5.5 11.5h9v6h-9z"/></svg>
          {%- when 'package' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M2.5 6L10 2.5 17.5 6v8L10 17.5 2.5 14z"/><path d="M2.5 6L10 9.5 17.5 6M10 9.5v8"/></svg>
          {%- else -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><rect x="4" y="8.5" width="12" height="9" rx="1"/><path d="M6.5 8.5V6a3.5 3.5 0 0 1 7 0v2.5"/></svg>
        {%- endcase -%}
        {%- if link != blank -%}
          <a class="sgs-ptrust__text" href="{{ link | escape }}">{{ text | escape }}</a>
        {%- else -%}
          <span class="sgs-ptrust__text">{{ text | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
{%- if bs.footnote != blank -%}
  <p class="sgs-ptrust__foot">{{ bs.footnote | escape }}</p>
{%- endif -%}
</div>
{%- endunless -%}

{% stylesheet %}
  .sgs-ptrust-wrap {
    width: 100%;
    container-type: inline-size;
  }

  .sgs-ptrust {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-ptrust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--sgs-text-2, #9a968e);
  }

  .sgs-ptrust__icon {
    flex-shrink: 0;
    color: var(--sgs-text, #f2f0eb);
  }

  .sgs-ptrust__text {
    line-height: 1.4;
    color: inherit;
  }

  a.sgs-ptrust__text {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  a.sgs-ptrust__text:hover {
    color: var(--sgs-text, #f2f0eb);
    text-decoration-color: currentColor;
  }

  a.sgs-ptrust__text:focus-visible {
    outline: 1px solid var(--sgs-text, #f2f0eb);
    outline-offset: 2px;
  }

  /* Compact: one short row per reassurance, no box, hairline above */
  .sgs-ptrust-wrap--line .sgs-ptrust {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--sgs-line, rgb(255 255 255 / 0.12));
  }

  .sgs-ptrust-wrap--line .sgs-ptrust__item {
    min-height: 28px;
  }

  /* Grid: 2 x 2 on phones, four across in a wide column */
  .sgs-ptrust-wrap--grid .sgs-ptrust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
    padding-top: 18px;
    border-top: 1px solid var(--sgs-line, rgb(255 255 255 / 0.12));
  }

  @container (min-width: 560px) {
    .sgs-ptrust-wrap--grid .sgs-ptrust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sgs-ptrust__foot {
    margin: 10px 0 0;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sgs-text-2, #9a968e);
  }
{% endstylesheet %}

