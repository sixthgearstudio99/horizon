{%- liquid
  # SixthGear: what the print is, in a short understated list (no ticks or badges)
  assign bs = block.settings
  assign item_count = 0
  for i in (1..5)
    assign key = 'item_' | append: i
    if bs[key] != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- if item_count > 0 and closest.product.gift_card? != true -%}
  <div class="sgs-specs" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-specs__heading">{{ bs.heading | escape }}</h2>
    {%- endif -%}
    {%- if bs.statement != blank -%}
      <p class="sgs-specs__statement">{{ bs.statement | escape }}</p>
    {%- endif -%}
    <ul class="sgs-specs__list" role="list">
      {%- for i in (1..5) -%}
        {%- assign key = 'item_' | append: i -%}
        {%- if bs[key] != blank -%}
          <li class="sgs-specs__item">{{ bs[key] | escape }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .sgs-specs {
    width: 100%;
    font-family: var(--sgs-font-body, Inter, sans-serif);
    color: var(--sgs-text, #111111);
  }

  .sgs-specs .sgs-specs__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 18px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .sgs-specs__statement {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-specs__list {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  /* A small square marker in place of ticks */
  .sgs-specs__item {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.5;
  }

  .sgs-specs__item::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 2px;
    width: 5px;
    height: 5px;
    background: var(--sgs-text, #111111);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Print details list",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium automotive wall art"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Line under the heading",
      "default": "Automotive art prints, designed for enthusiasts."
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
      "default": "Premium semi-gloss paper"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Item 2",
      "default": "Professionally printed in the UK"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Item 3",
      "default": "Carefully packaged for safe delivery"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Item 4"
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Item 5"
    }
  ],
  "presets": [
    {
      "name": "Print details list"
    }
  ]
}
{% endschema %}
