{%- doc -%}
  SixthGear Studios product card.
  Sizes and prices are read from each product's own variants (set by Printify), never hard-coded.

  @param {object} [product] - Product to render. Renders a placeholder card when blank.
  @param {boolean} [show_secondary] - Reveal the second product image (e.g. an on-the-wall mockup) on hover
  @param {boolean} [show_options] - Show the number of sizes / options
  @param {string} [sizes] - Value for the image sizes attribute
  @param {boolean} [eager] - Load the image eagerly (above the fold)
  @param {number} [placeholder_index] - Which placeholder illustration to use when product is blank

  @example
  {% render 'sgs-product-card', product: product, show_secondary: true %}
{%- enddoc -%}
{%- liquid
  # Every card is the same 4:5 portrait, image filling the frame (cover, centred)
  assign card_ratio = '4 / 5'
  assign card_fit = 'cover'
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 80vw'
  if eager
    assign card_loading = 'eager'
  else
    assign card_loading = 'lazy'
  endif

  if product != blank
    assign primary_image = product.featured_media.preview_image

    assign secondary_image = nil
    if show_secondary
      for media in product.media
        if media.position > 1 and media.media_type == 'image'
          assign secondary_image = media.preview_image
          break
        endif
      endfor
    endif

    assign primary_class = 'sgs-card__img sgs-card__img--primary'
    assign secondary_class = 'sgs-card__img sgs-card__img--secondary'

    # Count the sizes (or other options) this product actually offers
    assign option_count = 0
    assign option_label = ''
    unless product.has_only_default_variant
      for option in product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'size' or option_name contains 'dimension' or option_name contains 'format'
          assign option_count = option.values.size
          assign option_label = 'size'
          break
        endif
      endfor
      if option_count == 0
        assign option_count = product.variants.size
        assign option_label = 'option'
      endif
    endunless

    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
    endif
  endif
-%}

<div class="sgs-card{% if secondary_image %} sgs-card--has-secondary{% endif %}">
  {%- if product != blank -%}
    <a class="sgs-card__link" href="{{ product.url }}">
      <span
        class="sgs-card__media sgs-card__media--{{ card_fit }}"
        style="--sgs-card-ratio: {{ card_ratio }};"
      >
        {%- if primary_image != blank -%}
          {%- assign primary_alt = primary_image.alt | default: product.title | escape -%}
          {{
            primary_image
            | image_url: width: 1400
            | image_tag:
              widths: '300, 450, 600, 800, 1000, 1200, 1400',
              sizes: card_sizes,
              loading: card_loading,
              class: primary_class,
              alt: primary_alt
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'sgs-card__img sgs-card__placeholder' }}
        {%- endif -%}

        {%- if secondary_image -%}
          {{
            secondary_image
            | image_url: width: 1400
            | image_tag:
              widths: '300, 450, 600, 800, 1000, 1200, 1400',
              sizes: card_sizes,
              loading: 'lazy',
              class: secondary_class,
              alt: ''
          }}
        {%- endif -%}

        {%- if product.available == false -%}
          <span class="sgs-card__badge sgs-label">{{ 'content.product_badge_sold_out' | t }}</span>
        {%- elsif on_sale -%}
          <span class="sgs-card__badge sgs-card__badge--sale sgs-label">{{ 'content.product_badge_sale' | t }}</span>
        {%- endif -%}
      </span>

      <span class="sgs-card__info">
        <span class="sgs-card__title">{{ product.title | escape }}</span>
        <span class="sgs-card__meta">
          <span class="sgs-card__price">
            {%- if product.price_varies -%}
              {%- assign from_price = product.price_min | money -%}
              {{ 'content.price_from' | t: price: from_price }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
            {%- if on_sale -%}
              <s class="sgs-card__compare">{{ product.compare_at_price | money }}</s>
            {%- endif -%}
          </span>
          {%- if show_options and option_count > 1 -%}
            <span class="sgs-card__options sgs-label">
              {{ option_count }}
              {% if option_label == 'size' %}sizes{% else %}options{% endif %}
            </span>
          {%- endif -%}
        </span>
      </span>
    </a>
  {%- else -%}
    <div class="sgs-card__link" aria-hidden="true">
      <span class="sgs-card__media sgs-card__media--{{ card_fit }}" style="--sgs-card-ratio: {{ card_ratio }};">
        {%- assign placeholder_number = placeholder_index | default: 1 -%}
        {%- assign placeholder_name = 'product-' | append: placeholder_number -%}
        {{ placeholder_name | placeholder_svg_tag: 'sgs-card__img sgs-card__placeholder' }}
      </span>
      <span class="sgs-card__info">
        <span class="sgs-card__title">Your print title</span>
        <span class="sgs-card__meta">
          <span class="sgs-card__price">£00.00</span>
        </span>
      </span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .sgs-card {
    --sgs-card-wall: #ebe8e2;
    --sgs-card-ease: cubic-bezier(0.2, 0.7, 0.2, 1);

    position: relative;
    min-width: 0;
  }

  .sgs-card__link {
    display: flex;
    flex-direction: column;
    gap: 20px;
    color: inherit;
    text-decoration: none;
  }

  .sgs-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--sgs-card-ratio);
    background: var(--sgs-card-wall);
  }

  .sgs-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.7s var(--sgs-card-ease), scale 1.2s var(--sgs-card-ease);
  }

  .sgs-card__img--secondary {
    opacity: 0;
  }

  .sgs-card__placeholder {
    fill: rgb(14 14 14 / 0.18);
  }

  @media (hover: hover) {
    .sgs-card__link:hover .sgs-card__img {
      scale: 1.03;
    }

    .sgs-card--has-secondary .sgs-card__link:hover .sgs-card__img--primary {
      opacity: 0;
    }

    .sgs-card--has-secondary .sgs-card__link:hover .sgs-card__img--secondary {
      opacity: 1;
    }
  }

  .sgs-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 6px 9px 5px;
    background: #f5f3ef;
    color: #0e0e0e;
    font-size: 10px;
    line-height: 1;
  }

  .sgs-card__badge--sale {
    color: #e10600;
  }

  .sgs-card__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sgs-card__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: balance;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    transition: background-size 0.6s var(--sgs-card-ease);
    width: fit-content;
  }

  .sgs-card__link:hover .sgs-card__title {
    background-size: 100% 1px;
  }

  .sgs-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .sgs-card__price {
    display: inline-flex;
    gap: 8px;
    font-size: 14px;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    font-variant-numeric: tabular-nums;
  }

  .sgs-card__compare {
    color: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .sgs-card__options {
    font-size: 10px;
    color: rgb(var(--color-foreground-rgb) / 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-card__img,
    .sgs-card__title {
      transition: none;
    }

    .sgs-card__link:hover .sgs-card__img {
      scale: none;
    }
  }
{% endstylesheet %}
