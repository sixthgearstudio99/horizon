{%- liquid
  assign s = section.settings
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign compact_blocks = section.blocks | where: 'type', 'compact'
-%}

<section
  class="sgs-cols sgs-cols--mobile-{{ s.mobile_layout }}"
  style="
    --sgs-cols-ratio: {{ s.tile_ratio }};
    --sgs-cols-count: {{ feature_blocks.size | at_least: 1 | at_most: 4 }};
    --sgs-cols-pad-top: {{ s['padding-block-start'] }}px;
    --sgs-cols-pad-bottom: {{ s['padding-block-end'] }}px;
  "
  {% if s.heading != blank %}
    aria-labelledby="SgsColsHeading-{{ section.id }}"
  {% endif %}
>
  <div class="sgs-cols__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <header class="sgs-cols__header" data-sgs-reveal>
        <div>
          {%- if s.eyebrow != blank -%}
            <p class="sgs-cols__eyebrow sgs-label">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 id="SgsColsHeading-{{ section.id }}" class="sgs-cols__heading">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if s.view_all_label != blank -%}
          <a class="sgs-link sgs-cols__view-all" href="{{ s.view_all_link | default: routes.collections_url }}">
            {{- s.view_all_label | escape -}}
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14">
              <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if feature_blocks.size > 0 -%}
      <ul class="sgs-cols__features" role="list" data-sgs-reveal-group>
        {%- for block in feature_blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign tile_title = block.settings.title | default: c.title
            assign tile_text = block.settings.text
            if tile_text == blank and c.description != blank
              assign tile_text = c.description | strip_html | truncatewords: 14
            endif
            assign tile_image = block.settings.image | default: c.featured_image
            if tile_image == blank and c.products.first != blank
              assign tile_image = c.products.first.featured_image
            endif
            assign tile_url = c.url | default: routes.collections_url
            assign tile_number = forloop.index | prepend: '0'
          -%}
          <li class="sgs-cols__feature" data-sgs-reveal {{ block.shopify_attributes }}>
            <a class="sgs-tile" href="{{ tile_url }}">
              <span class="sgs-tile__media">
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 1600
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 82vw',
                      loading: 'lazy',
                      class: 'sgs-tile__img',
                      alt: ''
                  }}
                {%- else -%}
                  {%- assign placeholder_name = 'collection-' | append: forloop.index -%}
                  {{ placeholder_name | placeholder_svg_tag: 'sgs-tile__img sgs-tile__placeholder' }}
                {%- endif -%}
              </span>
              <span class="sgs-tile__overlay" aria-hidden="true"></span>
              <span class="sgs-tile__content">
                <span class="sgs-tile__number sgs-label">{{ tile_number }}</span>
                <span class="sgs-tile__title">{{ tile_title | escape }}</span>
                {%- if tile_text != blank -%}
                  <span class="sgs-tile__text">{{ tile_text | escape }}</span>
                {%- endif -%}
                <span class="sgs-tile__cta sgs-label">
                  {{ s.tile_link_label | escape }}
                  <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14">
                    <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if compact_blocks.size > 0 -%}
      <div class="sgs-cols__secondary">
        {%- if s.secondary_label != blank -%}
          <p class="sgs-cols__secondary-label sgs-label" data-sgs-reveal>{{ s.secondary_label | escape }}</p>
        {%- endif -%}
        <ul class="sgs-cols__compact" role="list" data-sgs-reveal-group>
          {%- for block in compact_blocks -%}
            {%- liquid
              assign c = block.settings.collection
              assign row_title = block.settings.title | default: c.title
              assign row_image = block.settings.image | default: c.featured_image
              if row_image == blank and c.products.first != blank
                assign row_image = c.products.first.featured_image
              endif
              assign row_url = c.url | default: routes.collections_url
            -%}
            <li data-sgs-reveal {{ block.shopify_attributes }}>
              <a class="sgs-row" href="{{ row_url }}">
                <span class="sgs-row__thumb">
                  {%- if row_image != blank -%}
                    {{
                      row_image
                      | image_url: width: 320
                      | image_tag:
                        widths: '160, 240, 320',
                        sizes: '96px',
                        loading: 'lazy',
                        class: 'sgs-row__img',
                        alt: ''
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'sgs-row__img sgs-tile__placeholder' }}
                  {%- endif -%}
                </span>
                <span class="sgs-row__body">
                  <span class="sgs-row__title">{{ row_title | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="sgs-row__text">{{ block.settings.text | escape }}</span>
                  {%- elsif c.products_count > 0 -%}
                    <span class="sgs-row__text">{{ c.products_count }} prints</span>
                  {%- endif -%}
                </span>
                <svg class="sgs-row__arrow" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 14 14">
                  <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sgs-cols {
    --sgs-cols-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --sgs-cols-line: rgb(14 14 14 / 0.12);

    padding-block: var(--sgs-cols-pad-top) var(--sgs-cols-pad-bottom);
    color: #0e0e0e;
  }

  .sgs-cols__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sgs-cols__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(40px, 4vw, 64px);
    padding-bottom: 24px;
    border-bottom: 1px solid var(--sgs-cols-line);
  }

  .sgs-cols__eyebrow {
    margin: 0 0 16px;
    color: rgb(14 14 14 / 0.55);
  }

  .sgs-cols__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .sgs-cols__view-all {
    flex-shrink: 0;
    margin-bottom: 4px;
  }

  /* Large style tiles */
  .sgs-cols__features {
    display: grid;
    grid-template-columns: repeat(var(--sgs-cols-count), minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-tile {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--sgs-cols-ratio);
    background: #1a1a1a;
    color: #f5f3ef;
    text-decoration: none;
    isolation: isolate;
  }

  .sgs-tile__media,
  .sgs-tile__overlay {
    position: absolute;
    inset: 0;
  }

  .sgs-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.4s var(--sgs-cols-ease);
  }

  .sgs-tile__placeholder {
    background: #e8e5df;
    fill: rgb(14 14 14 / 0.2);
  }

  .sgs-tile__overlay {
    background: linear-gradient(to top, rgb(10 10 10 / 0.78) 0%, rgb(10 10 10 / 0.25) 42%, transparent 65%);
    transition: opacity 0.8s var(--sgs-cols-ease);
  }

  .sgs-tile__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2vw, 32px);
  }

  .sgs-tile__number {
    color: rgb(245 243 239 / 0.6);
  }

  .sgs-tile__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.75rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .sgs-tile__text {
    max-width: 30ch;
    font-size: 14px;
    line-height: 1.5;
    color: rgb(245 243 239 / 0.78);
    text-wrap: pretty;
  }

  .sgs-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid rgb(245 243 239 / 0.24);
    transition: border-color 0.5s var(--sgs-cols-ease);
  }

  .sgs-tile__cta svg {
    transition: translate 0.5s var(--sgs-cols-ease);
  }

  @media (hover: hover) {
    .sgs-tile:hover .sgs-tile__img {
      scale: 1.04;
    }

    .sgs-tile:hover .sgs-tile__cta {
      border-color: rgb(245 243 239 / 0.7);
    }

    .sgs-tile:hover .sgs-tile__cta svg {
      translate: 4px 0;
    }
  }

  /* Compact origin / type row */
  .sgs-cols__secondary {
    margin-top: clamp(56px, 6vw, 96px);
  }

  .sgs-cols__secondary-label {
    margin: 0 0 20px;
    color: rgb(14 14 14 / 0.55);
  }

  .sgs-cols__compact {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sgs-cols-line);
  }

  .sgs-cols__compact > li + li .sgs-row {
    border-inline-start: 1px solid var(--sgs-cols-line);
  }

  .sgs-row {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 100%;
    padding: 20px 24px;
    border-bottom: 1px solid var(--sgs-cols-line);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.5s var(--sgs-cols-ease);
  }

  .sgs-cols__compact > li:first-child .sgs-row {
    padding-inline-start: 0;
  }

  .sgs-row__thumb {
    position: relative;
    flex: 0 0 auto;
    width: 72px;
    aspect-ratio: 1;
    overflow: hidden;
    background: #e8e5df;
  }

  .sgs-row__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1s var(--sgs-cols-ease);
  }

  .sgs-row__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }

  .sgs-row__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .sgs-row__text {
    font-size: 13px;
    color: rgb(14 14 14 / 0.6);
  }

  .sgs-row__arrow {
    flex-shrink: 0;
    color: rgb(14 14 14 / 0.5);
    transition: translate 0.5s var(--sgs-cols-ease), color 0.5s var(--sgs-cols-ease);
  }

  @media (hover: hover) {
    .sgs-row:hover .sgs-row__img {
      scale: 1.06;
    }

    .sgs-row:hover .sgs-row__arrow {
      translate: 4px 0;
      color: #0e0e0e;
    }
  }

  @media screen and (max-width: 989px) {
    .sgs-cols__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sgs-cols__compact {
      grid-template-columns: minmax(0, 1fr);
    }

    .sgs-cols__compact > li + li .sgs-row {
      border-inline-start: 0;
    }

    .sgs-row {
      padding-inline: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .sgs-cols {
      padding-block: calc(var(--sgs-cols-pad-top) * 0.6) calc(var(--sgs-cols-pad-bottom) * 0.6);
    }

    .sgs-cols__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 32px;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .sgs-cols--mobile-carousel .sgs-cols__features {
      display: flex;
      gap: 12px;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-margin);
      scrollbar-width: none;
    }

    .sgs-cols--mobile-carousel .sgs-cols__features::-webkit-scrollbar {
      display: none;
    }

    .sgs-cols--mobile-carousel .sgs-cols__feature {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    .sgs-cols--mobile-stack .sgs-cols__features {
      grid-template-columns: minmax(0, 1fr);
    }

    .sgs-row__thumb {
      width: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-tile__img,
    .sgs-tile__cta svg,
    .sgs-row__img,
    .sgs-row__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear collections",
  "tag": "div",
  "class": "sgs-cols-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collections"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by style"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "All collections"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Large tiles"
    },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "Tile shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "2 / 3", "label": "Tall 2:3" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "text",
      "id": "tile_link_label",
      "label": "Tile link label",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "carousel", "label": "Swipeable row" },
        { "value": "stack", "label": "Stacked" }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Compact row"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Label",
      "default": "By origin"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 136
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Large tile",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "info": "Defaults to the collection description."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image, then its first product."
        }
      ]
    },
    {
      "type": "compact",
      "name": "Compact link",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line",
          "info": "Defaults to the number of prints."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail",
          "info": "Defaults to the collection image, then its first product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SixthGear collections",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "compact" },
        { "type": "compact" },
        { "type": "compact" }
      ]
    }
  ]
}
{% endschema %}
