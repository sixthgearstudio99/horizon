{%- liquid
  assign s = section.settings

  # On a framed print (tagged framed) the tube line becomes the framed line, and the image
  # is the framed one (or none, so a tube photo never shows)
  capture sgs_framed
    render 'sgs-is-framed', product_resource: product
  endcapture
  assign sgs_framed = sgs_framed | strip
  assign image = s.image
  if sgs_framed == 'true'
    assign image = s.framed_image
  endif

  assign items = ''
  for i in (1..6)
    assign key = 'item_' | append: i
    assign item = s[key] | strip
    if sgs_framed == 'true'
      assign item_lower = item | downcase
      if item_lower contains 'tube' or item_lower contains 'rolled'
        assign item = s.framed_item | strip
      endif
    endif
    if item != blank
      assign items = items | append: item | append: '~~'
    endif
  endfor
  assign items = items | split: '~~'
  assign item_count = items.size
-%}

{%- if item_count > 0 or image != blank or section.blocks.size > 0 -%}
  <section
    class="sgs-arrive{% if image != blank %} sgs-arrive--image{% endif %}"
    style="--sgs-arrive-pad-top: {{ s['padding-block-start'] }}px; --sgs-arrive-pad-bottom: {{ s['padding-block-end'] }}px;"
    {% if s.heading != blank %}aria-labelledby="SgsArrive-{{ section.id }}"{% endif %}
  >
    <div class="sgs-arrive__inner">
      {%- if image != blank -%}
        <div class="sgs-arrive__media">
          {{
            image
            | image_url: width: 1400
            | image_tag:
              widths: '450, 700, 1000, 1400',
              sizes: '(min-width: 990px) 45vw, 100vw',
              loading: 'lazy',
              class: 'sgs-arrive__img',
              alt: image.alt | default: s.heading
          }}
        </div>
      {%- endif -%}
      <div class="sgs-arrive__body">
        {%- if s.label != blank -%}
          <p class="sgs-arrive__label sgs-label">{{ s.label | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sgs-arrive__heading" id="SgsArrive-{{ section.id }}">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if item_count > 0 -%}
          <ul class="sgs-arrive__list" role="list">
            {%- for item in items -%}
              <li class="sgs-arrive__item">
                <svg class="sgs-arrive__tick" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ item | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          {%- comment -%} e.g. the delivery estimate, as the list's last row {%- endcomment -%}
          <div class="sgs-arrive__extra">
            {%- content_for 'blocks' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- if s.mobile_under_buy -%}{% render 'sgs-mobile-move' %}{%- endif -%}
{%- endif -%}

{% stylesheet %}
  .sgs-arrive {
    padding-block: var(--sgs-arrive-pad-top) var(--sgs-arrive-pad-bottom);
    color: var(--sgs-text, #111111);
  }

  @media screen and (max-width: 749px) {
    .sgs-arrive {
      padding-block: calc(var(--sgs-arrive-pad-top) * 0.6) calc(var(--sgs-arrive-pad-bottom) * 0.6);
    }
  }

  .sgs-arrive__inner {
    display: grid;
    gap: 28px;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  @media screen and (min-width: 990px) {
    .sgs-arrive--image .sgs-arrive__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 64px;
    }
  }

  .sgs-arrive__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sgs-raised, #ffffff);
  }

  .sgs-arrive__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sgs-arrive__label {
    margin: 0 0 12px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-arrive .sgs-arrive__heading {
    margin: 0 0 20px;
    font-size: var(--sgs-h2) !important;
    line-height: 1.08 !important;
  }

  .sgs-arrive__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-arrive__item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    border-bottom: 1px solid var(--sgs-line, #e4e0d9);
    font-size: 15px;
  }

  .sgs-arrive__extra {
    padding-block: 14px;
    border-bottom: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-arrive__list + .sgs-arrive__extra,
  .sgs-arrive__extra:first-child {
    border-top: 0;
  }

  .sgs-arrive__extra .sgs-delivery {
    margin: 0;
  }

  .sgs-arrive__tick {
    flex-shrink: 0;
    color: var(--sgs-text-2, #6b6b6b);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How it arrives",
  "tag": "div",
  "class": "sgs-arrive-section",
  "blocks": [{ "type": "sgs-delivery-estimate" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "For example a print in its tube."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "How it arrives"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Packed to arrive perfect"
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Checklist item 1",
      "default": "Printed to order in the UK"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Checklist item 2",
      "default": "Rolled in a protective tube"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Checklist item 3",
      "default": "Dispatched in 2–5 working days"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Checklist item 4",
      "default": "Free UK delivery"
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Checklist item 5"
    },
    {
      "type": "text",
      "id": "item_6",
      "label": "Checklist item 6"
    },
    {
      "type": "header",
      "content": "Framed prints"
    },
    {
      "type": "text",
      "id": "framed_item",
      "label": "Replaces the tube item",
      "default": "Arrives framed in protective packaging, ready to hang. Black wooden frame, clear Perspex front.",
      "info": "On products tagged framed. Leave empty to drop the tube item."
    },
    {
      "type": "image_picker",
      "id": "framed_image",
      "label": "Image on framed prints",
      "info": "Used instead of the image above, so a tube photo never shows on a framed print."
    },
    {
      "type": "checkbox",
      "id": "mobile_under_buy",
      "label": "On phones, show under the buy buttons",
      "default": false,
      "info": "Product pages: appears in the \"Mobile: sections here\" block instead, under 750px wide."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "How it arrives"
    }
  ]
}
{% endschema %}
