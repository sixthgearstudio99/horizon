{%- liquid
  assign bs = block.settings
  assign has_items = false
  for i in (1..6)
    assign q_key = 'question_' | append: i
    assign a_key = 'answer_' | append: i
    if bs[q_key] != blank and bs[a_key] != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- if has_items -%}
  <div class="sgs-faq" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-faq__heading sgs-label">{{ bs.heading | escape }}</h2>
    {%- endif -%}

    {%- for i in (1..6) -%}
      {%- assign q_key = 'question_' | append: i -%}
      {%- assign a_key = 'answer_' | append: i -%}
      {%- if bs[q_key] != blank and bs[a_key] != blank -%}
        <details class="sgs-faq__item">
          <summary class="sgs-faq__summary">
            <span class="sgs-faq__question">{{ bs[q_key] | escape }}</span>
            <span class="sgs-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="sgs-faq__answer">{{ bs[a_key] | escape | newline_to_br }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} FAQPage structured data built from the same questions and answers {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for i in (1..6) -%}
          {%- assign q_key = 'question_' | append: i -%}
          {%- assign a_key = 'answer_' | append: i -%}
          {%- if bs[q_key] != blank and bs[a_key] != blank -%}
            {%- unless first -%},{%- endunless -%}
            {%- assign first = false -%}
            {
              "@type": "Question",
              "name": {{ bs[q_key] | strip | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ bs[a_key] | strip_newlines | strip | json }}
              }
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sgs-faq {
    width: 100%;
  }

  .sgs-faq__heading {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .sgs-faq__item {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .sgs-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  .sgs-faq__summary::-webkit-details-marker {
    display: none;
  }

  .sgs-faq__question {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb));
  }

  .sgs-faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
  }

  .sgs-faq__icon::before,
  .sgs-faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sgs-faq__icon::after {
    transform: rotate(90deg);
  }

  .sgs-faq__item[open] .sgs-faq__icon::after {
    transform: rotate(0deg);
  }

  .sgs-faq__answer {
    padding: 0 28px 20px 0;
    font-size: 15px;
    line-height: 1.65;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-faq__icon::before,
    .sgs-faq__icon::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product FAQ",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "An accordion of common questions, with matching FAQ structured data for search engines. Leave a question empty to hide it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "question_1",
      "label": "Question 1",
      "default": "How long does delivery take?"
    },
    {
      "type": "textarea",
      "id": "answer_1",
      "label": "Answer 1",
      "default": "Every print is made to order in the UK within 2 to 5 working days, then delivered in 2 to 4 working days. UK delivery is free."
    },
    {
      "type": "text",
      "id": "question_2",
      "label": "Question 2",
      "default": "Is it framed?"
    },
    {
      "type": "textarea",
      "id": "answer_2",
      "label": "Answer 2",
      "default": "Prints are supplied unframed and ready to frame in standard sizes (16x24 and 24x36 inches)."
    },
    {
      "type": "text",
      "id": "question_3",
      "label": "Question 3",
      "default": "What paper is it printed on?"
    },
    {
      "type": "textarea",
      "id": "answer_3",
      "label": "Answer 3",
      "default": "Premium semi-gloss paper with rich colour and deep blacks."
    },
    {
      "type": "text",
      "id": "question_4",
      "label": "Question 4",
      "default": "Can I return it?"
    },
    {
      "type": "textarea",
      "id": "answer_4",
      "label": "Answer 4",
      "default": "Yes, you can return standard prints within 14 days of delivery. Faulty or damaged prints are replaced free. Custom posters can't be returned unless faulty."
    },
    {
      "type": "text",
      "id": "question_5",
      "label": "Question 5"
    },
    {
      "type": "textarea",
      "id": "answer_5",
      "label": "Answer 5"
    },
    {
      "type": "text",
      "id": "question_6",
      "label": "Question 6"
    },
    {
      "type": "textarea",
      "id": "answer_6",
      "label": "Answer 6"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ"
    }
  ]
}
{% endschema %}
