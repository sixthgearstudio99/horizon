{%- liquid
  # SixthGear: the Buy 2, Get 1 Free offer on the product page. Display only: the offer itself is
  # an automatic discount in Shopify. Shown on the same terms as the cart's progress bar: while
  # it's switched on (Theme settings > SixthGear: build your wall), not during an offer window that
  # hides it (e.g. a % sale), and not on products that don't count (framed prints, custom posters,
  # gift cards).
  assign bs = block.settings
  assign product_resource = closest.product

  assign show = settings.sgs_wall_progress
  if product_resource == blank or product_resource.gift_card?
    assign show = false
  endif

  if show
    capture sgs_sale_win
      render 'sgs-sale-window'
    endcapture
    assign sgs_sale_win = sgs_sale_win | strip
    if sgs_sale_win != blank
      assign hide_key = 'sgs_sale' | append: sgs_sale_win | append: '_hide_wall'
      if settings[hide_key]
        assign show = false
      endif
    endif
  endif

  assign excluded = false
  if show
    capture sgs_framed
      render 'sgs-is-framed', product_resource: product_resource
    endcapture
    capture sgs_custom
      render 'sgs-is-custom', product_resource: product_resource, handles: settings.sgs_wall_excluded_handles
    endcapture
    if sgs_framed contains 'true' or sgs_custom contains 'true'
      assign excluded = true
    endif
  endif
-%}

{%- if show and excluded == false and bs.heading != blank -%}
  <div class="sgs-b2g1" role="note" {{ block.shopify_attributes }}>
    {%- if bs.eyebrow != blank -%}
      <p class="sgs-b2g1__eyebrow">{{ bs.eyebrow | escape }}</p>
    {%- endif -%}
    <p class="sgs-b2g1__title">{{ bs.heading | escape }}</p>
    {%- if bs.text != blank -%}
      <p class="sgs-b2g1__text">{{ bs.text | escape }}</p>
    {%- endif -%}
    {%- if bs.note != blank -%}
      <p class="sgs-b2g1__note">{{ bs.note | escape }}</p>
    {%- endif -%}
    {%- if bs.link_label != blank -%}
      <a class="sgs-b2g1__link" href="{{ bs.link | default: routes.all_products_collection_url }}">{{ bs.link_label | escape }}</a>
    {%- endif -%}
  </div>
{%- elsif show and excluded and bs.excluded_line != blank -%}
  <p class="sgs-b2g1-excluded" {{ block.shopify_attributes }}>{{ bs.excluded_line | escape }}</p>
{%- endif -%}

{%- liquid
  # Offer windows (Theme settings > SixthGear: offers) with panel text get the same panel, shown
  # only while that window is open on the visitor's clock (html[data-sgs-sale], set in the head),
  # so it switches at the exact minute even on a page served earlier. Not on framed prints or
  # gift cards (these offers are for unframed posters).
  assign offer_panels = false
  if settings.sgs_sale_enabled and product_resource != blank and product_resource.gift_card? != true
    capture sgs_framed_offer
      render 'sgs-is-framed', product_resource: product_resource
    endcapture
    unless sgs_framed_offer contains 'true'
      assign offer_panels = true
    endunless
  endif
-%}
{%- if offer_panels -%}
  {%- for i in (1..4) -%}
    {%- liquid
      assign key = 'sgs_sale' | append: i
      assign p_eyebrow = key | append: '_panel_eyebrow'
      assign p_heading = key | append: '_panel_heading'
      assign p_text = key | append: '_panel_text'
      assign p_note = key | append: '_panel_note'
    -%}
    {%- if settings[p_heading] != blank -%}
      <div class="sgs-b2g1 sgs-b2g1--offer" data-sgs-offer-win="{{ i }}" role="note">
        {%- if settings[p_eyebrow] != blank -%}
          <p class="sgs-b2g1__eyebrow">{{ settings[p_eyebrow] | escape }}</p>
        {%- endif -%}
        <p class="sgs-b2g1__title">{{ settings[p_heading] | escape }}</p>
        {%- if settings[p_text] != blank -%}
          <p class="sgs-b2g1__text">{{ settings[p_text] | escape }}</p>
        {%- endif -%}
        {%- if settings[p_note] != blank -%}
          <p class="sgs-b2g1__note">{{ settings[p_note] | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% stylesheet %}
  /* Near-black panel, cream type, a cream-to-red headline and a thin cream-to-red edge with a
     soft red glow: the brand's own colours (#111111, #f5f3ef, #d7261e) */
  .sgs-b2g1 {
    --sgs-b2g1-ink: #111111;
    --sgs-b2g1-cream: #f5f3ef;
    --sgs-b2g1-red: #d7261e;

    box-sizing: border-box;
    width: 100%;
    padding: 18px 20px 20px;
    border: 1px solid transparent;
    border-radius: var(--sgs-radius, 4px);
    background:
      linear-gradient(var(--sgs-b2g1-ink), var(--sgs-b2g1-ink)) padding-box,
      linear-gradient(100deg, var(--sgs-b2g1-cream) 0%, #e9675e 55%, var(--sgs-b2g1-red) 100%) border-box;
    box-shadow: 0 0 0 1px rgb(215 38 30 / 0.06), 0 6px 28px -6px rgb(215 38 30 / 0.45);
    color: var(--sgs-b2g1-cream);
  }

  /* An offer window's panel: only while that window is open on the visitor's clock */
  .sgs-b2g1--offer {
    display: none;
  }

  html[data-sgs-sale='1'] .sgs-b2g1--offer[data-sgs-offer-win='1'],
  html[data-sgs-sale='2'] .sgs-b2g1--offer[data-sgs-offer-win='2'],
  html[data-sgs-sale='3'] .sgs-b2g1--offer[data-sgs-offer-win='3'],
  html[data-sgs-sale='4'] .sgs-b2g1--offer[data-sgs-offer-win='4'] {
    display: block;
  }

  /* Same switch as the cart's progress bar, on the visitor's clock */
  html[data-sgs-sale-hide-wall] .sgs-b2g1:not(.sgs-b2g1--offer),
  html[data-sgs-sale-hide-wall] .sgs-b2g1-excluded {
    display: none;
  }

  .sgs-b2g1__eyebrow {
    margin: 0 0 6px;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sgs-b2g1-cream);
  }

  .sgs-b2g1__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(24px, 7vw, 32px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-transform: none;
    color: var(--sgs-b2g1-cream);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .sgs-b2g1__title {
      background: linear-gradient(95deg, var(--sgs-b2g1-cream) 0%, #ef8a80 38%, #e8483f 68%, var(--sgs-b2g1-red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  @media (forced-colors: active) {
    .sgs-b2g1__title {
      -webkit-text-fill-color: currentColor;
    }
  }

  .sgs-b2g1__text {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: rgb(245 243 239 / 0.78);
  }

  .sgs-b2g1__note {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: rgb(245 243 239 / 0.6);
  }

  .sgs-b2g1__link {
    display: inline-block;
    margin-top: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--sgs-b2g1-cream);
    text-decoration: underline;
    text-decoration-color: rgb(245 243 239 / 0.4);
    text-underline-offset: 3px;
  }

  .sgs-b2g1__link:hover {
    text-decoration-color: currentColor;
  }

  .sgs-b2g1__link:focus-visible {
    outline: 1px solid var(--sgs-b2g1-cream);
    outline-offset: 2px;
  }

  .sgs-b2g1-excluded {
    width: 100%;
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--sgs-text-2, #6b6b6b);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Buy 2, Get 1 Free",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Display only: the offer itself is an automatic discount in Shopify (Discounts). Shown while Buy 2, Get 1 Free progress is on (Theme settings > SixthGear: build your wall), hidden during offer windows that hide it, and not on framed prints, custom posters or gift cards."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Build your wall",
      "info": "Above the offer, in capitals. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy 2 Prints, Get 1 Free",
      "info": "Leave empty to hide the box."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Mix any designs and sizes. The cheapest is free, taken off automatically at checkout."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Framed prints not included.",
      "info": "Leave empty to hide."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Optional, e.g. Shop more prints. Leave empty to hide."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Defaults to all products."
    },
    {
      "type": "text",
      "id": "excluded_line",
      "label": "Line on products that don't count",
      "info": "Shown instead on framed prints and custom posters, e.g. Not part of Buy 2, Get 1 Free. Leave empty to show nothing."
    }
  ],
  "presets": [
    {
      "name": "Buy 2, Get 1 Free"
    }
  ]
}
{% endschema %}
