      "info": "Leave empty to use the framed text above.",
      "default": "<p>Your design is laid out to fit your chosen frame size (18 × 12, 24 × 16 or 36 × 24 in) and arrives in a black wooden frame with a Perspex front, ready to hang.</p>"
    },
    {
      "type": "textarea",
      "id": "custom_handles",
      "label": "Custom poster products",
      "default": "custom-car-poster-personalized-car-print-with-your-own-car-name-plate-cinematic-garage-wall-art-multiple-sizes, custom-car-poster-personalized-car-print-with-your-own-car",
      "info": "Product handles, separated by commas. Products tagged custom, and the framed or unframed versions of these, count too."
    },
    {
      "type": "checkbox",
      "id": "list_sizes",
      "label": "List the product's sizes under the framing text",
      "default": true
    },
