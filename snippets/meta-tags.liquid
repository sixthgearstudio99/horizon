{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#0B0B0B"
>

{%- liquid
  # SixthGear: Shopify titles the automatic /collections/all page "Products"
  assign sgs_page_title = page_title
  if template.name == 'collection' and collection.handle == 'all' and page_title == 'Products'
    assign sgs_page_title = 'All Prints'
  endif

  # SixthGear: search titles and descriptions from Theme settings > SixthGear: SEO (homepage and
  # up to eight collections, matched by handle) replace Shopify's when filled in. Such a title is
  # used as written, without the shop name added.
  assign sgs_page_description = page_description
  assign sgs_title_as_written = false
  assign sgs_seo_title = ''
  assign sgs_seo_description = ''
  if request.page_type == 'index'
    assign sgs_seo_title = settings.sgs_seo_home_title | strip
    assign sgs_seo_description = settings.sgs_seo_home_description | strip
  elsif request.page_type == 'collection' and collection.handle != blank
    for i in (1..8)
      assign seo_handle_key = 'sgs_seo_c' | append: i | append: '_handle'
      assign seo_handle = settings[seo_handle_key] | strip | downcase
      if seo_handle != blank and seo_handle == collection.handle
        assign seo_title_key = 'sgs_seo_c' | append: i | append: '_title'
        assign seo_description_key = 'sgs_seo_c' | append: i | append: '_description'
        assign sgs_seo_title = settings[seo_title_key] | strip
        assign sgs_seo_description = settings[seo_description_key] | strip
        break
      endif
    endfor
  endif
  if sgs_seo_title != blank
    assign sgs_page_title = sgs_seo_title
    assign sgs_title_as_written = true
  endif
  if sgs_seo_description != blank
    assign sgs_page_description = sgs_seo_description | strip_newlines
  endif

  assign og_title = sgs_page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = sgs_page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ sgs_page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless sgs_page_title contains shop.name or sgs_title_as_written %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if sgs_page_description != blank %}
  <meta
    name="description"
    content="{{ sgs_page_description | escape }}"
  >
{% endif %}
