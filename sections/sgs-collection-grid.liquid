{%- liquid
  assign s = section.settings
  assign order_list = s.order | strip_newlines | split: ','
  assign hidden_key = ',' | append: s.hidden | strip_newlines | remove: ' ' | downcase | append: ','

  # Handles shown so far, so a collection never appears twice
  assign shown = ','
-%}

{%- capture tiles -%}
  {%- comment -%} 1) The collections in the order set below {%- endcomment -%}
  {%- for raw_handle in order_list -%}
    {%- liquid
      assign handle = raw_handle | strip | downcase
      if handle == blank
        continue
      endif
      assign key = ',' | append: handle | append: ','
      if hidden_key contains key or shown contains key
        continue
      endif
      assign c = collections[handle]
      if c == blank or c.products_count == 0
        continue
      endif
      assign shown = shown | append: handle | append: ','
    -%}
    {% render 'sgs-collection-tile', collection: c, index: forloop.index0 %}
  {%- endfor -%}

  {%- comment -%} 2) Any other collection with prints, unless hidden {%- endcomment -%}
  {%- if s.show_others -%}
    {%- for c in collections -%}
      {%- liquid
        assign key = ',' | append: c.handle | append: ','
        if hidden_key contains key or shown contains key or c.products_count == 0
          continue
        endif
        assign shown = shown | append: c.handle | append: ','
      -%}
      {% render 'sgs-collection-tile', collection: c, index: 99 %}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<section
  class="sgs-cgrid"
  style="--sgs-cgrid-pad-top: {{ s['padding-block-start'] }}px; --sgs-cgrid-pad-bottom: {{ s['padding-block-end'] }}px;"
  aria-labelledby="SgsCgrid-{{ section.id }}"
>
  <div class="sgs-cgrid__inner">
    <h1 class="sgs-cgrid__heading" id="SgsCgrid-{{ section.id }}">{{ s.heading | default: 'Collections' | escape }}</h1>
    <ul class="sgs-cgrid__list" role="list">
      {{ tiles }}
    </ul>
  </div>
</section>

{% stylesheet %}
  .sgs-cgrid {
    padding-block: var(--sgs-cgrid-pad-top) var(--sgs-cgrid-pad-bottom);
    color: var(--sgs-text, #111111);
  }

  @media screen and (max-width: 749px) {
    .sgs-cgrid {
      padding-block: calc(var(--sgs-cgrid-pad-top) * 0.6) calc(var(--sgs-cgrid-pad-bottom) * 0.6);
    }
  }

  .sgs-cgrid__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .sgs-cgrid .sgs-cgrid__heading {
    margin: 0 0 24px;
    font-size: var(--sgs-h2) !important;
    font-weight: 700 !important;
    line-height: 1.08 !important;
  }

  @media screen and (min-width: 750px) {
    .sgs-cgrid .sgs-cgrid__heading {
      margin-bottom: 40px;
    }
  }

  /* Every tile the same shape: 2 columns on phones, 3 from tablet up, 12px gaps */
  .sgs-cgrid__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .sgs-cgrid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  .sgs-ctile__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .sgs-ctile__link:focus-visible {
    outline: 2px solid var(--sgs-text, #111111);
    outline-offset: 3px;
    border-radius: var(--sgs-radius, 12px);
  }

  .sgs-ctile__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--sgs-radius, 12px);
    background: var(--sgs-card-bg, #ece9e3);
  }

  .sgs-ctile__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .sgs-ctile__link:hover .sgs-ctile__img {
      transform: scale(1.03);
    }
  }

  .sgs-ctile__title {
    display: block;
    margin-top: 10px;
    font-family: var(--sgs-font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }

  .sgs-ctile__count {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--sgs-text-2, #6b6b6b);
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-ctile__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear collections",
  "tag": "div",
  "class": "sgs-cgrid-section",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "textarea",
      "id": "order",
      "label": "Collection order",
      "default": "gifts-for-car-lovers, mindset, grand-prix, lineage, portraits, german-engineering, jdm, super-hypercars",
      "info": "Collection handles, separated by commas, in the order to show them. Empty collections are skipped."
    },
    {
      "type": "checkbox",
      "id": "show_others",
      "label": "Show other collections after these",
      "default": true,
      "info": "Any other collection with prints, unless it's hidden below."
    },
    {
      "type": "textarea",
      "id": "hidden",
      "label": "Never show",
      "default": "best-sellers, bestsellers, featured, all, frontpage",
      "info": "Collection handles, separated by commas."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "SixthGear collections"
    }
  ]
}
{% endschema %}
