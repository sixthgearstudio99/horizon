{%- comment -%}
  SixthGear: "Pick your garage". Each Garage block holds up to 3 prints shown side by side, the car
  make in small grey text above the model name, and a "Shop this garage" button that adds the three
  (smallest available size of each) to the cart with assets/sgs-bundle.js. From the bundle offer's
  start date (Theme settings > SixthGear: cart spend offer) a line such as "3rd print half price"
  shows under the title, switched on in the visitor's browser (snippets/sgs-date-gate-head.liquid).
  Garages with no prints picked aren't shown.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign makes = s.makes | default: settings.sgs_makes | split: ','
  assign garage_count = 0
  for block in section.blocks
    if block.settings.products.size > 0
      assign garage_count = garage_count | plus: 1
    endif
  endfor
-%}

{%- if garage_count > 0 or request.design_mode -%}
  <section
    class="sgs-garages"
    style="--sgs-garages-pad-top: {{ s['padding-block-start'] }}px; --sgs-garages-pad-bottom: {{ s['padding-block-end'] }}px;"
    aria-labelledby="SgsGarages-{{ section.id }}"
  >
    <div class="sgs-garages__inner">
      <header class="sgs-garages__header" data-sgs-reveal>
        {%- if s.eyebrow != blank -%}
          <p class="sgs-garages__eyebrow sgs-label">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="sgs-garages__heading" id="SgsGarages-{{ section.id }}">{{ s.heading | escape }}</h2>
        {%- if s.offer_line != blank and settings.sgs_bundle_start != blank -%}
          <p class="sgs-garages__offer" data-sgs-show-from="{{ settings.sgs_bundle_start | strip | escape }}" hidden>{{ s.offer_line | escape }}</p>
        {%- endif -%}
      </header>

      <div class="sgs-garages__list">
        {%- for block in section.blocks -%}
          {%- assign picks = block.settings.products -%}
          {%- if picks.size == 0 -%}
            {%- if request.design_mode -%}
              <div class="sgs-garage sgs-garage--empty" {{ block.shopify_attributes }}>
                <p class="sgs-garage__title">{{ block.settings.title | default: 'Garage' | escape }}</p>
                <p class="sgs-garage__note">Pick up to 3 prints for this garage.</p>
              </div>
            {%- endif -%}
            {%- continue -%}
          {%- endif -%}
          <sgs-bundle class="sgs-garage" data-money-format="{{ shop.money_format | strip_html | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <p class="sgs-garage__title sgs-label">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            <ul class="sgs-garage__prints" role="list">
              {%- for p in picks limit: 3 -%}
                {%- liquid
                  # Make: the product's custom.make metafield, else the first make in the list found in
                  # its tags or title (e.g. "Ferrari" for the F40). Model: the title before its first comma.
                  assign make = p.metafields.custom.make.value | default: p.metafields.custom.make | strip
                  if make == blank
                    assign tags_key = p.tags | join: '|' | downcase | prepend: '|' | append: '|'
                    assign title_key = p.title | downcase | prepend: ' ' | append: ' '
                    for raw_make in makes
                      assign m = raw_make | strip
                      assign m_key = m | downcase
                      if m == blank
                        continue
                      endif
                      assign tag_needle = '|' | append: m_key | append: '|'
                      assign title_needle = ' ' | append: m_key | append: ' '
                      if tags_key contains tag_needle or title_key contains title_needle
                        assign make = m
                        break
                      endif
                    endfor
                  endif
                  assign model = p.title | split: ',' | first | remove: ' Framed Poster' | remove: ' Poster' | remove: ' Wall Art' | strip
                  assign v = p.selected_or_first_available_variant
                  assign img = p.featured_media.preview_image | default: p.featured_image
                -%}
                <li class="sgs-garage__print">
                  <a class="sgs-garage__media" href="{{ p.url }}">
                    {%- if img != blank -%}
                      {%- assign img_class = 'sgs-garage__img' -%}
                      {%- if img.aspect_ratio > 0.81 -%}{%- assign img_class = 'sgs-garage__img sgs-garage__img--contain' -%}{%- endif -%}
                      {{
                        img
                        | image_url: width: 700
                        | image_tag:
                          widths: '200, 300, 450, 700',
                          sizes: '(min-width: 990px) 13vw, 30vw',
                          loading: 'lazy',
                          class: img_class,
                          alt: p.title
                      }}
                    {%- endif -%}
                  </a>
                  {%- if make != blank -%}
                    <span class="sgs-garage__make">{{ make | escape }}</span>
                  {%- endif -%}
                  <a class="sgs-garage__model" href="{{ p.url }}">{{ model | escape }}</a>
                  {%- if v != blank -%}
                    <input type="hidden" data-variant value="{{ v.id }}" data-price="{{ v.price }}">
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            <div class="sgs-garage__footer">
              <button type="button" class="button sgs-garage__button" data-add>
                <span data-label>{{ s.button_label | default: 'Shop this garage' | escape }}</span>
              </button>
              {%- if s.button_note != blank -%}
                <p class="sgs-garage__note">{{ s.button_note | escape }}</p>
              {%- endif -%}
              <p class="sgs-garage__status" role="status" aria-live="polite" data-status></p>
            </div>
          </sgs-bundle>
        {%- endfor -%}
      </div>
    </div>
  </section>
  <script src="{{ 'sgs-bundle.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .sgs-garages {
    padding-block: var(--sgs-garages-pad-top) var(--sgs-garages-pad-bottom);
    color: var(--sgs-text, #111111);
  }

  @media screen and (max-width: 749px) {
    .sgs-garages {
      padding-block: calc(var(--sgs-garages-pad-top) * 0.6) calc(var(--sgs-garages-pad-bottom) * 0.6);
    }
  }

  .sgs-garages__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .sgs-garages__header {
    margin-bottom: 32px;
  }

  .sgs-garages__eyebrow {
    margin: 0 0 12px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-garages .sgs-garages__heading {
    margin: 0;
    font-size: var(--sgs-h2) !important;
    line-height: 1.08 !important;
  }

  .sgs-garages__offer {
    margin: 12px 0 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--sgs-text, #111111);
  }

  .sgs-garages__offer[hidden] {
    display: none;
  }

  .sgs-garages__list {
    display: grid;
    gap: 40px;
  }

  @media screen and (min-width: 990px) {
    .sgs-garages__list {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 32px;
    }
  }

  .sgs-garage {
    display: block;
    min-width: 0;
  }

  .sgs-garage__title {
    margin: 0 0 14px;
  }

  .sgs-garage__prints {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-garage__print {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .sgs-garage__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--sgs-radius, 4px);
    background: var(--sgs-card-bg, #ece9e3);
  }

  .sgs-garage__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sgs-garage__img--contain {
    object-fit: contain;
    background: #f5f3ef;
  }

  .sgs-garage__make {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.3;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-garage__model {
    margin-top: 2px;
    overflow: hidden;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: inherit;
    text-decoration: none;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .sgs-garage__footer {
    margin-top: 16px;
  }

  .sgs-garage__button {
    width: 100%;
  }

  .sgs-garage__button[aria-busy='true'] {
    opacity: 0.6;
  }

  .sgs-garage__note {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-garage__status {
    margin: 6px 0 0;
    font-size: 13px;
  }

  .sgs-garage__status:empty {
    display: none;
  }

  .sgs-garage--empty {
    padding: 24px;
    border: 1px dashed var(--sgs-line, #e4e0d9);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear garages",
  "tag": "section",
  "class": "sgs-garages-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your garage"
    },
    {
      "type": "text",
      "id": "offer_line",
      "label": "Offer line under the heading",
      "default": "3rd print half price",
      "info": "Shown from Theme settings > SixthGear: cart spend offer > Bundle offer starts, on each visitor's own UK clock. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop this garage"
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Line under the button",
      "default": "Adds all three to your cart in their smallest size.",
      "info": "Leave empty to hide."
    },
    {
      "type": "textarea",
      "id": "makes",
      "label": "Car makes",
      "info": "Separated by commas. The make above each print is the first of these found in its tags or title (a product's custom.make metafield wins). Empty uses the list in Theme settings."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "garage",
      "name": "Garage",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Garage"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Prints",
          "limit": 3
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SixthGear garages",
      "blocks": [
        { "type": "garage", "settings": { "title": "Garage 1" } },
        { "type": "garage", "settings": { "title": "Garage 2" } },
        { "type": "garage", "settings": { "title": "Garage 3" } }
      ]
    }
  ]
}
{% endschema %}
