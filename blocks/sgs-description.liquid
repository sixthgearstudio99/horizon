{%- liquid
  assign bs = block.settings
  assign product_resource = closest.product
  assign uid = 'SgsDesc-' | append: block.id
  capture description
    render 'sgs-description-html', product_resource: product_resource
  endcapture
  assign description = description | strip

  # Long descriptions start collapsed to about five lines. Decided here from the text length,
  # so the toggle is there from the first paint and nothing shifts.
  assign plain_length = description | strip_html | strip | size
  assign collapsible = false
  if plain_length > bs.collapse_after
    assign collapsible = true
  endif
-%}

{%- if description != blank -%}
  <div class="sgs-desc{% if collapsible %} sgs-desc--collapsible{% endif %}" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-desc__heading sgs-label">{{ bs.heading | escape }}</h2>
    {%- endif -%}
    {%- if bs.spec_line != blank -%}
      <p class="sgs-desc__spec">
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M4.5 2.5h8l3 3v12h-11z"/><path d="M12.5 2.5v3h3M7 9.5h6M7 12.5h6M7 15.5h4" stroke-linecap="round"/></svg>
        <span>{{ bs.spec_line | escape }}</span>
      </p>
    {%- endif -%}
    <div class="sgs-desc__body rte" id="{{ uid }}">{{ description }}</div>
    {%- if collapsible -%}
      <button
        type="button"
        class="sgs-desc__toggle"
        aria-expanded="false"
        aria-controls="{{ uid }}"
        data-more="{{ bs.more_label | escape }}"
        data-less="{{ bs.less_label | escape }}"
        onclick="var o=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',String(!o));this.textContent=o?this.dataset.more:this.dataset.less;"
      >
        {{- bs.more_label | escape -}}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .sgs-desc {
    width: 100%;
  }

  /* One line about the print itself (paper and inks), above the description */
  .sgs-desc__spec {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--sgs-text, #111111);
  }

  .sgs-desc__spec svg {
    flex-shrink: 0;
  }

  .sgs-desc__heading {
    margin: 0 0 14px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-desc__body {
    max-width: 65ch;
    font-family: var(--sgs-font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--sgs-text, #111111);
  }

  .sgs-desc__body > :first-child {
    margin-top: 0;
  }

  .sgs-desc__body > :last-child {
    margin-bottom: 0;
  }

  .sgs-desc__body :is(p, ul, ol) {
    margin: 0 0 1em;
  }

  .sgs-desc__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Five lines of 16px / 1.6 */
  .sgs-desc--collapsible .sgs-desc__body {
    max-height: 8em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .sgs-desc--collapsible:has(.sgs-desc__toggle[aria-expanded='true']) .sgs-desc__body {
    max-height: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .sgs-desc__toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sgs-text, #111111);
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: none;
    text-decoration: underline;
    text-decoration-color: rgb(17 17 17 / 0.3);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .sgs-desc__toggle:focus-visible {
    outline: 1px solid var(--sgs-text, #111111);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product description",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Label",
      "default": "About this print"
    },
    {
      "type": "text",
      "id": "spec_line",
      "label": "Line about the print",
      "info": "Shown above the description, e.g. the paper and inks. Leave empty to hide."
    },
    {
      "type": "range",
      "id": "collapse_after",
      "label": "Collapse descriptions longer than",
      "min": 100,
      "max": 1000,
      "step": 50,
      "unit": "chr",
      "default": 350,
      "info": "Longer descriptions show about five lines with a Read more link."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Read less label",
      "default": "Read less"
    }
  ],
  "presets": [
    {
      "name": "Product description"
    }
  ]
}
{% endschema %}
