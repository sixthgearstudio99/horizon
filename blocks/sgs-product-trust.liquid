{%- liquid
  assign bs = block.settings
  # The frame note is for unframed prints: hidden when the chosen variant is framed
  assign variant_title = closest.product.selected_or_first_available_variant.title | downcase
  assign is_framed = false
  if variant_title contains 'frame'
    assign is_framed = true
    if variant_title contains 'unframe'
      assign is_framed = false
    endif
  endif
  capture sgs_framed
    render 'sgs-is-framed', product_resource: closest.product
  endcapture
  assign sgs_framed = sgs_framed | strip

  # "Choose Framed above": only when this print has a framed version, so the Finish toggle is there
  assign has_framed_version = false
  if closest.product.metafields.custom.framed_version.value != blank
    assign has_framed_version = true
  endif
-%}

{%- unless closest.product.gift_card? -%}
<div class="sgs-ptrust-wrap sgs-ptrust-wrap--{{ bs.layout | default: 'line' }}" {{ block.shopify_attributes }}>
<ul class="sgs-ptrust" role="list">
  {%- for i in (1..4) -%}
    {%- liquid
      assign text_key = 'item_' | append: i | append: '_text'
      assign link_key = 'item_' | append: i | append: '_link'
      assign icon_key = 'item_' | append: i | append: '_icon'
      assign text = bs[text_key]
      assign link = bs[link_key] | strip
      assign icon = bs[icon_key] | default: 'truck'
    -%}
    {%- if text != blank -%}
      <li class="sgs-ptrust__item">
        {%- case icon -%}
          {%- when 'truck' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M1.5 5.5h10v8h-10zM11.5 8.5h3.6l2.4 2.6v2.4h-6z"/><circle cx="5" cy="14.5" r="1.6" fill="var(--sgs-bg, #f5f3ef)"/><circle cx="14.5" cy="14.5" r="1.6" fill="var(--sgs-bg, #f5f3ef)"/></svg>
          {%- when 'shield' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M10 2l6.5 2.5v5c0 4-2.8 6.9-6.5 8.5-3.7-1.6-6.5-4.5-6.5-8.5v-5z"/><path d="M7 10l2.2 2.2L13.5 8" stroke-linecap="round"/></svg>
          {%- when 'return' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5a6.5 6.5 0 1 1 1.4 5"/><path d="M3.5 3.5v5h5"/></svg>
          {%- when 'printer' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M5.5 7.5V2.5h9v5M5.5 14.5h-3v-7h15v7h-3"/><path d="M5.5 11.5h9v6h-9z"/></svg>
          {%- when 'package' -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M2.5 6L10 2.5 17.5 6v8L10 17.5 2.5 14z"/><path d="M2.5 6L10 9.5 17.5 6M10 9.5v8"/></svg>
          {%- else -%}
            <svg class="sgs-ptrust__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><rect x="4" y="8.5" width="12" height="9" rx="1"/><path d="M6.5 8.5V6a3.5 3.5 0 0 1 7 0v2.5"/></svg>
        {%- endcase -%}
        {%- if link != blank -%}
          <a class="sgs-ptrust__text" href="{{ link | escape }}">{{ text | escape }}</a>
        {%- else -%}
          <span class="sgs-ptrust__text">{{ text | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
{%- if bs.footnote != blank and sgs_framed != 'true' -%}
  <p class="sgs-ptrust__foot" data-sgs-frame-note{% if is_framed %} hidden{% endif %}>{{ bs.footnote | escape }}</p>
  {%- if bs.framed_cta != blank and has_framed_version -%}
    <p class="sgs-ptrust__cta" data-sgs-frame-note{% if is_framed %} hidden{% endif %}>
      <a href="#sgs-finish" data-sgs-to-finish>{{ bs.framed_cta | escape }}</a>
    </p>
  {%- endif -%}
  <script>
    (function () {
      // Follows the chosen options: hidden for a framed choice (e.g. "Black frame"), shown otherwise
      var note = document.currentScript.previousElementSibling;
      var root = note && (note.closest('.shopify-section') || document);
      if (!root || root.dataset.sgsFrameNote) return;
      root.dataset.sgsFrameNote = '1';
      // "Choose Framed above": scroll to the Finish toggle and put focus on the Framed button
      root.addEventListener('click', function (e) {
        var link = e.target instanceof Element ? e.target.closest('[data-sgs-to-finish]') : null;
        var finish = link && document.getElementById('sgs-finish');
        if (!finish) return;
        e.preventDefault();
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        finish.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        var framed = finish.querySelector('[data-sgs-finish-link]');
        if (framed) setTimeout(function () { framed.focus({ preventScroll: true }); }, reduce ? 0 : 450);
      });
      root.addEventListener('change', function (e) {
        if (!(e.target instanceof HTMLInputElement || e.target instanceof HTMLSelectElement)) return;
        if (!e.target.closest('variant-picker, .variant-picker')) return;
        var picked = Array.prototype.map.call(
          root.querySelectorAll('variant-picker input:checked, variant-picker select'),
          function (el) { return (el.value || '').toLowerCase(); }
        ).join(' ');
        var framed = /frame/.test(picked) && !/unframe/.test(picked);
        root.querySelectorAll('[data-sgs-frame-note]').forEach(function (n) { n.hidden = framed; });
      });
    })();
  </script>
{%- endif -%}
</div>
{%- endunless -%}

{% stylesheet %}
  .sgs-ptrust-wrap {
    width: 100%;
    container-type: inline-size;
  }

  .sgs-ptrust {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-ptrust__item {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--sgs-text, #111111);
  }

  .sgs-ptrust__icon {
    flex-shrink: 0;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-ptrust__text {
    line-height: 1.4;
    color: inherit;
  }

  a.sgs-ptrust__text {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: rgb(17 17 17 / 0.3);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  a.sgs-ptrust__text:hover {
    text-decoration-color: currentColor;
  }

  a.sgs-ptrust__text:focus-visible {
    outline: 1px solid var(--sgs-text, #111111);
    outline-offset: 2px;
  }

  /* Compact: one short row per reassurance, no box, hairline above */
  .sgs-ptrust-wrap--line .sgs-ptrust {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-ptrust-wrap--line .sgs-ptrust__item {
    min-height: 28px;
  }

  /* Grid: 2 x 2 on phones, four across in a wide column */
  .sgs-ptrust-wrap--grid .sgs-ptrust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 16px;
    padding-top: 18px;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
  }

  @container (min-width: 560px) {
    .sgs-ptrust-wrap--grid .sgs-ptrust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Columns: one row of short reassurances, icon above text */
  .sgs-ptrust-wrap--columns .sgs-ptrust {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 8px;
  }

  .sgs-ptrust-wrap--columns .sgs-ptrust__item {
    flex-direction: column;
    justify-content: flex-start;
    gap: 8px;
    padding: 12px 4px;
    text-align: center;
  }

  .sgs-ptrust-wrap--columns .sgs-ptrust__text {
    line-height: 1.35;
  }

  .sgs-ptrust-wrap--columns .sgs-ptrust__foot {
    text-align: center;
  }

  .sgs-ptrust__foot[hidden],
  .sgs-ptrust__cta[hidden] {
    display: none;
  }

  /* "Want it ready to hang? Choose Framed above." under the frame note */
  .sgs-ptrust__cta {
    margin: 2px 0 0;
    font-size: 13px;
    line-height: 1.5;
  }

  .sgs-ptrust-wrap--columns .sgs-ptrust__cta {
    text-align: center;
  }

  .sgs-ptrust__cta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -12px;
    color: var(--sgs-text, #111111);
    text-decoration: underline;
    text-decoration-color: rgb(17 17 17 / 0.3);
    text-underline-offset: 3px;
  }

  .sgs-ptrust__cta a:hover {
    text-decoration-color: currentColor;
  }

  .sgs-ptrust__foot {
    margin: 10px 0 0;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--sgs-text, #111111);
  }
{% endstylesheet %}

