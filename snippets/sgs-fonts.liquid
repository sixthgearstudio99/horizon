{%- doc -%}
  SixthGear Studios gallery look: self-hosted fonts (SIL Open Font License 1.1).
  Inter Tight 600/700 for headings; Inter 400/500/600 for body, labels, buttons and prices.
  The two above-the-fold faces are preloaded, and each family has a metric-matched local
  fallback (size-adjust / ascent / descent overrides) so swapping in the web font doesn't shift
  the layout. The older --sgs-font-mono token now points at Inter, so every label follows.

  @example
  {% render 'sgs-fonts' %}
{%- enddoc -%}

{{ 'sgs-inter-tight-600.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'sgs-inter-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

<style>
  @font-face {
    font-family: 'SGS Inter Tight';
    src: url('{{ 'sgs-inter-tight-600.woff2' | asset_url }}') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SGS Inter Tight';
    src: url('{{ 'sgs-inter-tight-700.woff2' | asset_url }}') format('woff2');
    font-weight: 700 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SGS Inter';
    src: url('{{ 'sgs-inter-400.woff2' | asset_url }}') format('woff2');
    font-weight: 100 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SGS Inter';
    src: url('{{ 'sgs-inter-500.woff2' | asset_url }}') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'SGS Inter';
    src: url('{{ 'sgs-inter-600.woff2' | asset_url }}') format('woff2');
    font-weight: 600 900;
    font-style: normal;
    font-display: swap;
  }

  /* Metric-matched fallbacks (measured from the font files against Arial / Arial Bold) */
  @font-face {
    font-family: 'SGS Inter Tight Fallback';
    src: local('Arial Bold'), local('Arial-BoldMT'), local('Liberation Sans Bold'), local('Arial');
    size-adjust: 94.68%;
    ascent-override: 102.32%;
    descent-override: 25.48%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'SGS Inter Fallback';
    src: local('Arial'), local('Helvetica'), local('Liberation Sans');
    size-adjust: 105.79%;
    ascent-override: 91.57%;
    descent-override: 22.8%;
    line-gap-override: 0%;
  }

  :root {
    --sgs-font-display: 'SGS Inter Tight', 'SGS Inter Tight Fallback', sans-serif;
    --sgs-font-body: 'SGS Inter', 'SGS Inter Fallback', sans-serif;
    --sgs-font-mono: var(--sgs-font-body);

    /* Point Horizon's font variables at the self-hosted families */
    --font-body--family: var(--sgs-font-body);
    --font-body--weight: 400;
    --font-subheading--family: var(--sgs-font-body);
    --font-subheading--weight: 500;
    --font-heading--family: var(--sgs-font-display);
    --font-heading--weight: 600;
    --font-accent--family: var(--sgs-font-body);
    --font-accent--weight: 500;
  }
</style>
