{%- liquid
  assign s = section.settings

  # Steps for this print: its own metafields first (custom.lineage_models with optional
  # custom.lineage_years, custom.lineage_notes and custom.lineage_images, all lists in the same
  # order), else the steps added below, for prints picked here or whose title contains
  # "Use the steps below for titles containing".
  assign mf_models = product.metafields.custom.lineage_models.value
  assign mf_years = product.metafields.custom.lineage_years.value
  assign mf_notes = product.metafields.custom.lineage_notes.value
  assign mf_images = product.metafields.custom.lineage_images.value
  assign use_metafields = false
  if mf_models != blank and mf_models.size > 0
    assign use_metafields = true
  endif

  assign picked = false
  assign in_collection = false
  assign blocks_apply = false
  if product != blank
    for p in s.products
      if p.id == product.id
        assign picked = true
        break
      endif
    endfor
    if s.collection_handle != blank
      for c in product.collections
        if c.handle == s.collection_handle
          assign in_collection = true
          break
        endif
      endfor
    endif
    if picked
      assign blocks_apply = true
    elsif s.blocks_match != blank and product.title contains s.blocks_match
      assign blocks_apply = true
    endif
  endif

  assign has_steps = use_metafields
  if blocks_apply and section.blocks.size > 0
    assign has_steps = true
  endif

  assign show = false
  if picked or in_collection
    if has_steps
      assign show = true
    endif
  endif
-%}

{%- if show -%}
  <section
    class="sgs-tl"
    style="--sgs-tl-pad-top: {{ s['padding-block-start'] }}px; --sgs-tl-pad-bottom: {{ s['padding-block-end'] }}px;"
    aria-labelledby="SgsTl-{{ section.id }}"
  >
    <div class="sgs-tl__inner">
      <header class="sgs-tl__header" data-sgs-reveal>
        <div>
          {%- if s.eyebrow != blank -%}
            <p class="sgs-tl__eyebrow sgs-label">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="sgs-tl__heading" id="SgsTl-{{ section.id }}">{{ s.heading }}</h2>
        </div>
        <div class="sgs-tl__nav" data-tl-nav hidden>
          <button type="button" class="sgs-tl__arrow" data-tl-prev aria-label="Previous">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 14 14"><path d="M13 7H1M5.5 2.5L1 7l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="sgs-tl__arrow" data-tl-next aria-label="Next">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 14 14"><path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </header>

      <sgs-timeline class="sgs-tl__track-wrap">
        <ol class="sgs-tl__track" data-tl-track data-sgs-reveal-group>
          {%- if use_metafields -%}
            {%- for model in mf_models -%}
              {%- liquid
                assign i = forloop.index0
                assign step_years = mf_years[i]
                assign step_text = mf_notes[i]
                assign step_image = mf_images[i]
              -%}
              <li class="sgs-tl__step{% if step_image != blank %} sgs-tl__step--image{% endif %}" data-sgs-reveal>
                <div class="sgs-tl__media">
                  {%- if step_image != blank -%}
                    {{
                      step_image
                      | image_url: width: 900
                      | image_tag:
                        widths: '300, 450, 600, 900',
                        sizes: '(min-width: 990px) 22vw, 70vw',
                        loading: 'lazy',
                        class: 'sgs-tl__img',
                        alt: model
                    }}
                  {%- endif -%}
                </div>
                <span class="sgs-tl__dot" aria-hidden="true"></span>
                {%- if step_years != blank -%}
                  <p class="sgs-tl__years">{{ step_years | escape }}</p>
                {%- endif -%}
                <h3 class="sgs-tl__model">{{ model | escape }}</h3>
                {%- if step_text != blank -%}
                  <p class="sgs-tl__text">{{ step_text | escape }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <li class="sgs-tl__step{% if b.image != blank %} sgs-tl__step--image{% endif %}" data-sgs-reveal {{ block.shopify_attributes }}>
                <div class="sgs-tl__media">
                  {%- if b.image != blank -%}
                    {%- assign step_alt = b.image.alt | default: b.model | escape -%}
                    {{
                      b.image
                      | image_url: width: 900
                      | image_tag:
                        widths: '300, 450, 600, 900',
                        sizes: '(min-width: 990px) 22vw, 70vw',
                        loading: 'lazy',
                        class: 'sgs-tl__img',
                        alt: step_alt
                    }}
                  {%- endif -%}
                </div>
                <span class="sgs-tl__dot" aria-hidden="true"></span>
                <p class="sgs-tl__years">{{ b.years | escape }}</p>
                <h3 class="sgs-tl__model">{{ b.model | escape }}</h3>
                {%- if b.text != blank -%}
                  <p class="sgs-tl__text">{{ b.text }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ol>
      </sgs-timeline>
    </div>
  </section>
  <script src="{{ 'sgs-timeline.js' | asset_url }}" defer></script>
{%- elsif request.design_mode and in_collection -%}
  <div class="sgs-tl-note">
    Lineage timeline: hidden on this print until its generations are added. Fill the product
    metafields custom.lineage_models (list of text, e.g. "F1", "P1", "Senna"), and optionally
    custom.lineage_years, custom.lineage_notes (lists of text) and custom.lineage_images (list of images), in the same order.
  </div>
{%- else -%}
  <span class="sgs-tl-hidden" hidden></span>
{%- endif -%}

{% stylesheet %}
  .sgs-tl-note {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: 16px var(--page-margin, 16px);
    font-size: 13px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  /* No timeline for this print: no empty band or extra divider */
  .shopify-section:has(> .sgs-tl-hidden) {
    display: none;
  }

  .sgs-tl {
    padding-block: var(--sgs-tl-pad-top) var(--sgs-tl-pad-bottom);
    color: var(--sgs-text);
    overflow: hidden;
  }

  .sgs-tl__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sgs-tl__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(40px, 4vw, 64px);
  }

  .sgs-tl__eyebrow {
    margin: 0 0 16px;
    color: rgb(17 17 17 / 0.62);
  }

  .sgs-tl__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: none;
    text-wrap: balance;
  }

  .sgs-tl__nav {
    display: flex;
    gap: 8px;
  }

  .sgs-tl__nav[hidden] {
    display: none;
  }

  .sgs-tl__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--sgs-line);
    border-radius: 50%;
    background: transparent;
    color: var(--sgs-text);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, opacity 0.3s ease;
  }

  .sgs-tl__arrow:hover:not(:disabled) {
    background: var(--sgs-text);
    color: var(--sgs-bg);
  }

  .sgs-tl__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .sgs-tl__track-wrap {
    display: block;
  }

  .sgs-tl__track {
    --sgs-tl-step: clamp(240px, 24vw, 340px);

    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--sgs-tl-step);
    gap: clamp(24px, 3vw, 48px);
    margin: 0 calc(var(--page-margin) * -1);
    padding: 0 var(--page-margin) 8px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin);
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .sgs-tl__track::-webkit-scrollbar {
    display: none;
  }

  .sgs-tl__step {
    position: relative;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
  }

  .sgs-tl__media {
    aspect-ratio: 4 / 3;
    margin-bottom: 28px;
    overflow: hidden;
    background: #e8e5df;
  }

  .sgs-tl__step:not(.sgs-tl__step--image) .sgs-tl__media {
    background: repeating-linear-gradient(135deg, var(--sgs-raised) 0 12px, #1c1c1c 12px 13px);
  }

  .sgs-tl__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sgs-tl__step:hover .sgs-tl__img {
    scale: 1.03;
  }

  /* The line runs through every dot; each step draws its own segment */
  .sgs-tl__dot {
    position: relative;
    display: block;
    width: 11px;
    height: 11px;
    margin-bottom: 22px;
    border: 1px solid var(--sgs-text);
    border-radius: 50%;
    background: var(--sgs-bg);
    z-index: 1;
  }

  .sgs-tl__step::before {
    content: '';
    position: absolute;
    left: 0;
    right: calc(-1 * clamp(24px, 3vw, 48px));
    top: calc(var(--sgs-tl-step) * 0.75 + 28px + 5px);
    height: 1px;
    background: rgb(17 17 17 / 0.08);
    transform-origin: left;
  }

  .sgs-tl__step:last-child::before {
    right: 0;
  }

  .sgs-tl__step:first-child .sgs-tl__dot {
    background: var(--sgs-text);
    border-color: var(--sgs-text);
  }

  .sgs-tl__years {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .sgs-tl__model {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .sgs-tl__text {
    margin: 14px 0 0;
    max-width: 32ch;
    font-size: 14px;
    line-height: 1.6;
    color: rgb(17 17 17 / 0.62);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sgs-motion .sgs-tl__step[data-sgs-reveal]::before {
      transform: scaleX(0);
      transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--sgs-reveal-index, 0) * 80ms + 150ms);
    }

    .sgs-motion .sgs-tl__step[data-sgs-reveal].is-revealed::before {
      transform: scaleX(1);
    }
  }

  @media screen and (max-width: 749px) {
    .sgs-tl {
      padding-block: calc(var(--sgs-tl-pad-top) * 0.6) calc(var(--sgs-tl-pad-bottom) * 0.6);
    }

    .sgs-tl__track {
      --sgs-tl-step: 72vw;
    }

    .sgs-tl__header {
      margin-bottom: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-tl__track {
      scroll-behavior: auto;
    }

    .sgs-tl__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear timeline",
  "tag": "div",
  "class": "sgs-tl-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add one timeline per car. It only appears on the products picked below, or, if none are picked, on every print in the collection below."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Show on these prints",
      "limit": 20
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Otherwise show on collection",
      "default": "lineage",
      "info": "Shows on every print in this collection that has generations in its metafields: custom.lineage_models, plus optional custom.lineage_years, custom.lineage_notes and custom.lineage_images (lists, same order)."
    },
    {
      "type": "text",
      "id": "blocks_match",
      "label": "Use the steps below for titles containing",
      "default": "911",
      "info": "Prints without lineage metafields use the steps below only if picked above or their title contains this text."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The lineage"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Every generation"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "model",
          "label": "Model name",
          "default": "911 (964)"
        },
        {
          "type": "text",
          "id": "years",
          "label": "Years",
          "default": "1989–1994"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Short line",
          "default": "Coil springs, all-wheel drive and the last of the classic silhouette."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SixthGear timeline",
      "blocks": [
        { "type": "step", "settings": { "model": "911 (901)", "years": "1963–1973", "text": "The original. Air-cooled, rear-engined and impossibly pure." } },
        { "type": "step", "settings": { "model": "911 (G-Series)", "years": "1974–1989", "text": "Impact bumpers, Turbo whale tails and a decade of icons." } },
        { "type": "step", "settings": { "model": "911 (964)", "years": "1989–1994", "text": "Coil springs, all-wheel drive and the last of the classic silhouette." } },
        { "type": "step", "settings": { "model": "911 (993)", "years": "1994–1998", "text": "The final air-cooled 911, and for many the most beautiful." } }
      ]
    }
  ]
}
{% endschema %}
