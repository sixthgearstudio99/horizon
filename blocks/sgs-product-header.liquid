{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product

  # Eyebrow: the print's first style collection, skipping utility collections
  assign eyebrow = ''
  assign crumb_collection = nil
  case block_settings.eyebrow_source
    when 'collection'
      # 1) the first of the preferred style collections this print belongs to
      assign preferred = block_settings.preferred_collections | split: ','
      for wanted in preferred
        assign wanted_handle = wanted | strip
        for c in product_resource.collections
          if c.handle == wanted_handle
            assign eyebrow = c.title
            assign crumb_collection = c
            break
          endif
        endfor
        if eyebrow != ''
          break
        endif
      endfor

      # 2) otherwise any collection that isn't a utility one (all, home page, best sellers)
      if eyebrow == ''
        assign skip_handles = 'all,frontpage,home,home-page' | split: ','
        for c in product_resource.collections
          assign squashed = c.handle | remove: '-' | remove: '_'
          if skip_handles contains c.handle or squashed contains 'bestseller'
            continue
          endif
          assign eyebrow = c.title
          assign crumb_collection = c
          break
        endfor
      endif
    when 'type'
      assign eyebrow = product_resource.type
    when 'custom'
      assign eyebrow = block_settings.eyebrow_text
  endcase
-%}

<script src="{{ 'sgs-gallery-fit.js' | asset_url }}" defer></script>

<div class="sgs-pdp-header" {{ block.shopify_attributes }}>
  {%- if block_settings.show_breadcrumb -%}
    <nav class="sgs-crumbs sgs-pdp-header__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {%- if crumb_collection -%}
        <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">All Prints</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product_resource.title | escape }}</span>
    </nav>
  {%- elsif eyebrow != blank -%}
    <p class="sgs-pdp-header__eyebrow sgs-label">{{ eyebrow | escape }}</p>
  {%- endif -%}
  <h1 class="sgs-pdp-header__title">{{ product_resource.title | escape }}</h1>
  {%- liquid
    # Line under the title, e.g. "Lineage · SixthGear Studios": [collection] is the print's first
    # style collection; with none, that part is left out
    assign subtitle = block_settings.subtitle | strip
    if subtitle != blank
      if crumb_collection
        assign subtitle = subtitle | replace: '[collection]', crumb_collection.title
      else
        assign subtitle = subtitle | remove: '[collection] · ' | remove: '[collection] | ' | remove: '[collection]' | strip
      endif
    endif
  -%}
  {%- if subtitle != blank -%}
    <p class="sgs-pdp-header__sub">{{ subtitle | escape }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .sgs-pdp-header {
    width: 100%;
  }

  .sgs-pdp-header__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0 0 20px;
  }

  /* Phones: no breadcrumb, so the title and price fit on the first screen */
  @media screen and (max-width: 749px) {
    .sgs-pdp-header__crumbs {
      display: none;
    }
  }

  .sgs-pdp-header__crumbs [aria-current] {
    color: var(--sgs-text, currentColor);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  .sgs-pdp-header__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 18px;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .sgs-pdp-header__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .sgs-pdp-header__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.75rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: none;
    text-wrap: balance;
  }

  /* Collection and studio, quietly under the title */
  .sgs-pdp-header__sub {
    margin: 8px 0 0;
    font-family: var(--sgs-font-body, Inter, sans-serif);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--sgs-text-2, #6b6b6b);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear product title",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true,
      "info": "Home / collection / print, in place of the collection label."
    },
    {
      "type": "select",
      "id": "eyebrow_source",
      "label": "Label above title",
      "options": [
        { "value": "collection", "label": "First collection" },
        { "value": "type", "label": "Product type" },
        { "value": "custom", "label": "Custom text" },
        { "value": "none", "label": "None" }
      ],
      "default": "collection"
    },
    {
      "type": "text",
      "id": "preferred_collections",
      "label": "Preferred collections",
      "default": "lineage,portraits,grand-prix,mindset",
      "info": "Collection handles, in order. The label shows the first one the print belongs to.",
      "visible_if": "{{ block.settings.eyebrow_source == 'collection' }}"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Line under the title",
      "default": "[collection] · SixthGear Studios",
      "info": "[collection] is the print's first style collection (left out when it has none). Leave empty to hide."
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Custom label",
      "default": "Automotive art print",
      "visible_if": "{{ block.settings.eyebrow_source == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "SixthGear product title"
    }
  ]
}
{% endschema %}
