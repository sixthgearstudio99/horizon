{%- liquid
  # SixthGear: three frame details with icons, on framed prints only (tag "framed" or "Framed" in
  # the title, the same rule as the collection grids: snippets/sgs-framed-tag.liquid). Text and
  # on/off in Theme settings > SixthGear: product page trust.
  assign show = settings.sgs_frame_feat_enabled
  if closest.product == blank
    assign show = false
  endif
  if show
    capture is_framed
      render 'sgs-framed-tag', product_resource: closest.product
    endcapture
    unless is_framed contains 'true'
      assign show = false
    endunless
  endif
  assign feat_count = 0
  for i in (1..3)
    assign feat_key = 'sgs_frame_feat_' | append: i
    if settings[feat_key] != blank
      assign feat_count = feat_count | plus: 1
    endif
  endfor
  if feat_count == 0
    assign show = false
  endif
-%}

{%- if show -%}
  <ul class="sgs-ffeat" role="list" style="--sgs-ffeat-count: {{ feat_count }};" {{ block.shopify_attributes }}>
    {%- for i in (1..3) -%}
      {%- assign feat_key = 'sgs_frame_feat_' | append: i -%}
      {%- if settings[feat_key] != blank -%}
        <li class="sgs-ffeat__item">
          {%- case i -%}
            {%- when 1 -%}
              <svg class="sgs-ffeat__icon" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18"/><rect x="7" y="7" width="10" height="10"/><path d="M3 3l4 4M21 3l-4 4M3 21l4-4M21 21l-4-4"/></svg>
            {%- when 2 -%}
              <svg class="sgs-ffeat__icon" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8l3-3M8 12l7-7M11 16l6-6"/></svg>
            {%- else -%}
              <svg class="sgs-ffeat__icon" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4" r="1.5"/><path d="M12 5.5L4 12M12 5.5l8 6.5"/><rect x="3" y="12" width="18" height="9"/></svg>
          {%- endcase -%}
          <span>{{ settings[feat_key] | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .sgs-ffeat {
    display: grid;
    grid-template-columns: repeat(var(--sgs-ffeat-count, 3), minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-ffeat__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 12px 6px;
    border: 1px solid var(--sgs-line, #2a2a2a);
    border-radius: 10px;
    font-size: 12px;
    line-height: 1.35;
    text-align: center;
    color: var(--sgs-text, #f2efea);
  }

  /* The sgs-studio.css rule hiding list icons doesn't reach these */
  html body .sgs-ffeat .sgs-ffeat__icon {
    display: block !important;
    flex-shrink: 0;
    color: var(--sgs-text, #f2efea);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Frame details",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Framed prints only. Text and on/off in Theme settings > SixthGear: product page trust."
    }
  ],
  "presets": [
    {
      "name": "Frame details"
    }
  ]
}
{% endschema %}
