{%- liquid
  # SixthGear: on an unframed print, one line under the sizes linking to its framed version
  # (custom.framed_version), e.g. "Want it ready to hang? Framed from £55.99". Hidden on framed
  # prints and when there's no framed version.
  assign bs = block.settings
  assign product_resource = closest.product
  assign framed = product_resource.metafields.custom.framed_version.value

  assign show = true
  if framed == blank or framed.url == blank or framed.id == product_resource.id or product_resource.gift_card?
    assign show = false
  endif
  if show
    capture sgs_framed
      render 'sgs-is-framed', product_resource: product_resource
    endcapture
    if sgs_framed contains 'true'
      assign show = false
    endif
  endif

  if show
    assign framed_price = framed.price_min | default: framed.price | money_without_trailing_zeros
    assign line = bs.price_line | default: 'Want it ready to hang? Framed from [price]' | escape | replace: '[price]', framed_price
  endif
-%}

{%- if show and line != blank -%}
  <p class="sgs-fup-line" {{ block.shopify_attributes }}>
    <a href="{{ framed.url }}">{{ line }}</a>
  </p>
{%- endif -%}

{% stylesheet %}
  .sgs-fup-line {
    width: 100%;
    margin: -4px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .sgs-fup-line a {
    color: var(--sgs-text, #f2efea);
    text-decoration: underline;
    text-decoration-color: rgb(var(--sgs-text-rgb, 242 239 234) / 0.4);
    text-underline-offset: 3px;
  }

  .sgs-fup-line a:hover {
    text-decoration-color: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Framed version line",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "price_line",
      "label": "Line",
      "default": "Want it ready to hang? Framed from [price]",
      "info": "Shown on unframed prints that have a framed version (custom.framed_version), linking to it. [price] is the framed version's starting price. Leave empty to hide."
    }
  ],
  "presets": [
    {
      "name": "Framed version line"
    }
  ]
}
{% endschema %}
