{%- liquid
  # SixthGear: Unframed / Framed switch between two linked products (custom.unframed_version and
  # custom.framed_version, both product references). Renders nothing unless one is set and the
  # other version exists. Switching keeps the chosen size where the other product has it.
  assign bs = block.settings
  assign p = closest.product
  assign framed_ref = p.metafields.custom.framed_version.value
  assign unframed_ref = p.metafields.custom.unframed_version.value

  capture is_framed
    render 'sgs-is-framed', product_resource: p
  endcapture
  assign is_framed = is_framed | strip

  if is_framed == 'true'
    assign other = unframed_ref
    assign framed_product = p
  else
    assign other = framed_ref
    assign framed_product = framed_ref
  endif

  assign show = true
  if p == blank or p.gift_card?
    assign show = false
  elsif framed_ref == blank and unframed_ref == blank
    assign show = false
  elsif other == blank or other.id == p.id
    assign show = false
  endif
-%}

{%- if show -%}
  {%- liquid
    # The size option on each product (an option whose name contains "size")
    assign cur_idx = -1
    for o in p.options_with_values
      assign oname = o.name | downcase
      if oname contains 'size'
        assign cur_opt = o
        assign cur_idx = forloop.index0
        break
      endif
    endfor
    assign oth_idx = -1
    for o in other.options_with_values
      assign oname = o.name | downcase
      if oname contains 'size'
        assign oth_idx = forloop.index0
        break
      endif
    endfor

    # The other product's sizes: every size it has ("|key|"), and its available variants ("key=id")
    assign oth_keys = '|'
    assign oth_pairs = ''
    if cur_idx >= 0 and oth_idx >= 0
      assign oth_opt = other.options_with_values[oth_idx]
      for v in other.variants
        capture k
          render 'sgs-size-key', value: v.options[oth_idx]
        endcapture
        assign oth_keys = oth_keys | append: k | append: '|'
        if v.available
          assign oth_pairs = oth_pairs | append: '|' | append: k | append: '=' | append: v.id
        endif
      endfor
    endif
    assign oth_pairs = oth_pairs | append: '|'

    assign fallback_id = other.first_available_variant.id

    # For each of this product's sizes, the variant of the other product to link to:
    #   1) the same size, when the other product has it (e.g. 16x24 -> 16x24)
    #   2) when the other product has no such size at all, the size in the same position
    #      (1st -> 1st, 2nd -> 2nd: 20x10 -> 18x12, 22x11 -> 24x16, 30x15 -> 36x24)
    #   3) otherwise its first available variant (left out of the map; the link falls back to it)
    assign selected_size = ''
    if cur_idx >= 0
      assign selected_size = p.selected_or_first_available_variant.options[cur_idx]
    endif
    assign href_id = fallback_id
    capture size_map
      echo '{'
      if cur_idx >= 0 and oth_pairs != '|'
        assign sep = ''
        for val in cur_opt.values
          assign match_id = ''
          capture k
            render 'sgs-size-key', value: val.name
          endcapture
          assign key_needle = '|' | append: k | append: '|'
          assign needle = '|' | append: k | append: '='
          if k != blank and oth_keys contains key_needle
            # 1) Same size (only if one is available)
            if oth_pairs contains needle
              assign after = oth_pairs | split: needle
              assign match_id = after[1] | split: '|' | first
            endif
          else
            # 2) Same position
            assign position = forloop.index0
            assign target = oth_opt.values[position]
            if target != blank
              for v in other.variants
                if v.available and v.options[oth_idx] == target.name
                  assign match_id = v.id
                  break
                endif
              endfor
            endif
          endif
          if match_id != blank
            echo sep
            echo val.name | json
            echo ':'
            echo match_id
            assign sep = ','
            if val.name == selected_size
              assign href_id = match_id
            endif
          endif
        endfor
      endif
      echo '}'
    endcapture

    assign other_href = other.url
    if href_id != blank
      assign other_href = other.url | append: '?variant=' | append: href_id
    endif

    # Each card: name, a short description and its starting price (sale-aware, like the size cards).
    # The price is shown on the card, so "From [price] · " in an older description is dropped.
    assign framed_desc = bs.framed_note | strip | remove: 'From [price] · ' | remove: 'From [price]' | replace: '[price]', '' | strip
    assign unframed_desc = bs.unframed_note | strip
    if is_framed == 'true'
      assign unframed_product = other
    else
      assign unframed_product = p
    endif
    capture sgs_sale_win
      render 'sgs-sale-window'
    endcapture
    assign sgs_sale_win = sgs_sale_win | strip
    assign label_id = 'SgsFinish-' | append: block.id
  -%}

  {%- capture unframed_price -%}
    {%- if bs.show_prices -%}
      <span class="sgs-finish__price">{{ bs.from_label | default: 'From' | escape }} <span class="sgs-tile-price">
        {%- if sgs_sale_win != blank -%}{% render 'sgs-sale-price', product_resource: unframed_product, window: sgs_sale_win, amount: unframed_product.price_min %}{%- endif -%}
        <span class="sgs-tile-price__normal">{{ unframed_product.price_min | money_without_trailing_zeros }}</span>
      </span></span>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture framed_price -%}
    {%- if bs.show_prices -%}
      <span class="sgs-finish__price">{{ bs.from_label | default: 'From' | escape }} <span class="sgs-tile-price">
        {%- if sgs_sale_win != blank -%}{% render 'sgs-sale-price', product_resource: framed_product, window: sgs_sale_win, amount: framed_product.price_min %}{%- endif -%}
        <span class="sgs-tile-price__normal">{{ framed_product.price_min | money_without_trailing_zeros }}</span>
      </span></span>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture unframed_inner -%}
    <span class="sgs-finish__name">{{ bs.unframed_label | escape }}</span>
    {%- if unframed_desc != blank -%}<span class="sgs-finish__desc">{{ unframed_desc | escape }}</span>{%- endif -%}
    {{- unframed_price -}}
  {%- endcapture -%}
  {%- capture framed_inner -%}
    <span class="sgs-finish__name">{{ bs.framed_label | escape }}</span>
    {%- if framed_desc != blank -%}<span class="sgs-finish__desc">{{ framed_desc | escape }}</span>{%- endif -%}
    {{- framed_price -}}
  {%- endcapture -%}

  <sgs-finish
    id="sgs-finish"
    class="sgs-finish"
    data-size-option="{% if cur_idx >= 0 %}{{ cur_opt.name | escape }}{% endif %}"
    data-other-url="{{ other.url }}"
    data-fallback-id="{{ fallback_id }}"
    {{ block.shopify_attributes }}
  >
    {%- if bs.label != blank -%}
      <p class="sgs-finish__label" id="{{ label_id }}">{{ bs.label | escape }}</p>
    {%- endif -%}
    <div class="sgs-finish__options" role="group"{% if bs.label != blank %} aria-labelledby="{{ label_id }}"{% endif %}>
      {%- if is_framed == 'true' -%}
        <a class="sgs-finish__card" href="{{ other_href }}" data-sgs-finish-link>{{ unframed_inner }}</a>
        <span class="sgs-finish__card sgs-finish__card--on" aria-current="true">{{ framed_inner }}</span>
      {%- else -%}
        <span class="sgs-finish__card sgs-finish__card--on" aria-current="true">{{ unframed_inner }}</span>
        <a class="sgs-finish__card" href="{{ other_href }}" data-sgs-finish-link>{{ framed_inner }}</a>
      {%- endif -%}
    </div>
    <script type="application/json" data-sgs-finish-map>{{ size_map | strip }}</script>
  </sgs-finish>

  <script>
    if (!customElements.get('sgs-finish')) {
      customElements.define(
        'sgs-finish',
        class extends HTMLElement {
          connectedCallback() {
            this.link = this.querySelector('[data-sgs-finish-link]');
            if (!this.link || !this.dataset.sizeOption) return;
            try {
              this.map = JSON.parse(this.querySelector('[data-sgs-finish-map]').textContent || '{}');
            } catch (e) {
              this.map = {};
            }
            this.root = this.closest('.shopify-section') || document;
            this.sync = () => this.update();
            this.root.addEventListener('change', this.sync);
            this.link.addEventListener('pointerdown', this.sync);
            this.link.addEventListener('focus', this.sync);
            this.link.addEventListener('click', this.sync);
          }

          disconnectedCallback() {
            if (this.root && this.sync) this.root.removeEventListener('change', this.sync);
          }

          /* The size chosen in the main variant picker right now */
          selectedSize() {
            const picker = this.root.querySelector('variant-picker[ref="mainVariantPicker"]') || this.root.querySelector('variant-picker');
            if (!picker) return '';
            const name = this.dataset.sizeOption;
            for (const select of picker.querySelectorAll('select')) {
              const option = select.selectedOptions[0];
              if (option && option.dataset.optionName === name) return option.value;
            }
            for (const input of picker.querySelectorAll('input[type="radio"]:checked')) {
              if (input.dataset.optionName === name) return input.value;
            }
            return '';
          }

          update() {
            const size = this.selectedSize();
            const id = (size && this.map[size]) || this.dataset.fallbackId;
            this.link.href = id ? this.dataset.otherUrl + '?variant=' + id : this.dataset.otherUrl;
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sgs-finish {
    display: block;
    width: 100%;
    font-family: var(--sgs-font-body, Inter, sans-serif);
    color: var(--sgs-text, #111111);
  }

  .sgs-finish__label {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--sgs-text, #111111);
  }

  /* Two cards side by side: name, a short line, the starting price */
  .sgs-finish__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .sgs-finish__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 0;
    min-height: 84px;
    padding: 12px 10px;
    border: 1px solid rgb(17 17 17 / 0.22);
    border-radius: var(--sgs-radius-btn, 4px);
    background: var(--sgs-raised, #ffffff);
    color: var(--sgs-text, #111111);
    text-align: center;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  a.sgs-finish__card:hover {
    border-color: var(--sgs-text, #111111);
  }

  a.sgs-finish__card:focus-visible {
    outline: 2px solid var(--sgs-text, #111111);
    outline-offset: 2px;
  }

  .sgs-finish__card--on {
    border-color: #111111;
    background: #111111;
    color: #ffffff;
  }

  .sgs-finish__name {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .sgs-finish__desc {
    font-size: 12px;
    line-height: 1.35;
    opacity: 0.75;
  }

  .sgs-finish__price {
    margin-top: 5px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .sgs-finish__price .sgs-tile-price {
    position: static;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: 0;
  }

  .sgs-finish__price .sgs-sale {
    gap: 0 5px;
    align-items: baseline;
    font-size: 13px;
    font-weight: 500;
  }

  .sgs-finish__price .sgs-sale__now {
    order: 1;
    color: inherit;
  }

  .sgs-finish__price .sgs-sale__was {
    order: 2;
    font-size: 11px;
    font-weight: 400;
    color: inherit;
    opacity: 0.72;
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-finish__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Finish toggle",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Switches between a print's unframed and framed versions, set in the product's custom.unframed_version and custom.framed_version metafields. Hidden when neither is set."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Finish"
    },
    {
      "type": "text",
      "id": "unframed_label",
      "label": "Unframed button",
      "default": "Unframed"
    },
    {
      "type": "text",
      "id": "unframed_note",
      "label": "Unframed description",
      "default": "Premium art print",
      "info": "A short line on the unframed card. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "framed_label",
      "label": "Framed button",
      "default": "Framed"
    },
    {
      "type": "text",
      "id": "framed_note",
      "label": "Framed description",
      "default": "Ready-to-hang framed artwork",
      "info": "A short line on the framed card. Leave empty to hide."
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show starting prices",
      "default": true
    },
    {
      "type": "text",
      "id": "from_label",
      "label": "Word before the price",
      "default": "From"
    }
  ],
  "presets": [
    {
      "name": "Finish toggle"
    }
  ]
}
{% endschema %}
