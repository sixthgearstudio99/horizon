{%- liquid
  assign s = section.settings
  assign source = s.collection | default: collections.all
  assign limit = s.products_to_show

  if s.view_all_link != blank
    assign view_all_url = s.view_all_link
  elsif s.collection != blank
    assign view_all_url = s.collection.url
  else
    assign view_all_url = routes.all_products_collection_url | append: '?sort_by=best-selling'
  endif

  case s.columns
    when '3'
      assign card_sizes = '(min-width: 990px) 31vw, (min-width: 750px) 46vw, 78vw'
    when '5'
      assign card_sizes = '(min-width: 990px) 19vw, (min-width: 750px) 46vw, 78vw'
    else
      assign card_sizes = '(min-width: 990px) 23vw, (min-width: 750px) 46vw, 78vw'
  endcase
  if s.mobile_layout == 'grid'
    assign card_sizes = card_sizes | replace: '78vw', '46vw'
  endif

  assign bg = s.background_color | default: settings.color_palette.background
  assign bg_brightness = bg | color_brightness
  if bg_brightness < 128
    assign tone = 'dark'
  else
    assign tone = 'light'
  endif
-%}

{% render 'sgs-grid-styles' %}

<section
  class="sgs-grid sgs-grid--{{ tone }} sgs-grid--mobile-{{ s.mobile_layout }}"
  style="
    --sgs-grid-bg: {{ bg }};
    --sgs-grid-columns: {{ s.columns }};
    --sgs-grid-pad-top: {{ s['padding-block-start'] }}px;
    --sgs-grid-pad-bottom: {{ s['padding-block-end'] }}px;
  "
  {% if s.heading != blank %}
    aria-labelledby="SgsGridHeading-{{ section.id }}"
  {% endif %}
>
  <div class="sgs-grid__inner">
    {%- if s.eyebrow != blank or s.heading != blank or s.view_all_label != blank -%}
      <header class="sgs-grid__header" data-sgs-reveal>
        <div class="sgs-grid__titles">
          {%- if s.eyebrow != blank -%}
            <p class="sgs-grid__eyebrow sgs-label">{{ s.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 id="SgsGridHeading-{{ section.id }}" class="sgs-grid__heading">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if s.view_all_label != blank -%}
          <a class="sgs-link sgs-grid__view-all" href="{{ view_all_url }}">
            {{- s.view_all_label | escape -}}
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14">
              <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="sgs-grid__list" role="list" data-sgs-reveal-group>
      {%- if source.products_count > 0 -%}
        {%- for product in source.products limit: limit -%}
          <li class="sgs-grid__item" data-sgs-reveal>
            {% render 'sgs-product-card',
              product: product,
              show_secondary: s.show_secondary_image,
              show_options: s.show_option_count,
              sizes: card_sizes
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          <li class="sgs-grid__item" data-sgs-reveal>
            {% render 'sgs-product-card',
              placeholder_index: placeholder_index
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>


{% schema %}
{
  "name": "SixthGear product grid",
  "tag": "div",
  "class": "sgs-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "For best sellers, choose a collection sorted by best selling. Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "carousel", "label": "Swipeable row" },
        { "value": "grid", "label": "Two-column grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true,
      "info": "Make your on-the-wall mockup the product's second image in Shopify."
    },
    {
      "type": "checkbox",
      "id": "show_option_count",
      "label": "Show number of sizes",
      "default": true
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Start your wall"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "Shop all prints"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link",
      "info": "Defaults to the chosen collection, or all products sorted by best selling."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 136
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 136
    }
  ],
  "presets": [
    {
      "name": "SixthGear product grid"
    }
  ]
}
{% endschema %}
