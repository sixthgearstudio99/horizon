{%- doc -%}
  SixthGear Studios: on a product whose options don't all combine (e.g. 20 × 10 in only on Fine Art,
  22 × 11 in only on Semi Glossy), tapping a value that doesn't come with the current choices switches
  the other option to one it does come with, instead of landing on a combination that doesn't exist.
  Outputs every variant's options as JSON (read by the script) and the script itself, bound once.
  Render it inside the variant picker's form.

  With paper_hidden (the Paper choice isn't shown), the product page also opens on the default
  paper: when the page has no ?variant= in its address and the variant Shopify picked is another
  paper, the first available variant in the default paper is chosen. A product with no available
  variant in that paper keeps Shopify's first available variant. A ?variant= link is respected.

  @param {product} product_resource - The product
  @param {string} [default_paper] - The paper to open on, e.g. "Semi Glossy" (any case)
  @param {boolean} [paper_hidden] - true when the Paper choice is hidden

  @example
  {% render 'sgs-variant-autoswitch', product_resource: product_resource %}
{%- enddoc -%}

{%- if product_resource.options.size > 1 -%}
  {%- comment -%} Every variant's options, so a tap can switch to a combination that exists {%- endcomment -%}
  <script type="application/json" data-sgs-variant-options{% if paper_hidden and default_paper != blank %} data-sgs-default-paper="{{ default_paper | strip | downcase | escape }}"{% endif %}>
    {
      "names": {{ product_resource.options | json }},
      "variants": [
        {%- for v in product_resource.variants -%}
          { "id": {{ v.id | json }}, "options": {{ v.options | json }}, "available": {{ v.available | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script>
  (function () {
    // A size that doesn't come in the chosen paper (e.g. 22 × 11 in on Fine Art) is still
    // tappable: before Horizon reads the choice, the other option switches to the one that
    // size comes in. Runs on window in the capture phase, ahead of Horizon's own listener.
    if (window.sgsAutoSwitchBound) return;
    window.sgsAutoSwitchBound = true;
    window.addEventListener('change', function (event) {
      var input = event.target;
      if (!(input instanceof HTMLInputElement) || input.type !== 'radio' || !input.dataset.optionName) return;
      var picker = input.closest('variant-picker');
      var source = picker && picker.querySelector('script[data-sgs-variant-options]');
      if (!source) return;
      try {
        var data = JSON.parse(source.textContent);
        var pos = data.names.indexOf(input.dataset.optionName);
        if (pos < 0) return;
        var chosen = {};
        picker.querySelectorAll('fieldset input:checked').forEach(function (el) {
          var i = data.names.indexOf(el.dataset.optionName);
          if (i >= 0) chosen[i] = el.value;
        });
        chosen[pos] = input.value;
        var matches = function (v) {
          return Object.keys(chosen).every(function (i) { return v.options[i] === chosen[i]; });
        };
        if (data.variants.some(matches)) return;
        // The closest variant with the tapped value: most other choices kept, available first
        var best = null, bestScore = -1;
        data.variants.forEach(function (v) {
          if (v.options[pos] !== input.value) return;
          var score = (v.available ? 100 : 0);
          Object.keys(chosen).forEach(function (i) { if (v.options[i] === chosen[i]) score++; });
          if (score > bestScore) { best = v; bestScore = score; }
        });
        if (!best) return;
        best.options.forEach(function (value, i) {
          if (i === pos || chosen[i] === undefined || chosen[i] === value) return;
          picker.querySelectorAll('fieldset input[type="radio"]').forEach(function (el) {
            if (el.dataset.optionName === data.names[i]) {
              el.checked = el.value === value;
              el.dataset.currentChecked = String(el.checked);
            }
          });
        });
        input.dataset.variantId = String(best.id);
      } catch (e) {}
    }, true);

    // Paper hidden: open the product page on the default paper (see the doc above)
    function openOnDefaultPaper() {
      if (window.sgsDefaultPaperDone) return;
      window.sgsDefaultPaperDone = true;
      try {
        if (new URL(window.location.href).searchParams.has('variant')) return;
        var source = document.querySelector('variant-picker[data-template-product-match="true"] script[data-sgs-default-paper]');
        if (!source || source.closest('product-card, quick-add-dialog')) return;
        var picker = source.closest('variant-picker');
        var want = source.dataset.sgsDefaultPaper;
        var data = JSON.parse(source.textContent);
        var paperPos = -1;
        data.names.forEach(function (name, i) { if (paperPos < 0 && name.toLowerCase().indexOf('paper') > -1) paperPos = i; });
        if (paperPos < 0) return;
        var radios = Array.prototype.slice.call(picker.querySelectorAll('fieldset input[type="radio"]'));
        var current = radios.filter(function (el) { return el.checked && el.dataset.optionName === data.names[paperPos]; })[0];
        if (!current || current.value.toLowerCase() === want) return;
        var target = data.variants.filter(function (v) { return v.available && String(v.options[paperPos]).toLowerCase() === want; })[0];
        if (!target) return;
        var fire = null;
        target.options.forEach(function (value, i) {
          radios.forEach(function (el) {
            if (el.dataset.optionName !== data.names[i]) return;
            var on = el.value === value;
            if (on && !el.checked && i !== paperPos) fire = el;
            if (on && i === paperPos && !fire) fire = el;
            el.checked = on;
            if (i === paperPos) el.dataset.currentChecked = String(on);
          });
        });
        var paperRadio = radios.filter(function (el) { return el.checked && el.dataset.optionName === data.names[paperPos]; })[0];
        if (!fire) fire = paperRadio;
        if (!fire) return;
        fire.dataset.variantId = String(target.id);
        fire.dispatchEvent(new Event('change', { bubbles: true }));
      } catch (e) {}
    }
    function whenReady() {
      if (window.customElements && customElements.whenDefined) {
        customElements.whenDefined('variant-picker').then(function () { requestAnimationFrame(openOnDefaultPaper); });
      } else {
        openOnDefaultPaper();
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', whenReady);
    } else {
      whenReady();
    }
  })();
</script>
{%- endif -%}
