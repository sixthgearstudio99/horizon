{%- liquid
  assign s = section.settings
  assign socials = 'instagram,tiktok,youtube,pinterest,facebook,x' | split: ','
  assign has_social = false
  for platform in socials
    assign key = platform | append: '_url'
    if s[key] != blank
      assign has_social = true
      break
    endif
  endfor
-%}

<footer class="sgs-footer" style="--sgs-footer-bg: {{ s.background_color | default: '#0E0E0E' }};">
  <div class="sgs-footer__inner">
    <div class="sgs-footer__top">
      <div class="sgs-footer__brand">
        <a class="sgs-footer__logo" href="{{ routes.root_url }}">
          {%- if settings.logo_inverse != blank -%}
            {{
              settings.logo_inverse
              | image_url: height: 120
              | image_tag: height: 44, class: 'sgs-footer__logo-img', alt: shop.name
            }}
          {%- else -%}
            {% render 'sgs-logo', variant: 'inverse', height: 44, height_mobile: 36, class: 'sgs-footer__logo-img', loading: 'lazy' %}
          {%- endif -%}
        </a>
        {%- if s.tagline != blank -%}
          <p class="sgs-footer__tagline">{{ s.tagline }}</p>
        {%- endif -%}

        {%- if has_social -%}
          <ul class="sgs-footer__social" role="list">
            {%- for platform in socials -%}
              {%- assign key = platform | append: '_url' -%}
              {%- if s[key] != blank -%}
                <li>
                  <a href="{{ s[key] }}" target="_blank" rel="noopener" aria-label="{{ shop.name | escape }} on {{ platform | capitalize | replace: 'Tiktok', 'TikTok' }} (opens in a new tab)">
                    {%- case platform -%}
                      {%- when 'instagram' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
                      {%- when 'tiktok' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                      {%- when 'youtube' -%}
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4.5" width="16" height="11" rx="3"/><path d="M8.5 7.5v5l4.2-2.5z"/></svg>
                      {%- when 'pinterest' -%}
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/></svg>
                      {%- when 'facebook' -%}
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><path d="M11.5 17.5V10.5h2.3l.4-2.7h-2.7V6.2c0-.8.3-1.3 1.4-1.3h1.4V2.6c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.4v1.9H6.6v2.7h2.3v7"/></svg>
                      {%- when 'x' -%}
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l13 13M16.5 3.5l-13 13"/></svg>
                    {%- endcase -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <nav class="sgs-footer__nav" aria-label="Footer">
        {%- for i in (1..3) -%}
          {%- assign menu_key = 'menu_' | append: i -%}
          {%- assign heading_key = 'menu_' | append: i | append: '_heading' -%}
          {%- assign menu = s[menu_key] -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            <div class="sgs-footer__col">
              <p class="sgs-footer__col-heading sgs-label">{{ s[heading_key] | default: menu.title | escape }}</p>
              <ul class="sgs-footer__links" role="list">
                {%- for link in menu.links -%}
                  <li>
                    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    {%- if s.business_address != blank or s.business_email != blank or s.business_phone != blank or s.disclaimer != blank -%}
      <div class="sgs-footer__legal">
        {%- if s.business_address != blank or s.business_email != blank or s.business_phone != blank -%}
          <p class="sgs-footer__business">
            {%- if s.business_address != blank -%}<span>{{ s.business_address | escape }}</span>{%- endif -%}
            {%- if s.business_email != blank -%}<span><a href="mailto:{{ s.business_email | escape }}">{{ s.business_email | escape }}</a></span>{%- endif -%}
            {%- if s.business_phone != blank -%}<span>{{ s.business_phone | escape }}</span>{%- endif -%}
          </p>
        {%- endif -%}
        {%- if s.disclaimer != blank -%}
          <p class="sgs-footer__disclaimer">{{ s.disclaimer | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sgs-footer__bottom">
      <p class="sgs-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ s.copyright_name | default: shop.name | escape }}
      </p>

      {%- if s.show_policies and shop.policies.size > 0 -%}
        <ul class="sgs-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="sgs-footer__payments" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'sgs-footer__payment' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .sgs-footer {
    --sgs-footer-fg: 245 243 239;

    background: var(--sgs-footer-bg);
    color: rgb(var(--sgs-footer-fg));
  }

  .sgs-footer__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sgs-footer__top {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    row-gap: 56px;
    padding-block: clamp(64px, 7vw, 112px);
    border-top: 1px solid rgb(var(--sgs-footer-fg) / 0.12);
  }

  .sgs-footer__brand {
    grid-column: 1 / span 5;
  }

  .sgs-footer__logo {
    display: inline-block;
  }

  .sgs-footer__logo-img {
    display: block;
    width: auto;
    height: var(--header-logo-image-height, 44px);
  }

  .sgs-footer__tagline {
    max-width: 32ch;
    margin: 28px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgb(var(--sgs-footer-fg) / 0.6);
  }

  .sgs-footer__social {
    display: flex;
    gap: 8px;
    margin: 32px 0 0 -10px;
    padding: 0;
    list-style: none;
  }

  .sgs-footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: rgb(var(--sgs-footer-fg) / 0.7);
    transition: color 0.3s ease;
  }

  .sgs-footer__social a:hover {
    color: rgb(var(--sgs-footer-fg));
  }

  .sgs-footer__nav {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }

  .sgs-footer__col-heading {
    margin: 0 0 24px;
    color: rgb(var(--sgs-footer-fg) / 0.45);
  }

  .sgs-footer__links {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-footer__links a,
  .sgs-footer__policies a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    transition: background-size 0.5s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
  }

  .sgs-footer__links a {
    font-size: 15px;
    color: rgb(var(--sgs-footer-fg) / 0.85);
  }

  .sgs-footer__links a:hover,
  .sgs-footer__policies a:hover {
    color: rgb(var(--sgs-footer-fg));
    background-size: 100% 1px;
  }

  /* Business details and disclaimer: small print above the copyright row */
  .sgs-footer__legal {
    padding-block: 24px;
    border-top: 1px solid rgb(var(--sgs-footer-fg) / 0.12);
    font-size: 12px;
    line-height: 1.7;
    color: rgb(var(--sgs-footer-fg) / 0.5);
  }

  .sgs-footer__legal p {
    margin: 0;
  }

  .sgs-footer__business {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 0;
  }

  .sgs-footer__business span:not(:last-child)::after {
    content: '·';
    margin-inline: 10px;
    opacity: 0.6;
  }

  .sgs-footer__business a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgb(var(--sgs-footer-fg) / 0.3);
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }

  .sgs-footer__business a:hover {
    color: rgb(var(--sgs-footer-fg));
  }

  .sgs-footer__disclaimer {
    max-width: 72ch;
    margin-top: 6px !important;
  }

  .sgs-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding-block: 28px 36px;
    border-top: 1px solid rgb(var(--sgs-footer-fg) / 0.12);
    font-size: 12px;
    color: rgb(var(--sgs-footer-fg) / 0.5);
  }

  .sgs-footer__copyright {
    margin: 0;
    letter-spacing: 0.04em;
  }

  .sgs-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sgs-footer__payment {
    display: block;
    width: 34px;
    height: 22px;
    opacity: 0.85;
  }

  @media screen and (max-width: 989px) {
    .sgs-footer__brand,
    .sgs-footer__nav {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .sgs-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sgs-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-footer__links a,
    .sgs-footer__policies a {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear footer",
  "tag": "div",
  "class": "sgs-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "paragraph",
      "content": "Uses the inverse logo from Theme settings, or the bundled SixthGear logo."
    },
    {
      "type": "inline_richtext",
      "id": "tagline",
      "label": "Tagline",
      "default": "Automotive art prints for the driven. Printed to order. Free UK delivery."
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Column 1 heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Column 2 heading",
      "default": "Collections"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "menu_3_heading",
      "label": "Column 3 heading",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Column 3 menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Social"
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "url", "id": "youtube_url", "label": "YouTube" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" },
    { "type": "url", "id": "facebook_url", "label": "Facebook" },
    { "type": "url", "id": "x_url", "label": "X" },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "header",
      "content": "Business details"
    },
    {
      "type": "text",
      "id": "business_address",
      "label": "Address",
      "default": "SixthGear Studios, 3 Fossedale Avenue, Bristol BS14 9LR, United Kingdom"
    },
    {
      "type": "text",
      "id": "business_email",
      "label": "Email",
      "default": "hello@sixthgearstudios.co.uk"
    },
    {
      "type": "text",
      "id": "business_phone",
      "label": "Phone",
      "default": "0117 441 6014"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Independent artwork. Not affiliated with or endorsed by any vehicle manufacturer. All trademarks belong to their respective owners."
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "default": "SixthGear Studios"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0E0E0E"
    }
  ],
  "presets": [
    {
      "name": "SixthGear footer"
    }
  ]
}
{% endschema %}
