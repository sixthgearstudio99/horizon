{%- liquid
  assign bs = block.settings
  assign product_resource = closest.product
  assign uid = 'SgsSizeGuide-' | append: block.id

  # The product's size option (named "Size"), else the first option whose values are sizes
  assign size_option = nil
  for option in product_resource.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign size_option = option
      break
    endif
  endfor
  if size_option == nil
    for option in product_resource.options_with_values
      capture probe
        render 'sgs-size-dims', value: option.values.first.name
      endcapture
      if probe != blank
        assign size_option = option
        break
      endif
    endfor
  endif

  # "area|width|height|value", sorted smallest to largest
  assign entries = ''
  assign max_h = 0
  if size_option != nil
    for value in size_option.values
      capture dims
        render 'sgs-size-dims', value: value.name
      endcapture
      if dims != blank
        assign parts = dims | split: '|'
        assign w = parts[0] | plus: 0
        assign h = parts[1] | plus: 0
        assign area = w | times: h | round | plus: 1000000
        assign entries = entries | append: '~' | append: area | append: '|' | append: w | append: '|' | append: h | append: '|' | append: value.name
        if h > max_h
          assign max_h = h
        endif
      endif
    endfor
  endif
  assign entries = entries | remove_first: '~' | split: '~' | sort
  assign size_count = entries.size

  # The size chosen now, highlighted in the drawings and the list
  assign current_value = ''
  if size_option != nil
    assign size_index = size_option.position | minus: 1
    assign current_value = product_resource.selected_or_first_available_variant.options[size_index]
  endif

  # Scene, in centimetres: a 260 cm wall with a 210 cm sofa, and a 180 cm wall with a 120 cm desk
  assign sofa_w = 210
  assign sofa_h = 85
  assign desk_w = 120
  assign desk_h = 75
  assign wall_h = sofa_h | plus: 25 | plus: max_h | plus: 18
  assign desk_need = desk_h | plus: 30 | plus: max_h | plus: 18
  if desk_need > wall_h
    assign wall_h = desk_need
  endif
  if wall_h < 220
    assign wall_h = 220
  endif
  assign floor_y = wall_h | minus: 8
  assign sofa_top = floor_y | minus: sofa_h
  assign sofa_print_bottom = sofa_top | minus: 25
  assign desk_top = floor_y | minus: desk_h
  assign desk_print_bottom = desk_top | minus: 30
-%}

{%- if size_count > 0 and product_resource.gift_card? != true -%}
  <div class="sgs-sg" {{ block.shopify_attributes }}>
    <button type="button" class="sgs-sg__link" aria-haspopup="dialog" aria-controls="{{ uid }}" data-sg-open>
      {{- bs.link_label | escape -}}
    </button>

    <dialog class="sgs-sg__dialog" id="{{ uid }}" aria-labelledby="{{ uid }}-title">
      <div class="sgs-sg__panel">
        <header class="sgs-sg__head">
          <h2 class="sgs-sg__title" id="{{ uid }}-title">{{ bs.heading | escape }}</h2>
          <button type="button" class="sgs-sg__close" aria-label="Close" data-sg-close>
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16"><path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          </button>
        </header>

        <div class="sgs-sg__scenes">
          <figure class="sgs-sg__scene sgs-sg__scene--sofa">
            <svg viewBox="0 0 260 {{ wall_h }}" role="img" aria-label="{{ bs.sofa_label | escape }}: the sizes shown to scale above a 210 cm sofa">
              <rect x="0" y="0" width="260" height="{{ floor_y }}" class="sgs-sg__wall"/>
              <rect x="0" y="{{ floor_y }}" width="260" height="8" class="sgs-sg__floor"/>
              <svg x="25" y="{{ sofa_top }}" width="{{ sofa_w }}" height="{{ sofa_h }}" viewBox="0 0 210 85" preserveAspectRatio="none" class="sgs-sg__furniture">
                <rect x="0" y="22" width="22" height="55" rx="7"/>
                <rect x="188" y="22" width="22" height="55" rx="7"/>
                <rect x="12" y="6" width="186" height="46" rx="9"/>
                <rect x="20" y="44" width="85" height="26" rx="6" class="sgs-sg__light"/>
                <rect x="105" y="44" width="85" height="26" rx="6" class="sgs-sg__light"/>
                <rect x="10" y="66" width="190" height="11" rx="3"/>
                <rect x="22" y="77" width="4" height="8"/>
                <rect x="184" y="77" width="4" height="8"/>
              </svg>
              {%- liquid
                assign cx = 130
                assign bottom = sofa_print_bottom
              -%}
              {%- for entry in entries reversed -%}
                {%- liquid
                  assign parts = entry | split: '|'
                  assign w = parts[1] | plus: 0
                  assign h = parts[2] | plus: 0
                  assign number = size_count | minus: forloop.index0
                  assign x = w | divided_by: 2.0 | times: -1 | plus: cx | round: 1
                  assign y = bottom | minus: h | round: 1
                  assign lx = x | plus: 3
                  assign ly = y | plus: 11 | round: 1
                -%}
                {%- assign rect_value = parts | slice: 3, 99 | join: '|' -%}
                <rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" class="sgs-sg__print{% if rect_value == current_value %} is-current{% endif %}" data-value="{{ rect_value | escape }}"/>
                <text x="{{ lx }}" y="{{ ly }}" class="sgs-sg__num">{{ number }}</text>
              {%- endfor -%}
            </svg>
            <figcaption class="sgs-sg__cap">{{ bs.sofa_label | escape }}</figcaption>
          </figure>

          <figure class="sgs-sg__scene sgs-sg__scene--desk">
            <svg viewBox="0 0 180 {{ wall_h }}" role="img" aria-label="{{ bs.desk_label | escape }}: the sizes shown to scale above a 120 cm desk">
              <rect x="0" y="0" width="180" height="{{ floor_y }}" class="sgs-sg__wall"/>
              <rect x="0" y="{{ floor_y }}" width="180" height="8" class="sgs-sg__floor"/>
              <svg x="30" y="{{ desk_top }}" width="{{ desk_w }}" height="{{ desk_h }}" viewBox="0 0 120 75" preserveAspectRatio="none" class="sgs-sg__furniture">
                <rect x="0" y="0" width="120" height="4"/>
                <rect x="5" y="4" width="3" height="71"/>
                <rect x="112" y="4" width="3" height="71"/>
                <rect x="74" y="4" width="38" height="14" class="sgs-sg__light"/>
              </svg>
              {%- liquid
                assign cx = 90
                assign bottom = desk_print_bottom
              -%}
              {%- for entry in entries reversed -%}
                {%- liquid
                  assign parts = entry | split: '|'
                  assign w = parts[1] | plus: 0
                  assign h = parts[2] | plus: 0
                  assign number = size_count | minus: forloop.index0
                  assign x = w | divided_by: 2.0 | times: -1 | plus: cx | round: 1
                  assign y = bottom | minus: h | round: 1
                  assign lx = x | plus: 3
                  assign ly = y | plus: 11 | round: 1
                -%}
                {%- assign rect_value = parts | slice: 3, 99 | join: '|' -%}
                <rect x="{{ x }}" y="{{ y }}" width="{{ w }}" height="{{ h }}" class="sgs-sg__print{% if rect_value == current_value %} is-current{% endif %}" data-value="{{ rect_value | escape }}"/>
                <text x="{{ lx }}" y="{{ ly }}" class="sgs-sg__num">{{ number }}</text>
              {%- endfor -%}
            </svg>
            <figcaption class="sgs-sg__cap">{{ bs.desk_label | escape }}</figcaption>
          </figure>
        </div>

        <ol class="sgs-sg__list" role="list">
          {%- for entry in entries -%}
            {%- liquid
              assign parts = entry | split: '|'
              assign value_name = parts | slice: 3, 99 | join: '|'
              if size_count == 1
                assign use_line = bs.line_middle
              elsif forloop.first
                assign use_line = bs.line_small
              elsif forloop.last
                assign use_line = bs.line_large
              else
                assign use_line = bs.line_middle
              endif
            -%}
            {%- capture size_text -%}{% render 'sgs-size-label', value: value_name %}{%- endcapture -%}
            <li class="sgs-sg__item{% if value_name == current_value %} is-current{% endif %}" data-value="{{ value_name | escape }}">
              <span class="sgs-sg__item-num" aria-hidden="true">{{ forloop.index }}</span>
              <span class="sgs-sg__item-size">{{ size_text }}</span>
              {%- if use_line != blank -%}
                <span class="sgs-sg__item-use">{{ use_line | escape }}</span>
              {%- endif -%}
              {%- if bs.choose_label != blank -%}
                <button type="button" class="sgs-sg__choose" data-sg-choose aria-label="{{ bs.choose_label | escape }} {{ size_text | strip }}">
                  <span class="sgs-sg__choose-text">{{ bs.choose_label | escape }}</span>
                  <span class="sgs-sg__chosen-text">{{ bs.chosen_label | default: 'Selected' | escape }}</span>
                </button>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>

        {%- if bs.note != blank -%}
          <p class="sgs-sg__note">{{ bs.note | escape }}</p>
        {%- endif -%}

        {%- if bs.wall_label != blank -%}
          <button type="button" class="sgs-sg__wall-btn" data-sg-wall hidden>{{ bs.wall_label | escape }}</button>
        {%- endif -%}

        {%- if bs.back_label != blank -%}
          <button type="button" class="sgs-sg__back" data-sg-back>{{ bs.back_label | escape }}</button>
        {%- endif -%}
      </div>
    </dialog>

    <script>
      (function () {
        var root = document.currentScript.closest('.sgs-sg');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        var dialog = root.querySelector('dialog');
        var opener = root.querySelector('[data-sg-open]');
        var wallBtn = root.querySelector('[data-sg-wall]');
        var wallOpen = function () {
          var section = root.closest('.shopify-section') || document;
          return section.querySelector('.sgs-wall__open') || document.querySelector('.sgs-wall__open');
        };
        var lastOpener = opener;
        var scope = root.closest('.shopify-section') || document;
        var picker = function () {
          return scope.querySelector('variant-picker[ref="mainVariantPicker"]') || scope.querySelector('variant-picker');
        };
        // The size input (or select) of the picker that holds this value
        var sizeControls = function (value) {
          var p = picker();
          if (!p) return null;
          var radios = Array.prototype.filter.call(p.querySelectorAll('input[type="radio"]'), function (i) { return i.value === value; });
          if (radios.length) return { radio: radios[0] };
          var selects = Array.prototype.filter.call(p.querySelectorAll('select'), function (sel) {
            return Array.prototype.some.call(sel.options, function (o) { return o.value === value; });
          });
          return selects.length ? { select: selects[0] } : null;
        };
        var currentValue = function () {
          var values = Array.prototype.map.call(root.querySelectorAll('.sgs-sg__item[data-value]'), function (li) { return li.getAttribute('data-value'); });
          var p = picker();
          if (!p) return '';
          var checked = Array.prototype.filter.call(p.querySelectorAll('input[type="radio"]:checked'), function (i) { return values.indexOf(i.value) > -1; })[0];
          if (checked) return checked.value;
          var sel = Array.prototype.filter.call(p.querySelectorAll('select'), function (s) { return values.indexOf(s.value) > -1; })[0];
          return sel ? sel.value : '';
        };
        var mark = function () {
          var value = currentValue();
          if (!value) return;
          root.querySelectorAll('[data-value]').forEach(function (el) {
            el.classList.toggle('is-current', el.getAttribute('data-value') === value);
          });
        };
        // Close and bring the size options back into view, focus on the chosen size
        var backToOptions = function () {
          dialog.close();
          var p = picker();
          if (!p) return;
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var target = p.querySelector('.sgs-opt--size') || p;
          target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
          var focusTarget = p.querySelector('.sgs-opt--size input:checked') || p.querySelector('.sgs-opt--size select');
          if (focusTarget) setTimeout(function () { focusTarget.focus({ preventScroll: true }); }, reduce ? 0 : 400);
        };
        root.addEventListener('click', function (e) {
          var choose = e.target instanceof Element ? e.target.closest('[data-sg-choose]') : null;
          if (choose) {
            var value = choose.closest('[data-value]').getAttribute('data-value');
            var c = sizeControls(value);
            if (c && c.radio && !c.radio.checked) {
              (c.radio.closest('label') || c.radio).click();
            } else if (c && c.select && c.select.value !== value) {
              c.select.value = value;
              c.select.dispatchEvent(new Event('change', { bubbles: true }));
            }
            mark();
            backToOptions();
            return;
          }
          if (e.target instanceof Element && e.target.closest('[data-sg-back]')) backToOptions();
        });
        var open = function (from) {
          lastOpener = from || opener;
          var w = wallOpen();
          if (wallBtn) wallBtn.hidden = !w || w.hidden;
          mark();
          dialog.showModal();
        };
        opener.addEventListener('click', function () { open(opener); });
        // The variant picker can show its own "Which size?" link right under the size tiles
        (root.closest('.shopify-section') || document).addEventListener('click', function (e) {
          var trigger = e.target instanceof Element ? e.target.closest('[data-sgs-sg-trigger]') : null;
          if (trigger) open(trigger);
        });
        root.querySelector('[data-sg-close]').addEventListener('click', function () { dialog.close(); });
        dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
        dialog.addEventListener('close', function () {
          if (document.activeElement === document.body || !document.activeElement) lastOpener.focus({ preventScroll: true });
        });
        if (wallBtn) {
          wallBtn.addEventListener('click', function () {
            var w = wallOpen();
            dialog.close();
            if (w) w.click();
          });
        }
      })();
    </script>
  </div>
{%- endif -%}

{% stylesheet %}
  .sgs-sg {
    width: 100%;
    margin-top: -8px;
  }

  .sgs-sg__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sgs-text, #111111);
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: none;
    text-decoration: underline;
    text-decoration-color: rgb(17 17 17 / 0.3);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .sgs-sg__link:hover {
    text-decoration-color: currentColor;
  }

  .sgs-sg__link:focus-visible,
  .sgs-sg__close:focus-visible,
  .sgs-sg__wall-btn:focus-visible {
    outline: 1px solid var(--sgs-text, #111111);
    outline-offset: 3px;
  }

  /* Bottom sheet on phones, side drawer from the right on larger screens */
  .sgs-sg__dialog {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100%;
    max-height: 90svh;
    margin: 0;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
    background: var(--sgs-bg, #f5f3ef);
    color: var(--sgs-text, #111111);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .sgs-sg__dialog::backdrop {
    background: rgb(0 0 0 / 0.65);
  }

  @media screen and (min-width: 750px) {
    .sgs-sg__dialog {
      inset: 0 0 0 auto;
      width: min(520px, 100vw);
      height: 100%;
      max-height: 100%;
      border-top: 0;
      border-left: 1px solid var(--sgs-line, #e4e0d9);
    }
  }

  .sgs-sg__panel {
    padding: 20px 16px 32px;
  }

  @media screen and (min-width: 750px) {
    .sgs-sg__panel {
      padding: 28px 32px 40px;
    }
  }

  /* Stays at the top while the sheet scrolls, so Close is always in reach */
  .sgs-sg__head {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: -20px -16px 20px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--sgs-line, #e4e0d9);
    background: var(--sgs-bg, #f5f3ef);
  }

  @media screen and (min-width: 750px) {
    .sgs-sg__head {
      margin: -28px -32px 24px;
      padding: 18px 32px;
    }
  }

  .sgs-sg .sgs-sg__title {
    margin: 0;
    font-size: var(--sgs-h3, 1.0625rem) !important;
  }

  .sgs-sg__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -12px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  /* Both rooms side by side, columns in proportion to their walls (260 cm and 180 cm), so they
     keep the same scale and the size list stays close on phones */
  .sgs-sg__scenes {
    display: grid;
    grid-template-columns: 260fr 180fr;
    align-items: end;
    gap: 12px;
  }

  .sgs-sg__scene {
    margin: 0;
  }

  .sgs-sg__scene > svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sgs-sg__scene--desk > svg {
    width: 100%;
  }

  .sgs-sg__wall {
    fill: var(--sgs-raised, #ffffff);
  }

  .sgs-sg__floor {
    fill: #232220;
  }

  .sgs-sg__furniture {
    fill: #3d3a36;
  }

  .sgs-sg__furniture .sgs-sg__light {
    fill: #4b4843;
  }

  .sgs-sg__print {
    fill: rgb(17 17 17 / 0.06);
    stroke: rgb(17 17 17 / 0.55);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  /* The size chosen now */
  .sgs-sg__print.is-current {
    fill: rgb(17 17 17 / 0.18);
    stroke: var(--sgs-text, #111111);
    stroke-width: 2px;
  }

  .sgs-sg__num {
    font-family: var(--sgs-font-mono, monospace);
    font-size: 11px;
    fill: var(--sgs-text, #111111);
  }

  .sgs-sg__cap {
    margin-top: 8px;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-sg__list {
    display: grid;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-sg__item {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: center;
    gap: 2px 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-sg__item > :is(.sgs-sg__item-size, .sgs-sg__item-use) {
    grid-column: 2;
  }

  .sgs-sg__item.is-current .sgs-sg__item-num,
  .sgs-sg__item.is-current .sgs-sg__item-size {
    color: var(--sgs-text, #111111);
    font-weight: 600;
  }

  /* Choose: picks the size and goes back to the options; shows Selected on the chosen one */
  .sgs-sg__choose {
    grid-column: 3;
    grid-row: 1 / span 2;
    min-width: 88px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgb(17 17 17 / 0.22);
    border-radius: var(--sgs-radius-btn, 4px);
    background: var(--sgs-raised, #ffffff);
    color: var(--sgs-text, #111111);
    font-family: var(--sgs-font-body, Inter, sans-serif);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }

  .sgs-sg__choose:hover {
    border-color: var(--sgs-text, #111111);
  }

  .sgs-sg__choose:focus-visible,
  .sgs-sg__back:focus-visible {
    outline: 2px solid var(--sgs-text, #111111);
    outline-offset: 2px;
  }

  .sgs-sg__chosen-text {
    display: none;
  }

  .sgs-sg__item.is-current .sgs-sg__choose {
    border-color: #111111;
    background: #111111;
    color: #ffffff;
  }

  .sgs-sg__item.is-current .sgs-sg__choose-text {
    display: none;
  }

  .sgs-sg__item.is-current .sgs-sg__chosen-text {
    display: inline;
  }

  .sgs-sg__back {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    margin-top: 24px;
    border: 0;
    border-radius: var(--sgs-radius-btn, 4px);
    background: #111111;
    color: #ffffff;
    font-family: var(--sgs-font-body, Inter, sans-serif);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }

  .sgs-sg__item-num {
    grid-row: span 2;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 14px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-sg__item-size {
    font-family: var(--sgs-font-mono, monospace);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .sgs-sg__item-use {
    font-size: 14px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-sg__note {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-sg__wall-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    margin-top: 24px;
    border: 1px solid var(--sgs-text, #111111);
    border-radius: 0;
    background: transparent;
    color: var(--sgs-text, #111111);
    font-family: var(--sgs-font-mono, monospace);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-transform: none;
    cursor: pointer;
  }

  .sgs-sg__wall-btn[hidden] {
    display: none;
  }

  .sgs-sg__wall-btn:hover {
    background: var(--sgs-text, #111111);
    color: var(--sgs-bg, #f5f3ef);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size guide",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "A link under the sizes that opens the product's sizes drawn to scale above a sofa and a desk. Sizes are read from the Size option, e.g. 16x24 (Vertical)."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Which size?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Drawer heading",
      "default": "Which size?"
    },
    {
      "type": "text",
      "id": "sofa_label",
      "label": "Sofa drawing caption",
      "default": "Above a sofa"
    },
    {
      "type": "text",
      "id": "desk_label",
