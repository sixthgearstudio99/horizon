{%- liquid
  assign s = section.settings
  assign limit = s.products_to_show
  assign card_sizes = '(min-width: 990px) 23vw, (min-width: 750px) 46vw, 78vw'

  # Products kept out of these suggestions (the Custom Car Poster), unless the print being
  # viewed belongs to one of their own collections
  assign hidden_handles = ',' | append: s.hidden_products | remove: ' ' | append: ','
  assign custom_collections = ',' | append: s.hidden_products_collections | remove: ' ' | append: ','
-%}

{%- capture header -%}
  {%- if s.eyebrow != blank or s.heading != blank -%}
    <header class="sgs-grid__header" data-sgs-reveal>
      <div class="sgs-grid__titles">
        {%- if s.eyebrow != blank -%}
          <p class="sgs-grid__eyebrow sgs-label">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sgs-grid__heading">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      <a class="sgs-link sgs-grid__view-all" href="{{ routes.all_products_collection_url }}">
        {{- s.view_all_label | escape -}}
        <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14">
          <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </header>
  {%- endif -%}
{%- endcapture -%}

{% render 'sgs-grid-styles' %}

<section
  class="sgs-grid sgs-grid--light sgs-grid--mobile-carousel sgs-recs"
  style="
    --sgs-grid-bg: transparent;
    --sgs-grid-columns: 4;
    --sgs-grid-pad-top: {{ s['padding-block-start'] }}px;
    --sgs-grid-pad-bottom: {{ s['padding-block-end'] }}px;
  "
>
  <div class="sgs-grid__inner">
    {%- if recommendations.performed? -%}
      {%- comment -%} Shopify's related prints, fetched by sgs-recommendations.js to fill any spare slots {%- endcomment -%}
      <ul class="sgs-grid__list" role="list" data-sgs-recs-list>
        {%- for rec in recommendations.products -%}
          {%- assign rec_key = ',' | append: rec.handle | append: ',' -%}
          {%- unless hidden_handles contains rec_key -%}
            <li class="sgs-grid__item is-revealed" data-sgs-reveal data-handle="{{ rec.handle }}">
              {% render 'sgs-product-card',
                product: rec,
                show_secondary: true,
                show_options: true,
                sizes: card_sizes
              %}
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- elsif product != blank -%}
      {%- liquid
        # 1) The print's own collection: the first preferred style collection it belongs to,
        #    else its first specific collection (not all / home page / best sellers)
        assign source = nil
        assign preferred = s.preferred_collections | split: ','
        for wanted in preferred
          assign wanted_handle = wanted | strip
          for c in product.collections
            if c.handle == wanted_handle and c.products_count > 1
              assign source = c
              break
            endif
          endfor
          if source
            break
          endif
        endfor
        unless source
          for c in product.collections
            assign generic = false
            if c.handle == 'all' or c.handle == 'frontpage' or c.handle contains 'best-seller' or c.handle contains 'bestseller'
              assign generic = true
            endif
            if generic == false and c.products_count > 1
              assign source = c
              break
            endif
          endfor
        endunless

        assign allow_hidden = false
        if source
          assign source_key = ',' | append: source.handle | append: ','
          if custom_collections contains source_key
            assign allow_hidden = true
          endif
        endif

        assign shown = 0
        assign shown_handles = ',' | append: product.handle | append: ','
      -%}
      <sgs-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=related"
        data-limit="{{ limit }}"
      >
        {{ header }}
        <ul class="sgs-grid__list" role="list" data-sgs-recs-list data-sgs-reveal-group>
          {%- if source -%}
            {%- for rec in source.products limit: 30 -%}
              {%- if shown >= limit -%}{%- break -%}{%- endif -%}
              {%- assign rec_key = ',' | append: rec.handle | append: ',' -%}
              {%- if shown_handles contains rec_key -%}{%- continue -%}{%- endif -%}
              {%- if hidden_handles contains rec_key and allow_hidden == false -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- assign shown_handles = shown_handles | append: rec.handle | append: ',' -%}
              <li class="sgs-grid__item" data-sgs-reveal data-handle="{{ rec.handle }}" data-source="collection">
                {% render 'sgs-product-card', product: rec, show_secondary: true, show_options: true, sizes: card_sizes %}
              </li>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} 2) Placeholders from the whole shop; Shopify's related prints replace these when they load {%- endcomment -%}
          {%- for rec in collections.all.products limit: 30 -%}
            {%- if shown >= limit -%}{%- break -%}{%- endif -%}
            {%- assign rec_key = ',' | append: rec.handle | append: ',' -%}
            {%- if shown_handles contains rec_key or hidden_handles contains rec_key -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign shown_handles = shown_handles | append: rec.handle | append: ',' -%}
            <li class="sgs-grid__item" data-sgs-reveal data-handle="{{ rec.handle }}" data-source="fill">
              {% render 'sgs-product-card', product: rec, show_secondary: true, show_options: true, sizes: card_sizes %}
            </li>
          {%- endfor -%}
        </ul>
      </sgs-recommendations>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'sgs-recommendations.js' | asset_url }}" defer></script>

{% stylesheet %}
  .sgs-recs {
    border-top: 1px solid rgb(14 14 14 / 0.12);
  }

  .sgs-recs sgs-recommendations {
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear recommendations",
  "tag": "div",
  "class": "sgs-recs-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "You may also like"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the wall"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "default": "Shop all prints"
    },
    {
      "type": "text",
      "id": "preferred_collections",
      "label": "Preferred collections",
      "default": "lineage,portraits,grand-prix,mindset",
      "info": "Prints from the viewed print's own collection come first. Collection handles, in order of preference."
    },
    {
      "type": "text",
      "id": "hidden_products",
      "label": "Keep these products out",
      "default": "custom-car-poster-personalized-car-print-with-your-own-car-name-plate-cinematic-garage-wall-art-multiple-sizes, custom-car-poster-personalized-car-print-with-your-own-car",
      "info": "Product handles, separated by commas (the Custom Car Poster)."
    },
    {
      "type": "text",
      "id": "hidden_products_collections",
      "label": "Except on these collections",
      "default": "custom-car-posters, custom-posters, custom",
      "info": "Handles of the custom poster's own collection(s). On prints from these collections it can be suggested."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "SixthGear recommendations"
    }
  ]
}
{% endschema %}
