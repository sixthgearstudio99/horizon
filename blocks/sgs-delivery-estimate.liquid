{%- comment -%} Not shown on gift card products: nothing is printed or delivered {%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign uid = 'SgsDelivery-' | append: block.id

  # The Christmas message links its [bracketed] words to the gift card, but only if that product exists
  assign gift_card = nil
  if bs.gift_card_handle != blank
    assign gift_card_product = all_products[bs.gift_card_handle]
    if gift_card_product.id != blank
      assign gift_card = gift_card_product
    endif
  endif

  # Gift line under the estimate. Custom posters take longer to make, so they get their own line and date.
  assign gift_line = bs.christmas_line
  assign gift_line_until = bs.christmas_line_until | strip
  assign custom_handles = bs.custom_handles | strip_newlines | remove: ' ' | split: ','
  if custom_handles contains closest.product.handle
    if bs.custom_line != blank
      assign gift_line = bs.custom_line
    endif
    if bs.custom_line_until != blank
      assign gift_line_until = bs.custom_line_until | strip
    endif
  endif

  assign christmas_parts = bs.christmas_message | split: '['
  assign christmas_before = christmas_parts.first
  assign christmas_link_text = ''
  assign christmas_after = ''
  if christmas_parts.size > 1
    assign christmas_rest = christmas_parts[1] | split: ']'
    assign christmas_link_text = christmas_rest.first
    assign christmas_after = christmas_rest | slice: 1, 99 | join: ']'
  endif
-%}

{%- unless closest.product.gift_card? -%}
<div class="sgs-delivery" id="{{ uid }}" {{ block.shopify_attributes }}>
  <svg class="sgs-delivery__icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"><path d="M1.5 5.5h10v8h-10zM11.5 8.5h3.6l2.4 2.6v2.4h-6z"/><circle cx="5" cy="14.5" r="1.6" fill="var(--color-background, #f5f3ef)"/><circle cx="14.5" cy="14.5" r="1.6" fill="var(--color-background, #f5f3ef)"/></svg>

  <div class="sgs-delivery__body">
  <p class="sgs-delivery__text" data-standard>
    {{ bs.text_before | escape }} <strong data-range></strong>
  </p>

  <p class="sgs-delivery__text" data-christmas hidden>
    {{- christmas_before | escape -}}
    {%- if christmas_link_text != blank -%}
      {%- if gift_card -%}
        <a href="{{ gift_card.url }}">{{ christmas_link_text | escape }}</a>
      {%- else -%}
        {{- christmas_link_text | escape -}}
      {%- endif -%}
    {%- endif -%}
    {{- christmas_after | escape -}}
  </p>
  {%- if gift_line != blank -%}
    <p class="sgs-delivery__xmas" id="{{ uid }}-xmas" hidden>{{ gift_line | escape }}</p>
  {%- endif -%}
  {%- if bs.footnote != blank -%}
    <p class="sgs-delivery__foot">{{ bs.footnote | escape }}</p>
  {%- endif -%}
  </div>
</div>

{%- comment -%}
  Inline so the dates are filled in before first paint (no layout shift). The range is worked out
  in the visitor's browser from their current date, counting Monday to Friday only.
{%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById({{ uid | json }});
    if (!root) return;
    var minDays = {{ bs.min_working_days | default: 4 }};
    var maxDays = {{ bs.max_working_days | default: 9 }};
    var start = {{ bs.christmas_from | default: '12-10' | json }};
    var end = {{ bs.christmas_to | default: '12-24' | json }};

    var addWorkingDays = function (from, days) {
      var d = new Date(from.getFullYear(), from.getMonth(), from.getDate());
      var added = 0;
      while (added < days) {
        d.setDate(d.getDate() + 1);
        var day = d.getDay();
        if (day !== 0 && day !== 6) added++;
      }
      return d;
    };
    var part = function (d, opts) { return d.toLocaleDateString('en-GB', opts); };
    var weekdayDay = function (d) { return part(d, { weekday: 'short' }) + ' ' + d.getDate(); };
    var month = function (d) { return part(d, { month: 'short' }); };

    var today = new Date();
    var mmdd = String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
    var ymd = today.getFullYear() + '-' + mmdd;

    // Christmas order-by line: shown up to and including its last day
    var xmas = document.getElementById({{ uid | append: '-xmas' | json }});
    var xmasUntil = {{ gift_line_until | json }};
    if (xmas && xmasUntil && ymd <= xmasUntil) xmas.hidden = false;

    if (mmdd >= start && mmdd <= end) {
      root.querySelector('[data-standard]').hidden = true;
      root.querySelector('[data-christmas]').hidden = false;
      return;
    }

    var first = addWorkingDays(today, minDays);
    var last = addWorkingDays(today, maxDays);
    var range = first.getMonth() === last.getMonth()
      ? weekdayDay(first) + ' – ' + weekdayDay(last) + ' ' + month(last)
      : weekdayDay(first) + ' ' + month(first) + ' – ' + weekdayDay(last) + ' ' + month(last);
    root.querySelector('[data-range]').textContent = range;
  })();
</script>
{%- endunless -%}

{% stylesheet %}
  .sgs-delivery {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    /* Sit close to the Add to cart button rather than a full block gap below it */
    margin-block-start: -12px;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .sgs-delivery__icon {
    flex-shrink: 0;
    margin-top: 1px;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .sgs-delivery__text {
    margin: 0;
    min-height: 1.5em;
    font-size: 14px;
    line-height: 1.5;
  }

  .sgs-delivery__text[hidden],
  .sgs-delivery__xmas[hidden] {
    display: none;
  }

  .sgs-delivery__body {
    min-width: 0;
  }

  .sgs-delivery__xmas {
    margin: 6px 0 0;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--sgs-text, #f2f0eb);
  }

  .sgs-delivery__foot {
    margin: 6px 0 0;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sgs-text-2, #9a968e);
  }

  .sgs-delivery__text strong {
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb));
    font-variant-numeric: tabular-nums;
  }

  .sgs-delivery__text a {
    color: rgb(var(--color-foreground-rgb));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Delivery estimate",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the delivery window from the visitor's own date, counting Monday to Friday only."
    },
    {
      "type": "text",
      "id": "text_before",
      "label": "Text before the dates",
      "default": "Order today, arrives"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Small line under the estimate",
      "default": "Print only – frame not included",
      "info": "Leave empty to hide."
    },
    {
      "type": "range",
      "id": "min_working_days",
      "label": "Earliest arrival (working days)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 4,
      "info": "Counted from today, Monday to Friday only"
    },
    {
      "type": "range",
      "id": "max_working_days",
      "label": "Latest arrival (working days)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 9,
      "info": "Counted from today, Monday to Friday only"
    },
    {
      "type": "header",
      "content": "Christmas gift line"
    },
    {
      "type": "text",
      "id": "christmas_line",
      "label": "Gift line",
      "default": "🎁 Gift it · Order by Wed 9 Dec for Christmas",
      "info": "Small line under the delivery estimate. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "christmas_line_until",
      "label": "Show gift line until (YYYY-MM-DD)",
      "default": "2026-12-09"
    },
    {
      "type": "textarea",
      "id": "custom_handles",
      "label": "Custom poster products",
      "default": "custom-car-poster-personalized-car-print-with-your-own-car-name-plate-cinematic-garage-wall-art-multiple-sizes, custom-car-poster-personalized-car-print-with-your-own-car",
      "info": "Product handles, separated by commas. These show the custom poster gift line instead."
    },
    {
      "type": "text",
      "id": "custom_line",
      "label": "Custom poster gift line",
      "default": "🎁 Gift it · Order by Wed 2 Dec for Christmas"
    },
    {
      "type": "text",
      "id": "custom_line_until",
      "label": "Show custom poster line until (YYYY-MM-DD)",
      "default": "2026-12-02"
    },
    {
      "type": "header",
      "content": "After the Christmas cut-off"
    },
    {
      "type": "text",
      "id": "christmas_from",
      "label": "Show from (MM-DD)",
      "default": "12-10"
    },
    {
      "type": "text",
      "id": "christmas_to",
      "label": "Show until (MM-DD)",
      "default": "12-24"
    },
    {
      "type": "text",
      "id": "christmas_message",
      "label": "Message",
      "default": "Too late for Christmas delivery – send a [digital gift card] instead",
      "info": "Words in [brackets] link to the gift card product, if it exists."
    },
    {
      "type": "text",
      "id": "gift_card_handle",
      "label": "Gift card product handle",
      "default": "gift-card"
    }
  ],
  "presets": [
    {
      "name": "Delivery estimate"
    }
  ]
}
{% endschema %}
