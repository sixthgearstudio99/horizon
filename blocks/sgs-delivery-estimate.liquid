{%- comment -%} Not shown on gift card products: nothing is printed or delivered {%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign uid = 'SgsDelivery-' | append: block.id

  # The Christmas message links its [bracketed] words to the gift card, but only if that product exists
  assign gift_card = nil
  if bs.gift_card_handle != blank
    assign gift_card_product = all_products[bs.gift_card_handle]
    if gift_card_product.id != blank
      assign gift_card = gift_card_product
    endif
  endif

  # Gift line under the estimate. Custom posters take longer to make, so they get their own line and date.
  assign gift_line = bs.christmas_line
  assign gift_line_until = bs.christmas_line_until | strip
  assign custom_handles = bs.custom_handles | strip_newlines | remove: ' ' | split: ','
  if custom_handles contains closest.product.handle
    if bs.custom_line != blank
      assign gift_line = bs.custom_line
    endif
    if bs.custom_line_until != blank
      assign gift_line_until = bs.custom_line_until | strip
    endif
  endif

  assign christmas_parts = bs.christmas_message | split: '['
  assign christmas_before = christmas_parts.first
  assign christmas_link_text = ''
  assign christmas_after = ''
  if christmas_parts.size > 1
    assign christmas_rest = christmas_parts[1] | split: ']'
    assign christmas_link_text = christmas_rest.first
    assign christmas_after = christmas_rest | slice: 1, 99 | join: ']'
  endif

  # Delivery window, worked out here so the dates are always in the page: earliest = shortest
  # production + shortest delivery, latest = longest of each, counted in working days after today
  # (weekends and the bank holidays listed in the settings don't count). The browser repeats the
  # sum from the visitor's own UK date, in case this page was cached on an earlier day.
  assign min_days = bs.production_min | plus: bs.delivery_min
  assign max_days = bs.production_max | plus: bs.delivery_max
  if max_days < min_days
    assign max_days = min_days
  endif
  assign holidays = bs.bank_holidays | newline_to_br | replace: '<br />', ',' | strip_newlines | remove: ' ' | split: ','
  assign today_ymd = 'now' | date: '%Y-%m-%d'
  # Count from midday, so adding whole days never trips over a clock change
  assign day_s = today_ymd | append: ' 12:00' | date: '%s' | plus: 0
  assign counted = 0
  assign found_first = false
  assign first_s = day_s
  assign last_s = day_s
  for i in (1..90)
    assign day_s = day_s | plus: 86400
    assign weekday = day_s | date: '%u' | plus: 0
    assign day_ymd = day_s | date: '%Y-%m-%d'
    if weekday < 6
      unless holidays contains day_ymd
        assign counted = counted | plus: 1
      endunless
    endif
    if counted >= min_days and found_first == false
      assign first_s = day_s
      assign found_first = true
    endif
    if counted >= max_days
      assign last_s = day_s
      break
    endif
  endfor
  assign first_month = first_s | date: '%b'
  assign last_month = last_s | date: '%b'
  assign last_text = last_s | date: '%a %-d %b'
  if first_month == last_month
    assign first_text = first_s | date: '%a %-d'
  else
    assign first_text = first_s | date: '%a %-d %b'
  endif
  assign range_text = first_text | append: ' – ' | append: last_text
  if min_days == max_days
    assign range_text = last_text
  endif

  # Christmas: after the last delivery date the estimate gives way to the gift card message
  assign today_mmdd = 'now' | date: '%m-%d'
  assign christmas_from = bs.christmas_from | default: '12-10'
  assign christmas_to = bs.christmas_to | default: '12-24'
  assign in_christmas = false
  if today_mmdd >= christmas_from and today_mmdd <= christmas_to
    assign in_christmas = true
  endif
  assign show_gift_line = false
  if gift_line_until != blank and today_ymd <= gift_line_until
    assign show_gift_line = true
  endif

  # "Line" layout: one short line under the price, e.g. "Free UK delivery · Arrives by Fri 20 Nov ·
  # 14-day returns". Custom posters are made to order and can't be returned, so they get their own text.
  assign is_line = false
  if bs.layout == 'line'
    assign is_line = true
    assign line_text = bs.line_text
    if custom_handles contains closest.product.handle and bs.line_text_custom != blank
      assign line_text = bs.line_text_custom
    endif
    assign line_parts = line_text | escape | split: '[date]'
  endif
-%}

{%- unless closest.product.gift_card? -%}
{%- if is_line -%}
<p class="sgs-delivery-line" id="{{ uid }}" {{ block.shopify_attributes }}>
  {%- for part in line_parts -%}
    {{- part -}}
    {%- unless forloop.last -%}<span class="sgs-delivery-line__date" data-last>{{ last_text }}</span>{%- endunless -%}
  {%- endfor -%}
  {%- if line_parts.size == 1 and line_text contains '[date]' -%}<span class="sgs-delivery-line__date" data-last>{{ last_text }}</span>{%- endif -%}
</p>
{%- else -%}
<div class="sgs-delivery" id="{{ uid }}" {{ block.shopify_attributes }}>
  <svg class="sgs-delivery__icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"><path d="M1.5 5.5h10v8h-10zM11.5 8.5h3.6l2.4 2.6v2.4h-6z"/><circle cx="5" cy="14.5" r="1.6" fill="var(--color-background, #f5f3ef)"/><circle cx="14.5" cy="14.5" r="1.6" fill="var(--color-background, #f5f3ef)"/></svg>

  <div class="sgs-delivery__body">
  <p class="sgs-delivery__text" data-standard{% if in_christmas %} hidden{% endif %}>
    {{ bs.text_before | escape }} <strong data-range>{{ range_text }}</strong>
  </p>

  <p class="sgs-delivery__text" data-christmas{% unless in_christmas %} hidden{% endunless %}>
    {{- christmas_before | escape -}}
    {%- if christmas_link_text != blank -%}
      {%- if gift_card -%}
        <a href="{{ gift_card.url }}">{{ christmas_link_text | escape }}</a>
      {%- else -%}
        {{- christmas_link_text | escape -}}
      {%- endif -%}
    {%- endif -%}
    {{- christmas_after | escape -}}
  </p>
  {%- if gift_line != blank -%}
    <p class="sgs-delivery__xmas" id="{{ uid }}-xmas"{% unless show_gift_line %} hidden{% endunless %}>{{ gift_line | escape }}</p>
  {%- endif -%}
  {%- if bs.footnote != blank -%}
    <p class="sgs-delivery__foot">{{ bs.footnote | escape }}</p>
  {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- comment -%}
  Inline so the dates are filled in before first paint (no layout shift). The range is worked out
  in the visitor's browser from their current date, counting Monday to Friday only.
{%- endcomment -%}
<script>
  (function () {
    // Repeats the Liquid sum from the visitor's UK date, in case the page was cached on an
    // earlier day. If anything here fails, the dates already in the page stay as they are.
    var root = document.getElementById({{ uid | json }});
    if (!root) return;
    try {
      var minDays = {{ min_days }};
      var maxDays = {{ max_days }};
      var holidays = {{ holidays | json }};
      var start = {{ christmas_from | json }};
      var end = {{ christmas_to | json }};

      var parts = {};
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit' })
        .formatToParts(new Date()).forEach(function (p) { parts[p.type] = p.value; });
      var ymd = parts.year + '-' + parts.month + '-' + parts.day;
      var mmdd = parts.month + '-' + parts.day;
      // Midday UTC on the UK date: whole-day steps from here never change the calendar date
      var today = new Date(Date.UTC(+parts.year, +parts.month - 1, +parts.day, 12));
      var iso = function (d) { return d.toISOString().slice(0, 10); };

      var addWorkingDays = function (days) {
        var d = new Date(today.getTime());
        var added = 0;
        while (added < days) {
          d.setUTCDate(d.getUTCDate() + 1);
          var dow = d.getUTCDay();
          if (dow !== 0 && dow !== 6 && holidays.indexOf(iso(d)) === -1) added++;
        }
        return d;
      };
      var fmt = function (d, opts) { return d.toLocaleDateString('en-GB', Object.assign({ timeZone: 'UTC' }, opts)); };
      var dayText = function (d) { return fmt(d, { weekday: 'short' }) + ' ' + d.getUTCDate(); };
      var monthText = function (d) { return fmt(d, { month: 'short' }); };

      // Gift line: shown up to and including its last day
      var xmas = document.getElementById({{ uid | append: '-xmas' | json }});
      var xmasUntil = {{ gift_line_until | json }};
      if (xmas) xmas.hidden = !(xmasUntil && ymd <= xmasUntil);

      var first = addWorkingDays(minDays);
      var last = addWorkingDays(maxDays);
      var lastText = dayText(last) + ' ' + monthText(last);
      // Line layout: just the latest date
      root.querySelectorAll('[data-last]').forEach(function (el) { el.textContent = lastText; });

      var standard = root.querySelector('[data-standard]');
      var christmasText = root.querySelector('[data-christmas]');
      if (!standard || !christmasText) return;
      var christmas = mmdd >= start && mmdd <= end;
      standard.hidden = christmas;
      christmasText.hidden = !christmas;
      if (christmas) return;

      var range = minDays === maxDays
        ? lastText
        : (first.getUTCMonth() === last.getUTCMonth() ? dayText(first) : dayText(first) + ' ' + monthText(first)) + ' – ' + lastText;
      root.querySelector('[data-range]').textContent = range;
    } catch (e) {
      // keep the server-rendered dates
    }
  })();
</script>
{%- endunless -%}

{% stylesheet %}
  .sgs-delivery {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    /* Sit close to the Add to cart button rather than a full block gap below it */
    margin-block-start: -12px;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .sgs-delivery__icon {
    flex-shrink: 0;
    margin-top: 1px;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .sgs-delivery__text {
    margin: 0;
    min-height: 1.5em;
    font-size: 14px;
    line-height: 1.5;
  }

  .sgs-delivery__text[hidden],
  .sgs-delivery__xmas[hidden] {
    display: none;
  }

  .sgs-delivery__body {
    min-width: 0;
  }

  .sgs-delivery__xmas {
    margin: 6px 0 0;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: none;
    text-wrap: balance;
    color: var(--sgs-text, #111111);
  }

  .sgs-delivery__foot {
    margin: 6px 0 0;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-delivery__text strong {
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb));
    font-variant-numeric: tabular-nums;
  }

  .sgs-delivery__text a {
    color: rgb(var(--color-foreground-rgb));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Line layout: one small line tucked under the price */
  .sgs-delivery-line {
    width: 100%;
    margin: -14px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-delivery-line__date {
    font-weight: 500;
    color: var(--sgs-text, #111111);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Delivery estimate",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the delivery window from the visitor's own date, counting Monday to Friday only."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "Estimate with icon" },
        { "value": "line", "label": "One line (under the price)" }
      ],
      "default": "full"
    },
    {
      "type": "text",
      "id": "line_text",
      "label": "One-line text",
      "default": "Free UK delivery · Arrives by [date] · 14-day returns",
      "info": "One-line layout only. [date] becomes the latest delivery date.",
      "visible_if": "{{ block.settings.layout == 'line' }}"
    },
    {
      "type": "text",
      "id": "line_text_custom",
      "label": "One-line text on custom posters",
      "default": "Free UK delivery · Arrives by [date]",
      "info": "For the custom poster handles below, which can't be returned.",
      "visible_if": "{{ block.settings.layout == 'line' }}"
    },
    {
      "type": "text",
      "id": "text_before",
      "label": "Text before the dates",
      "default": "Order today · arrives"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Small line under the estimate",
      "default": "Print only – frame not included",
      "info": "Leave empty to hide."
    },
    {
      "type": "textarea",
      "id": "bank_holidays",
      "label": "Bank holidays (no production or delivery)",
      "default": "2026-12-25, 2026-12-28, 2027-01-01, 2027-03-26, 2027-03-29, 2027-05-03, 2027-05-31, 2027-08-30, 2027-12-27, 2027-12-28",
      "info": "England and Wales, as YYYY-MM-DD separated by commas. Weekends are always skipped."
    },
    {
      "type": "range",
      "id": "production_min",
      "label": "Production: fewest working days",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "production_max",
      "label": "Production: most working days",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "delivery_min",
      "label": "Delivery: fewest working days",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "delivery_max",
      "label": "Delivery: most working days",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 4,
      "info": "Arrival dates are counted from today, Monday to Friday only."
    },
    {
      "type": "header",
      "content": "Christmas gift line"
    },
    {
      "type": "text",
      "id": "christmas_line",
      "label": "Gift line",
      "default": "🎁 Gift it · Order by Wed 9 Dec for Christmas",
      "info": "Small line under the delivery estimate. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "christmas_line_until",
      "label": "Show gift line until (YYYY-MM-DD)",
      "default": "2026-12-09"
    },
    {
      "type": "textarea",
      "id": "custom_handles",
      "label": "Custom poster products",
      "default": "custom-car-poster-personalized-car-print-with-your-own-car-name-plate-cinematic-garage-wall-art-multiple-sizes, custom-car-poster-personalized-car-print-with-your-own-car",
      "info": "Product handles, separated by commas. These show the custom poster gift line instead."
    },
    {
      "type": "text",
      "id": "custom_line",
      "label": "Custom poster gift line",
      "default": "🎁 Gift it · Order by Wed 2 Dec for Christmas"
    },
    {
      "type": "text",
      "id": "custom_line_until",
      "label": "Show custom poster line until (YYYY-MM-DD)",
      "default": "2026-12-02"
    },
    {
      "type": "header",
      "content": "After the Christmas cut-off"
    },
    {
      "type": "text",
      "id": "christmas_from",
      "label": "Show from (MM-DD)",
      "default": "12-10"
    },
    {
      "type": "text",
      "id": "christmas_to",
      "label": "Show until (MM-DD)",
      "default": "12-24"
    },
    {
      "type": "text",
      "id": "christmas_message",
      "label": "Message",
      "default": "Too late for Christmas delivery – send a [digital gift card] instead",
      "info": "Words in [brackets] link to the gift card product, if it exists."
    },
    {
      "type": "text",
      "id": "gift_card_handle",
      "label": "Gift card product handle",
      "default": "gift-card"
    }
  ],
  "presets": [
    {
      "name": "Delivery estimate"
    }
  ]
}
{% endschema %}
