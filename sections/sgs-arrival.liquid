{%- liquid
  assign s = section.settings
  assign item_count = 0
  for i in (1..6)
    assign key = 'item_' | append: i
    if s[key] != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- if item_count > 0 or s.image != blank -%}
  <section
    class="sgs-arrive{% if s.image != blank %} sgs-arrive--image{% endif %}"
    style="--sgs-arrive-pad-top: {{ s['padding-block-start'] }}px; --sgs-arrive-pad-bottom: {{ s['padding-block-end'] }}px;"
    {% if s.heading != blank %}aria-labelledby="SgsArrive-{{ section.id }}"{% endif %}
  >
    <div class="sgs-arrive__inner">
      {%- if s.image != blank -%}
        <div class="sgs-arrive__media">
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              widths: '450, 700, 1000, 1400',
              sizes: '(min-width: 990px) 45vw, 100vw',
              loading: 'lazy',
              class: 'sgs-arrive__img',
              alt: s.image.alt | default: s.heading
          }}
        </div>
      {%- endif -%}
      <div class="sgs-arrive__body">
        {%- if s.label != blank -%}
          <p class="sgs-arrive__label sgs-label">{{ s.label | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sgs-arrive__heading" id="SgsArrive-{{ section.id }}">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if item_count > 0 -%}
          <ul class="sgs-arrive__list" role="list">
            {%- for i in (1..6) -%}
              {%- assign key = 'item_' | append: i -%}
              {%- if s[key] != blank -%}
                <li class="sgs-arrive__item">
                  <svg class="sgs-arrive__tick" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{{ s[key] | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .sgs-arrive {
    padding-block: var(--sgs-arrive-pad-top) var(--sgs-arrive-pad-bottom);
    color: var(--sgs-text, #f2f0eb);
  }

  @media screen and (max-width: 749px) {
    .sgs-arrive {
      padding-block: calc(var(--sgs-arrive-pad-top) * 0.6) calc(var(--sgs-arrive-pad-bottom) * 0.6);
    }
  }

  .sgs-arrive__inner {
    display: grid;
    gap: 28px;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  @media screen and (min-width: 990px) {
    .sgs-arrive--image .sgs-arrive__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 64px;
    }
  }

  .sgs-arrive__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sgs-raised, #141414);
  }

  .sgs-arrive__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sgs-arrive__label {
    margin: 0 0 12px;
    color: var(--sgs-text-2, #9a968e);
  }

  .sgs-arrive .sgs-arrive__heading {
    margin: 0 0 20px;
    font-size: var(--sgs-h2) !important;
    line-height: 1.08 !important;
  }

  .sgs-arrive__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sgs-line, rgb(255 255 255 / 0.12));
  }

  .sgs-arrive__item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 52px;
    border-bottom: 1px solid var(--sgs-line, rgb(255 255 255 / 0.12));
    font-size: 15px;
  }

  .sgs-arrive__tick {
    flex-shrink: 0;
    color: var(--sgs-text-2, #9a968e);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "How it arrives",
  "tag": "div",
  "class": "sgs-arrive-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "For example a print in its tube."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "How it arrives"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Packed to arrive perfect"
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Checklist item 1",
      "default": "Printed to order in the UK"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Checklist item 2",
      "default": "Rolled in a protective tube"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Checklist item 3",
      "default": "Dispatched in 2–5 working days"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Checklist item 4",
      "default": "Free UK delivery"
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Checklist item 5"
    },
    {
      "type": "text",
      "id": "item_6",
      "label": "Checklist item 6"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "How it arrives"
    }
  ]
}
{% endschema %}
