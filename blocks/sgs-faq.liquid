{%- liquid
  assign bs = block.settings
  assign has_items = false
  for i in (1..6)
    assign q_key = 'question_' | append: i
    assign a_key = 'answer_' | append: i
    if bs[q_key] != blank and bs[a_key] != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- comment -%} Print questions don't apply to gift cards {%- endcomment -%}
{%- if has_items and closest.product.gift_card? != true -%}
  <div class="sgs-faq" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-faq__heading sgs-label">{{ bs.heading | escape }}</h2>
    {%- endif -%}

    {% render 'sgs-faq-list', settings: bs %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "An accordion of common questions, with matching FAQ structured data for search engines. Leave a question empty to hide it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "question_1",
      "label": "Question 1",
      "default": "How long does delivery take?"
    },
    {
      "type": "textarea",
      "id": "answer_1",
      "label": "Answer 1",
      "default": "Every print is made to order in the UK within 2 to 5 working days, then delivered in 2 to 4 working days. UK delivery is free."
    },
    {
      "type": "text",
      "id": "question_2",
      "label": "Question 2",
      "default": "Is it framed?"
    },
    {
      "type": "textarea",
      "id": "answer_2",
      "label": "Answer 2",
      "default": "Prints are supplied unframed and ready to frame in standard sizes (16x24 and 24x36 inches)."
    },
    {
      "type": "text",
      "id": "question_3",
      "label": "Question 3",
      "default": "What paper is it printed on?"
    },
    {
      "type": "textarea",
      "id": "answer_3",
      "label": "Answer 3",
      "default": "Premium semi-gloss paper with rich colour and deep blacks."
    },
    {
      "type": "text",
      "id": "question_4",
      "label": "Question 4",
      "default": "Can I return it?"
    },
    {
      "type": "textarea",
      "id": "answer_4",
      "label": "Answer 4",
      "default": "Yes, you can return standard prints within 14 days of delivery. Faulty or damaged prints are replaced free. Custom posters can't be returned unless faulty."
    },
    {
      "type": "text",
      "id": "question_5",
      "label": "Question 5"
    },
    {
      "type": "textarea",
      "id": "answer_5",
      "label": "Answer 5"
    },
    {
      "type": "text",
      "id": "question_6",
      "label": "Question 6"
    },
    {
      "type": "textarea",
      "id": "answer_6",
      "label": "Answer 6"
    }
  ],
  "presets": [
    {
      "name": "Product FAQ"
    }
  ]
}
{% endschema %}
