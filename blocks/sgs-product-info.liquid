{%- liquid
  assign bs = block.settings
  assign product_resource = closest.product

  # Per-product metafields (namespace "custom") still override the shared text
  assign delivery_text = product_resource.metafields.custom.shipping.value | default: bs.delivery_text
  assign framing_text = product_resource.metafields.custom.framing.value | default: bs.framing_text
  # Framed and unframed texts both, for products that offer a frame as an option: the one that
  # matches the chosen variant shows, and the script below swaps them when the choice changes
  assign framing_text_framed = product_resource.metafields.custom.framing.value | default: bs.framing_text_framed
  assign delivery_text_framed = product_resource.metafields.custom.shipping.value | default: bs.delivery_text_framed | default: delivery_text
  assign has_frame_option = false
  for v in product_resource.variants
    capture v_framed
      render 'sgs-variant-framed', variant: v
    endcapture
    if v_framed contains 'true'
      assign has_frame_option = true
      break
    endif
  endfor
  capture chosen_framed
    render 'sgs-variant-framed', variant: product_resource.selected_or_first_available_variant
  endcapture
  assign materials_text = product_resource.metafields.custom.materials.value | default: bs.materials_text

  # Paper by variant: fine art paper on some sizes (Paper: Fine Art), semi-gloss on the rest
  assign has_fine = false
  assign has_semi = false
  assign fine_first = true
  assign seen_semi = false
  for v in product_resource.variants
    capture v_paper
      render 'sgs-variant-paper', variant: v
    endcapture
    if v_paper contains 'fine'
      assign has_fine = true
      if seen_semi
        assign fine_first = false
      endif
    else
      assign has_semi = true
      assign seen_semi = true
    endif
  endfor
  capture current_paper
    render 'sgs-variant-paper', variant: product_resource.selected_or_first_available_variant
  endcapture
  assign current_paper = current_paper | strip
  assign materials_lower = materials_text | downcase | replace: '-', ' '
  assign materials_by_paper = false
  if has_fine and bs.materials_text_fine != blank and product_resource.metafields.custom.materials == blank
    if materials_lower contains 'semi gloss' or materials_lower contains 'semigloss'
      assign materials_by_paper = true
    endif
  endif
  capture sgs_framed
    render 'sgs-is-framed', product_resource: product_resource
  endcapture
  assign sgs_framed = sgs_framed | strip
  if sgs_framed contains 'true'
    assign framing_text = product_resource.metafields.custom.framing.value | default: bs.framing_text_framed
    # A framed print isn't sent in a tube
    if bs.delivery_text_framed != blank
      assign delivery_text = product_resource.metafields.custom.shipping.value | default: bs.delivery_text_framed
    endif
  endif

  # Custom prints have their own framing text: panoramic sizes when unframed, laid out to the
  # frame when framed. These take the place of the shared text and any custom.framing metafield.
  capture sgs_custom
    render 'sgs-is-custom', product_resource: product_resource, handles: bs.custom_handles
  endcapture
  if sgs_custom contains 'true'
    if sgs_framed contains 'true'
      if bs.framing_text_custom_framed != blank
        assign framing_text = bs.framing_text_custom_framed
      endif
    elsif bs.framing_text_custom != blank
      assign framing_text = bs.framing_text_custom
      assign framing_text_framed = bs.framing_text_custom_framed | default: framing_text_framed
    endif
  endif

  # Product details: the full description (the short introduction sits near the price)
  assign details_html = ''
  if bs.show_details
    capture details_html
      render 'sgs-description-html', product_resource: product_resource
    endcapture
    assign details_html = details_html | strip

    # The short introduction near the price is the description's first proper paragraph (unless
    # the product has custom.short_description). When it was shown whole, it isn't repeated here.
    if bs.skip_intro_paragraph and product_resource.metafields.custom.short_description == blank
      assign paragraphs = details_html | split: '</p>'
      for para in paragraphs
        assign text = para | strip_html | strip | replace: '&nbsp;', ' '
        assign word_count = text | split: ' ' | size
        if word_count >= 8
          # Only a plain paragraph (no line breaks), which the introduction shows in full
          assign plain_para = true
          if para contains '<br'
            assign plain_para = false
          endif
          if word_count <= bs.intro_words and plain_para
            assign chunk = para | append: '</p>'
            assign details_html = details_html | remove_first: chunk | strip
          endif
          break
        endif
      endfor
    endif
  endif

  # "[sizes]" in the framing text becomes this product's sizes, e.g. "16×24, 24×36"
  capture sizes_text
    render 'sgs-product-sizes', product_resource: product_resource, fallback: '12×18, 16×24, 24×36'
  endcapture
  assign sizes_text = sizes_text | strip
  assign framing_text = framing_text | replace: '[sizes]', sizes_text
  assign framing_text_framed = framing_text_framed | replace: '[sizes]', sizes_text

  # The product's Size option, listed under Framing
  assign size_option = nil
  for option in product_resource.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign size_option = option
      break
    endif
  endfor

  assign has_faq = false
  for i in (1..4)
    assign q_key = 'question_' | append: i
    assign a_key = 'answer_' | append: i
    if bs[q_key] != blank and bs[a_key] != blank
      assign has_faq = true
      break
    endif
  endfor
-%}

{%- unless product_resource.gift_card? -%}
<div class="sgs-info" {{ block.shopify_attributes }}>
  {%- assign opened = false -%}
  {%- liquid
    assign paper_note = ''
    if has_fine and has_semi and details_html != blank and bs.paper_note != blank
      assign details_lower = details_html | strip_html | downcase
      if details_lower contains 'gloss' or details_lower contains 'paper'
        # The fine art sizes, by name, e.g. "20 × 10 in"
        assign fine_names = ''
        for v in product_resource.variants
          capture v_paper
            render 'sgs-variant-paper', variant: v
          endcapture
          if v_paper contains 'fine'
            for value in v.options
              assign value_lower = value | downcase
              unless value_lower contains 'fine'
                capture size_name
                  render 'sgs-size-label', value: value
                endcapture
                assign size_name = size_name | strip | split: ' / ' | first
                assign probe = '|' | append: size_name | append: '|'
                unless fine_names contains probe
                  assign fine_names = fine_names | append: '|' | append: size_name | append: '|'
                endunless
              endunless
            endfor
          endif
        endfor
        assign fine_list = fine_names | remove_first: '|' | split: '||' | join: ', ' | remove: '|'
        if fine_first
          assign rest = bs.paper_note_rest_larger
        else
          assign rest = bs.paper_note_rest_other
        endif
        assign paper_note = bs.paper_note | replace: '[sizes]', fine_list | replace: '[rest]', rest
      endif
    endif
  -%}
  {%- if details_html != blank -%}
    <details class="sgs-info__item"{% if bs.open_first %} open{% endif %}>
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.details_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">
        {%- if paper_note != blank -%}<p class="sgs-info__paper-note">{{ paper_note | escape }}</p>{%- endif -%}
        {{ details_html }}
      </div>
    </details>
    {%- assign opened = true -%}
  {%- endif -%}

  {%- if materials_text != blank -%}
    <details class="sgs-info__item">
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.materials_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">
        {%- if materials_by_paper -%}
          {%- if has_semi -%}
            <div data-sgs-paper="semi"{% if current_paper == 'fine' %} hidden{% endif %}>{{ materials_text }}</div>
          {%- endif -%}
          <div data-sgs-paper="fine"{% if current_paper != 'fine' %} hidden{% endif %}>{{ bs.materials_text_fine }}</div>
        {%- else -%}
          {{ materials_text }}
        {%- endif -%}
      </div>
    </details>
  {%- endif -%}

  {%- if bs.show_sizes and size_option != nil -%}
    <details class="sgs-info__item">
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.sizes_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">
        {{ bs.sizes_text }}
        <ul class="sgs-info__sizes" role="list">
          {%- for value in size_option.values -%}
            <li>{% render 'sgs-size-label', value: value.name %}</li>
          {%- endfor -%}
        </ul>
      </div>
    </details>
  {%- endif -%}

  {%- if framing_text != blank or size_option != nil -%}
    <details class="sgs-info__item">
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.framing_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">
        {%- if has_frame_option and sgs_framed != 'true' -%}
          <div data-sgs-when="unframed"{% if chosen_framed contains 'true' %} hidden{% endif %}>{{ framing_text }}</div>
          <div data-sgs-when="framed"{% unless chosen_framed contains 'true' %} hidden{% endunless %}>{{ framing_text_framed }}</div>
        {%- else -%}
          {{ framing_text }}
        {%- endif -%}
        {%- if size_option != nil and bs.list_sizes and bs.show_sizes != true -%}
          <ul class="sgs-info__sizes" role="list">
            {%- for value in size_option.values -%}
              <li>{% render 'sgs-size-label', value: value.name %}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </details>
  {%- endif -%}

  {%- if delivery_text != blank -%}
    <details class="sgs-info__item"{% if bs.open_first and opened == false %} open{% endif %}>
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.delivery_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">
        {%- if has_frame_option and sgs_framed != 'true' and delivery_text_framed != delivery_text -%}
          <div data-sgs-when="unframed"{% if chosen_framed contains 'true' %} hidden{% endif %}>{{ delivery_text }}</div>
          <div data-sgs-when="framed"{% unless chosen_framed contains 'true' %} hidden{% endunless %}>{{ delivery_text_framed }}</div>
        {%- else -%}
          {{ delivery_text }}
        {%- endif -%}
      </div>
    </details>
  {%- endif -%}

  {%- if bs.guarantee_text != blank -%}
    <details class="sgs-info__item">
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.guarantee_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">{{ bs.guarantee_text }}</div>
    </details>
  {%- endif -%}

  {%- if bs.questions_text != blank or has_faq -%}
    <details class="sgs-info__item">
      <summary class="sgs-info__summary">
        <span class="sgs-label">{{ bs.questions_heading | escape }}</span>
        <span class="sgs-info__icon" aria-hidden="true"></span>
      </summary>
      <div class="sgs-info__body rte">
        {%- if has_faq -%}
          <dl class="sgs-info__faq">
            {%- for i in (1..4) -%}
              {%- assign q_key = 'question_' | append: i -%}
              {%- assign a_key = 'answer_' | append: i -%}
              {%- if bs[q_key] != blank and bs[a_key] != blank -%}
                <dt>{{ bs[q_key] | escape }}</dt>
                <dd>{{ bs[a_key] | escape | newline_to_br }}</dd>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}
        {{ bs.questions_text }}
      </div>
    </details>
  {%- endif -%}
</div>

{%- if has_faq -%}
  {%- comment -%} FAQ structured data for the questions shown above {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for i in (1..4) -%}
          {%- assign q_key = 'question_' | append: i -%}
          {%- assign a_key = 'answer_' | append: i -%}
          {%- if bs[q_key] != blank and bs[a_key] != blank -%}
            {%- unless first %},{% endunless -%}
            {"@type": "Question", "name": {{ bs[q_key] | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ bs[a_key] | json }}}}
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
{%- if has_frame_option and sgs_framed != 'true' -%}
  <script>
    (function () {
      // Framed or unframed text follows the frame option chosen in the variant picker
      var here = document.currentScript;
      var root = here.closest('.shopify-section') || document;
      if (root.dataset.sgsWhenBound) return;
      root.dataset.sgsWhenBound = '1';
      var sync = function () {
        var picked = Array.prototype.map.call(
          root.querySelectorAll('variant-picker input:checked, variant-picker select'),
          function (el) { return (el.value || '').toLowerCase(); }
        ).join(' ').replace(/unframed|no frame|without a? ?frame|frameless/g, '');
        var framed = /frame/.test(picked);
        root.querySelectorAll('[data-sgs-when]').forEach(function (el) {
          el.hidden = (el.getAttribute('data-sgs-when') === 'framed') !== framed;
        });
      };
      root.addEventListener('change', function (e) {
        if (e.target instanceof Element && e.target.closest('variant-picker')) sync();
      });
    })();
  </script>
{%- endif -%}
{%- if materials_by_paper and has_semi -%}{% render 'sgs-paper-sync' %}{%- endif -%}
{%- endunless -%}

{% stylesheet %}
  .sgs-info {
    width: 100%;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-info__item {
    border-bottom: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-info__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    color: var(--sgs-text, #111111);
  }

  .sgs-info__body :is([data-sgs-when], [data-sgs-paper])[hidden] {
    display: none;
  }

  .sgs-info__paper-note {
    font-weight: 500;
    color: var(--sgs-text, #111111);
  }

  .sgs-info__summary .sgs-label {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
    color: inherit;
  }

  .sgs-info__summary::-webkit-details-marker {
    display: none;
  }

  .sgs-info__summary:focus-visible {
    outline: 1px solid var(--sgs-text, #111111);
    outline-offset: 2px;
  }

  .sgs-info__icon {
    position: relative;
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .sgs-info__icon::before,
  .sgs-info__icon::after {
    content: '';
    position: absolute;
    inset: 5px 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sgs-info__icon::after {
    transform: rotate(90deg);
  }

  .sgs-info__item[open] .sgs-info__icon::after {
    transform: rotate(0deg);
  }

  .sgs-info__body {
    max-width: 65ch;
    padding-bottom: 24px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-info__body > :first-child {
    margin-top: 0;
  }

  .sgs-info__body > :last-child {
    margin-bottom: 0;
  }

  .sgs-info__body :is(p, ul) {
    margin: 0 0 0.9em;
  }

  .sgs-info__body :is(strong, b) {
    color: var(--sgs-text, #111111);
    font-weight: 400;
  }

  .sgs-info__body a {
    color: var(--sgs-text, #111111);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sgs-info__sizes {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--sgs-font-mono, monospace);
    font-size: 14px;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--sgs-text, #111111);
  }

  .sgs-info__sizes li {
    padding: 8px 0;
    border-top: 1px solid var(--sgs-line, #e4e0d9);
  }

  .sgs-info__faq {
    margin: 0 0 1em;
  }

  .sgs-info__faq dt {
    margin-top: 1em;
    color: var(--sgs-text, #111111);
  }

  .sgs-info__faq dt:first-child {
    margin-top: 0;
  }

  .sgs-info__faq dd {
    margin: 4px 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product info accordions",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Delivery and returns, framing and questions. A product's custom.shipping or custom.framing metafield replaces the shared text for that product."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first panel",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show the product description as the first panel",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "skip_intro_paragraph",
      "label": "Leave out the paragraph already shown as the short introduction",
      "default": true
    },
    {
      "type": "range",
      "id": "intro_words",
      "label": "Short introduction length (words)",
      "min": 12,
      "max": 60,
      "step": 2,
      "default": 30,
      "info": "Match the Short introduction block's Most words."
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Description heading",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "materials_heading",
      "label": "Materials heading",
      "default": "Print quality & materials"
    },
    {
      "type": "richtext",
      "id": "materials_text",
      "label": "Materials",
      "info": "A product's custom.materials metafield replaces this. Leave empty to hide the panel."
    },
    {
      "type": "richtext",
      "id": "materials_text_fine",
      "label": "Materials, on fine art variants",
      "default": "<p>Printed on fine art paper, made to order in the UK.</p>",
      "info": "Shown instead while a fine art variant (Paper: Fine Art) is chosen, when the text above mentions semi-gloss."
    },
    {
      "type": "text",
      "id": "paper_note",
      "label": "Paper line in Product details",
      "default": "[sizes] is printed on fine art paper; [rest] on semi-gloss paper.",
      "info": "On prints with both papers whose description mentions paper. [sizes] is the fine art sizes, [rest] one of the two phrases below. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "paper_note_rest_larger",
      "label": "Paper line: when the fine art sizes are the smallest",
      "default": "larger sizes"
    },
    {
      "type": "text",
      "id": "paper_note_rest_other",
      "label": "Paper line: otherwise",
      "default": "other sizes"
    },
    {
      "type": "checkbox",
      "id": "show_sizes",
      "label": "Show a sizes panel",
      "default": false,
      "info": "Lists the product's sizes in inches and centimetres."
    },
    {
      "type": "text",
      "id": "sizes_heading",
      "label": "Sizes heading",
      "default": "Sizes & dimensions"
    },
    {
      "type": "richtext",
      "id": "sizes_text",
      "label": "Text above the sizes"
    },
    {
      "type": "richtext",
      "id": "delivery_text_framed",
      "label": "Delivery, on framed prints",
      "info": "Used instead on products tagged framed. Leave empty to use the text below."
    },
    {
      "type": "text",
      "id": "delivery_heading",
      "label": "Delivery heading",
      "default": "Delivery & returns"
    },
    {
      "type": "richtext",
      "id": "delivery_text",
      "label": "Delivery and returns",
      "default": "<p>UK delivery only, and it's free. Every print is made to order in 2 to 5 working days, then delivered in 2 to 4 working days.</p><p>Standard prints can be returned within 14 days. Faulty or damaged prints replaced free. Custom posters are made for you and can't be returned unless faulty.</p><p>Damaged in transit? Send us a photo within 7 days of delivery and we'll replace it free.</p>"
    },
    {
      "type": "text",
      "id": "guarantee_heading",
      "label": "Guarantee heading",
      "default": "Satisfaction guarantee"
    },
    {
      "type": "richtext",
      "id": "guarantee_text",
      "label": "Guarantee",
      "default": "<p>If your print arrives damaged or misprinted, send us a photo within 7 days and we'll replace it free. Standard prints can be returned within 14 days. <a href=\"/policies/refund-policy\">Read our returns policy</a></p>"
    },
    {
      "type": "text",
      "id": "framing_heading",
      "label": "Framing heading",
      "default": "Framing"
    },
    {
      "type": "richtext",
      "id": "framing_text",
      "label": "Framing",
      "info": "[sizes] is replaced by the product's sizes, e.g. 16×24, 24×36.",
      "default": "<p>Supplied unframed, ready for standard frames in every size we sell ([sizes] in and their cm equivalents).</p>"
    },
    {
      "type": "richtext",
      "id": "framing_text_framed",
      "label": "Framing, on framed prints",
      "info": "Used instead on products tagged framed.",
      "default": "<p>Arrives framed in protective packaging, ready to hang. Black wooden frame, clear Perspex front.</p>"
    },
    {
      "type": "richtext",
      "id": "framing_text_custom",
      "label": "Framing, on custom posters",
      "info": "Used instead on custom posters (unframed). Leave empty to use the text above.",
      "default": "<p>Your custom print is supplied unframed in a 2:1 panoramic size (20 × 10, 22 × 11 or 30 × 15 in). Standard 12 × 18 in style frames won't fit — choose a frame made for your print's exact size, or choose Framed above.</p>"
    },
