{%- liquid
  assign s = section.settings

  # Image source: uploaded image > chosen product's image > first product in the store
  assign featured_product = s.product
  if featured_product == blank and s.image == blank
    assign featured_product = collections.all.products.first
  endif

  assign hero_image = s.image
  if hero_image == blank and featured_product != blank
    assign hero_image = featured_product.featured_image
  endif

  assign hero_alt = hero_image.alt | default: featured_product.title | default: shop.name | escape

  assign bg = s.background_color | default: '#0E0E0E'
  assign bg_brightness = bg | color_brightness
  if bg_brightness < 128
    assign tone = 'dark'
  else
    assign tone = 'light'
  endif

  case s.art_ratio
    when 'portrait'
      assign art_ratio = 0.8
    when 'a-series'
      assign art_ratio = 0.7071
    when 'square'
      assign art_ratio = 1
    else
      assign art_ratio = hero_image.aspect_ratio | default: 0.75
  endcase

  assign layout = s.layout

  # Background video: Shopify-hosted video (uploaded MP4) or a direct MP4 link.
  # Desktop prefers <=1080p, mobile <=720p. The image stays as poster/fallback.
  assign video_src = ''
  assign video_mobile_src = ''
  assign video_poster = hero_image
  if s.background == 'video'
    assign best_height = 0
    for source in s.video.sources
      if source.format == 'mp4' and source.height <= 1080 and source.height > best_height
        assign video_src = source.url
        assign best_height = source.height
      endif
    endfor
    if video_src == ''
      assign video_src = s.video_url | default: ''
    endif

    assign best_height = 0
    for source in s.video_mobile.sources
      if source.format == 'mp4' and source.height <= 720 and source.height > best_height
        assign video_mobile_src = source.url
        assign best_height = source.height
      endif
    endfor
    if video_mobile_src == ''
      assign video_mobile_src = s.video_mobile_url | default: ''
    endif

    if video_poster == blank and s.video != blank
      assign video_poster = s.video.preview_image
    endif
  endif

  assign has_video = false
  if video_src != '' or video_mobile_src != ''
    assign has_video = true
    assign layout = 'full'
  endif

  if layout == 'full' and video_poster == blank
    assign layout = 'split'
    assign has_video = false
  endif
-%}

<section
  class="sgs-hero sgs-hero--{{ layout }} sgs-hero--{{ tone }}{% if s.show_stripes %} sgs-hero--stripes{% endif %}"
  style="
    --sgs-hero-bg: {{ bg }};
    --sgs-hero-accent: {{ s.accent_color | default: '#E10600' }};
    --sgs-hero-min-height: {{ s.min_height }}svh;
    --sgs-hero-overlay: {{ s.overlay_opacity }}%;
    --sgs-hero-dim: {% if has_video %}{{ s.dim_opacity | divided_by: 100.0 }}{% else %}0{% endif %};
    --sgs-art-ratio: {{ art_ratio }};
    --sgs-hero-pad-top: {{ s['padding-block-start'] }}px;
    --sgs-hero-pad-bottom: {{ s['padding-block-end'] }}px;
  "
  aria-label="{{ s.eyebrow | default: shop.name | escape }}"
>
  {%- if layout == 'full' -%}
    <div class="sgs-hero__backdrop{% if has_video %} sgs-hero__backdrop--video{% endif %}" aria-hidden="true">
      {{
        video_poster
        | image_url: width: 3200
        | image_tag:
          widths: '750, 1100, 1500, 1920, 2400, 3200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'sgs-hero__backdrop-img',
          alt: ''
      }}
      {%- if has_video -%}
        <video
          class="sgs-hero__video"
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          tabindex="-1"
          data-sgs-hero-video
          data-src="{{ video_src }}"
          data-src-mobile="{{ video_mobile_src }}"
        ></video>
      {%- endif -%}
    </div>
    {%- if has_video -%}
      <script src="{{ 'sgs-hero-video.js' | asset_url }}" defer></script>
    {%- endif -%}
  {%- endif -%}

  <div class="sgs-hero__inner">
    <div class="sgs-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="sgs-hero__eyebrow sgs-label sgs-hero__rise" style="--i: 0;">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h1 class="sgs-hero__heading sgs-hero__rise" style="--i: 1;">{{ s.heading }}</h1>
      {%- endif -%}

      {%- if s.text != blank -%}
        <p class="sgs-hero__text sgs-hero__rise" style="--i: 2;">{{ s.text }}</p>
      {%- endif -%}

      {%- if s.button_1_label != blank or s.button_2_label != blank -%}
        <div class="sgs-hero__actions sgs-hero__rise" style="--i: 3;">
          {%- if s.button_1_label != blank -%}
            <a
              class="button sgs-hero__button"
              {% if s.button_1_link != blank %}
                href="{{ s.button_1_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- s.button_1_label | escape -}}
            </a>
          {%- endif -%}
          {%- if s.button_2_label != blank -%}
            <a
              class="sgs-link sgs-hero__link"
              {% if s.button_2_link != blank %}
                href="{{ s.button_2_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- s.button_2_label | escape -}}
              <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14">
                <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.feature_1 != blank or s.feature_2 != blank or s.feature_3 != blank -%}
        <ul class="sgs-hero__features sgs-hero__rise" style="--i: 4;" role="list">
          {%- for i in (1..3) -%}
            {%- assign feature_key = 'feature_' | append: i -%}
            {%- assign feature = s[feature_key] -%}
            {%- if feature != blank -%}
              <li class="sgs-hero__feature sgs-label">{{ feature | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if layout == 'split' -%}
      <div class="sgs-hero__art sgs-hero__art--{{ s.art_style }}">
        <div class="sgs-hero__stage">
          <div class="sgs-hero__frame">
            {%- if hero_image != blank -%}
              {{
                hero_image
                | image_url: width: 1600
                | image_tag:
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: '(min-width: 990px) 42vw, 86vw',
                  loading: 'eager',
                  fetchpriority: 'high',
                  class: 'sgs-hero__art-img',
                  alt: hero_alt
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'sgs-hero__art-img sgs-hero__placeholder' }}
            {%- endif -%}
          </div>

          {%- if s.show_product_tag and featured_product != blank -%}
            <a class="sgs-hero__tag" href="{{ featured_product.url }}">
              <span class="sgs-hero__tag-label sgs-label">{{ s.product_tag_label | escape }}</span>
              <span class="sgs-hero__tag-title">{{ featured_product.title | escape }}</span>
              <span class="sgs-hero__tag-price">
                {%- if featured_product.price_varies -%}
                  {%- assign from_price = featured_product.price_min | money -%}
                  {{ 'content.price_from' | t: price: from_price }}
                {%- else -%}
                  {{ featured_product.price | money }}
                {%- endif -%}
                <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14">
                  <path d="M1 7h12M8.5 2.5L13 7l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sgs-hero {
    --sgs-hero-fg: #0e0e0e;
    --sgs-hero-fg-muted: rgb(14 14 14 / 0.62);
    --sgs-hero-fg-faint: rgb(14 14 14 / 0.4);
    --sgs-hero-line: rgb(14 14 14 / 0.14);
    --sgs-hero-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    --sgs-hero-header-offset: 0px;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: var(--sgs-hero-min-height);
    padding-block: calc(var(--sgs-hero-pad-top) + var(--sgs-hero-header-offset)) var(--sgs-hero-pad-bottom);
    background-color: var(--sgs-hero-bg);
    color: var(--sgs-hero-fg);
  }

  /*
   * Under a transparent header Horizon pulls the first section up behind the whole header group
   * (announcement bar, Christmas banner, header). Clear all of it: --header-group-height covers the
   * bars above the header, and the header itself is added when it isn't already counted in it.
   * Both values are measured by Horizon (theme.liquid before first paint, header.js on resize).
   */
  #header-group:has(> .header-section > #header-component[transparent])
    ~ .content-for-layout
    > .shopify-section:first-child
    .sgs-hero {
    --sgs-hero-header-offset: calc(
      var(--header-group-height, 0px) + var(--header-height, 0px) * var(--transparent-header-offset-boolean, 0)
    );
  }

  .sgs-hero--dark {
    --sgs-hero-fg: #f5f3ef;
    --sgs-hero-fg-muted: rgb(245 243 239 / 0.66);
    --sgs-hero-fg-faint: rgb(245 243 239 / 0.42);
    --sgs-hero-line: rgb(245 243 239 / 0.14);
  }

  /* Soft gallery spotlight behind the artwork */
  .sgs-hero--split::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 50% 65% at 73% 52%,
      color-mix(in srgb, var(--sgs-hero-fg) 7%, transparent),
      transparent 72%
    );
    pointer-events: none;
  }

  .sgs-hero__inner {
    position: relative;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .sgs-hero--split .sgs-hero__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 32px);
    align-items: center;
  }

  .sgs-hero--split .sgs-hero__content {
    grid-column: 1 / span 6;
  }

  .sgs-hero--split .sgs-hero__art {
    grid-column: 8 / span 5;
  }

  .sgs-hero__content {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .sgs-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 32px;
    color: var(--sgs-hero-fg-muted);
  }

  .sgs-hero__eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: currentColor;
    flex-shrink: 0;
  }

  .sgs-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: clamp(3rem, 1.5rem + 5.4vw, 6.75rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--sgs-hero-fg);
  }

  .sgs-hero__heading em {
    font-style: normal;
    color: var(--sgs-hero-accent);
  }

  .sgs-hero__text {
    margin: 32px 0 0;
    max-width: 34ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--sgs-hero-fg-muted);
    text-wrap: pretty;
  }

  .sgs-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-top: 48px;
  }

  /* Primary: solid, quiet, high-contrast — inverts with the section tone */
  .sgs-hero__button,
  .sgs-hero__button:hover {
    --button-padding-block: 18px;
    --button-padding-inline: 36px;
    --button-color: var(--sgs-hero-bg);
    --button-background-color: var(--sgs-hero-fg);
    --button-border-color: var(--sgs-hero-fg);

    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    transition: background-color 0.4s var(--sgs-hero-ease), box-shadow 0.4s var(--sgs-hero-ease),
      color 0.4s var(--sgs-hero-ease);
  }

  .sgs-hero__button:hover {
    --button-background-color: color-mix(in srgb, var(--sgs-hero-fg) 86%, var(--sgs-hero-bg));
    --button-border-color: color-mix(in srgb, var(--sgs-hero-fg) 86%, var(--sgs-hero-bg));
  }

  .sgs-hero__link {
    color: var(--sgs-hero-fg);
  }

  .sgs-hero__features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    color: var(--sgs-hero-fg-faint);
  }

  .sgs-hero__feature + .sgs-hero__feature::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 10px;
    margin-inline: 16px;
    background: var(--sgs-hero-line);
    vertical-align: -1px;
  }

  /* Artwork */
  .sgs-hero__art {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Fine racing pinstripe running behind the print */
  .sgs-hero--stripes .sgs-hero__art::before {
    content: '';
    position: absolute;
    top: 56%;
    left: -40%;
    right: -100vw;
    height: 12px;
    transform: rotate(-6deg);
    background: linear-gradient(
      to bottom,
      var(--sgs-hero-accent) 0 3px,
      transparent 3px 9px,
      var(--sgs-hero-line) 9px 10px,
      transparent 10px
    );
    z-index: 0;
    pointer-events: none;
  }

  .sgs-hero__stage {
    position: relative;
    z-index: 1;
    width: min(100%, calc(min(58svh, 680px) * var(--sgs-art-ratio)));
  }

  .sgs-hero__frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--sgs-art-ratio);
    transition: translate 0.8s var(--sgs-hero-ease), box-shadow 0.8s var(--sgs-hero-ease);
  }

  .sgs-hero__art--shadow .sgs-hero__frame,
  .sgs-hero__art--mat .sgs-hero__frame {
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1), 0 30px 60px -20px rgb(0 0 0 / 0.38),
      0 70px 120px -50px rgb(0 0 0 / 0.45);
  }

  .sgs-hero__art--mat .sgs-hero__frame {
    padding: clamp(14px, 1.8vw, 26px);
    background: #fff;
  }

  .sgs-hero__stage:hover .sgs-hero__frame {
    translate: 0 -6px;
  }

  .sgs-hero__art--shadow .sgs-hero__stage:hover .sgs-hero__frame,
  .sgs-hero__art--mat .sgs-hero__stage:hover .sgs-hero__frame {
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1), 0 40px 70px -24px rgb(0 0 0 / 0.42),
      0 90px 140px -60px rgb(0 0 0 / 0.5);
  }

  .sgs-hero__art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sgs-hero__placeholder {
    background: color-mix(in srgb, var(--sgs-hero-fg) 8%, transparent);
    fill: color-mix(in srgb, var(--sgs-hero-fg) 35%, transparent);
  }

  /* Gallery caption beneath the print */
  .sgs-hero__tag {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px 24px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--sgs-hero-line);
    color: var(--sgs-hero-fg);
    text-decoration: none;
  }

  .sgs-hero__tag-label {
    grid-column: 1 / -1;
    font-size: 10px;
    color: var(--sgs-hero-fg-faint);
  }

  .sgs-hero__tag-title {
    transition: opacity 0.4s var(--sgs-hero-ease);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 15px;
    line-height: 1.25;
    letter-spacing: -0.005em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .sgs-hero__tag-price {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    white-space: nowrap;
    color: var(--sgs-hero-fg-muted);
  }

  .sgs-hero__tag-price svg {
    transition: translate 0.4s var(--sgs-hero-ease);
  }

  .sgs-hero__tag:hover .sgs-hero__tag-title {
    opacity: 0.75;
  }

  .sgs-hero__tag:hover .sgs-hero__tag-price svg {
    translate: 3px 0;
  }

  /* Full-bleed layout */
  .sgs-hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .sgs-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .sgs-hero__video.is-playing {
    opacity: 1;
  }

  .sgs-hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgb(0 0 0 / var(--sgs-hero-dim, 0)), rgb(0 0 0 / var(--sgs-hero-dim, 0))),
      linear-gradient(
      90deg,
      color-mix(in srgb, var(--sgs-hero-bg) var(--sgs-hero-overlay), transparent) 0%,
      color-mix(in srgb, var(--sgs-hero-bg) calc(var(--sgs-hero-overlay) * 0.6), transparent) 45%,
      transparent 85%
    );
  }

  .sgs-hero__backdrop-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Entrance motion: quiet fade and rise, staggered */
  @media (prefers-reduced-motion: no-preference) {
    .sgs-hero__rise {
      animation: sgs-hero-rise 1s var(--sgs-hero-ease) both;
      animation-delay: calc(var(--i, 0) * 100ms + 100ms);
    }

    .sgs-hero__stage {
      animation: sgs-hero-art 1.4s var(--sgs-hero-ease) 0.2s both;
    }

    .sgs-hero--stripes .sgs-hero__art::before {
      animation: sgs-hero-stripes 1.6s var(--sgs-hero-ease) 0.3s both;
    }

    .sgs-hero__backdrop-img {
      animation: sgs-hero-zoom 2.4s var(--sgs-hero-ease) both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-hero__frame,
    .sgs-hero__tag,
    .sgs-hero__tag-price svg,
    .sgs-hero__button {
      transition: none;
    }
  }

  @keyframes sgs-hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes sgs-hero-art {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes sgs-hero-stripes {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes sgs-hero-zoom {
    from {
      transform: scale(1.05);
    }
    to {
      transform: none;
    }
  }

  @media screen and (max-width: 989px) {
    .sgs-hero {
      min-height: 0;
      padding-block: calc(var(--sgs-hero-pad-top) * 0.55 + var(--sgs-hero-header-offset))
        calc(var(--sgs-hero-pad-bottom) * 0.75);
    }

    .sgs-hero--split .sgs-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 64px;
    }

    .sgs-hero--split .sgs-hero__content,
    .sgs-hero--split .sgs-hero__art {
      grid-column: 1;
    }

    .sgs-hero--split::before {
      background: radial-gradient(
        ellipse 90% 40% at 50% 78%,
        color-mix(in srgb, var(--sgs-hero-fg) 7%, transparent),
        transparent 72%
      );
    }

    .sgs-hero__eyebrow {
      margin-bottom: 24px;
    }

    .sgs-hero__text {
      margin-top: 24px;
    }

    .sgs-hero__actions {
      margin-top: 36px;
    }

    .sgs-hero__features {
      margin-top: 40px;
    }

    .sgs-hero__stage {
      width: min(100%, 440px, calc(62svh * var(--sgs-art-ratio)));
    }

    .sgs-hero--full {
      min-height: max(600px, 85svh);
      align-items: flex-end;
    }

    .sgs-hero__backdrop::after {
      background: linear-gradient(
        0deg,
        color-mix(in srgb, var(--sgs-hero-bg) var(--sgs-hero-overlay), transparent) 0%,
        color-mix(in srgb, var(--sgs-hero-bg) calc(var(--sgs-hero-overlay) * 0.5), transparent) 55%,
        transparent 100%
      );
    }
  }

  @media screen and (max-width: 479px) {
    .sgs-hero__button {
      width: 100%;
    }

    .sgs-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .sgs-hero__link {
      align-self: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SixthGear hero",
  "tag": "div",
  "class": "sgs-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Print showcase (text + artwork)" },
        { "value": "full", "label": "Full-width background image" }
      ],
      "default": "split",
      "info": "Use full-width once you have a wide lifestyle photo. A background video always uses full-width."
    },
    {
      "type": "header",
      "content": "Background video"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image",
