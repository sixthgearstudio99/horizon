{%- liquid
  # SixthGear sale display: the open window's message rotates first
  capture sgs_sale_win
    render 'sgs-sale-window'
  endcapture
  assign sgs_sale_win = sgs_sale_win | strip
  assign sgs_sale_message = ''
  if sgs_sale_win != blank
    assign sgs_sale_message_key = 'sgs_sale' | append: sgs_sale_win | append: '_message'
    assign sgs_sale_message = settings[sgs_sale_message_key] | strip
  endif
  assign slide_count = section.blocks.size
  if sgs_sale_message != blank
    assign slide_count = slide_count | plus: 1
  endif
-%}

{% if slide_count > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if slide_count > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {%- if sgs_sale_message != blank -%}
        <slideshow-slide
          ref="slides[]"
          id="SgsSaleSlide-{{ section.id }}"
          class="announcement-bar__slide text-block text-block--align-center text-block--full-width"
          style="--width: 100%; --text-align: center; --line-height: 1; --color: #f5f3ef; --color-rgb: 245 243 239;"
          data-sgs-sale-slide="{{ sgs_sale_win }}"
          aria-hidden="false"
        >
          <p class="announcement-bar__text">{{ sgs_sale_message | escape }}</p>
        </slideshow-slide>
      {%- endif -%}
      {% content_for 'blocks' %}
    </div>
    <script>
      (function () {
        // Settled from the visitor's clock (html[data-sgs-sale], set in the head) before the
        // slideshow starts, which happens later in a module script:
        // - the sale message stays only while its window is open
        // - the build-your-wall message takes that window's wording, or is removed
        var slides = document.currentScript.closest('announcement-bar-component')?.querySelector('.announcement-bar__slides');
        if (!slides) return;
        var win = document.documentElement.getAttribute('data-sgs-sale') || '0';
        var sale = slides.querySelector('[data-sgs-sale-slide]');
        if (sale && sale.getAttribute('data-sgs-sale-slide') !== win) sale.remove();
        slides.querySelectorAll('[data-sgs-wall-slide]').forEach(function (slide) {
          var text = slide.getAttribute('data-text-' + win);
          if (text === null) text = slide.getAttribute('data-text-0');
          if (!text) {
            slide.remove();
            return;
          }
          var p = slide.querySelector('.announcement-bar__text');
          if (p && p.innerHTML.trim() !== text.trim()) p.innerHTML = text;
        });
        slides.querySelectorAll('.announcement-bar__slide').forEach(function (el, i) {
          el.setAttribute('aria-hidden', i === 0 ? 'false' : 'true');
        });
      })();
    </script>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
