{%- doc -%}
  SixthGear Studios: the paper, sizes and finish rows of the "What you get" box on product pages
  (blocks/sgs-delivery-estimate.liquid, details layout). Only facts the theme already has: the paper
  follows the chosen size's Paper option (semi-gloss or fine art), the sizes come from the product's
  Size option in inches and cm, and the finish follows the product's framed tag.

  @param {product} product_resource - The product
  @param {object} bs - The delivery block's settings (wording)

  @example
  {% render 'sgs-what-you-get', product_resource: closest.product, bs: block.settings %}
{%- enddoc -%}

{%- liquid
  # Paper: fine art on some sizes (Paper: Fine Art), semi-gloss on the rest
  assign has_fine = false
  assign has_semi = false
  for v in product_resource.variants
    capture v_paper
      render 'sgs-variant-paper', variant: v
    endcapture
    if v_paper contains 'fine'
      assign has_fine = true
    else
      assign has_semi = true
    endif
  endfor
  capture current_paper
    render 'sgs-variant-paper', variant: product_resource.selected_or_first_available_variant
  endcapture

  assign size_option = nil
  for option in product_resource.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign size_option = option
      break
    endif
  endfor

  capture sgs_framed
    render 'sgs-is-framed', product_resource: product_resource
  endcapture
-%}

{%- if bs.wyg_paper != blank -%}
  <li class="sgs-dinfo__row">
    <svg class="sgs-dinfo__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><path d="M4.5 2.5h8l3 3v12h-11z"/><path d="M12.5 2.5v3h3"/></svg>
    <span>
      {%- if has_fine and bs.wyg_paper_fine != blank -%}
        {%- if has_semi -%}<span data-sgs-paper="semi"{% if current_paper contains 'fine' %} hidden{% endif %}>{{ bs.wyg_paper | escape }}</span>{%- endif -%}
        <span data-sgs-paper="fine"{% unless current_paper contains 'fine' %} hidden{% endunless %}>{{ bs.wyg_paper_fine | escape }}</span>
      {%- else -%}
        {{ bs.wyg_paper | escape }}
      {%- endif -%}
    </span>
  </li>
  {%- if has_fine and has_semi and bs.wyg_paper_fine != blank -%}{% render 'sgs-paper-sync' %}{%- endif -%}
{%- endif -%}

{%- if size_option != nil and bs.wyg_sizes_label != blank -%}
  <li class="sgs-dinfo__row">
    <svg class="sgs-dinfo__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><rect x="2.5" y="6.5" width="15" height="7" rx="1"/><path d="M6 6.5v3M9 6.5v2M12 6.5v3M15 6.5v2"/></svg>
    <span>
      {{- bs.wyg_sizes_label | escape }}
      {% for value in size_option.values -%}
        {%- capture size_text -%}{% render 'sgs-size-label', value: value.name %}{%- endcapture -%}
        {{ size_text | strip }}{% unless forloop.last %} · {% endunless %}
      {%- endfor -%}
    </span>
  </li>
{%- endif -%}

{%- if sgs_framed contains 'true' -%}
  {%- assign finish_text = bs.wyg_framed -%}
{%- else -%}
  {%- assign finish_text = bs.wyg_unframed -%}
{%- endif -%}
{%- if finish_text != blank -%}
  <li class="sgs-dinfo__row">
    <svg class="sgs-dinfo__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><rect x="2.5" y="2.5" width="15" height="15"/><rect x="5.5" y="5.5" width="9" height="9"/></svg>
    <span>{{ finish_text | escape }}</span>
  </li>
{%- endif -%}
