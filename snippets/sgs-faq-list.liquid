{%- doc -%}
  SixthGear Studios: FAQ accordion plus matching FAQPage structured data, shared by the product
  FAQ block and the homepage FAQ section. Questions and answers come from question_1..6 and
  answer_1..6 in the settings passed in.

  @param {object} settings - Block or section settings holding question_N / answer_N
  @param {product} [product_resource] - The product, so "[sizes]" in an answer lists its sizes

  @example
  {% render 'sgs-faq-list', settings: block.settings %}
{%- enddoc -%}

{%- assign bs = settings -%}
{%- comment -%} "[sizes]" in an answer becomes the product's sizes, e.g. "16×24, 24×36" {%- endcomment -%}
{%- capture sizes_text -%}{% render 'sgs-product-sizes', product_resource: product_resource, fallback: '12×18, 16×24, 24×36' %}{%- endcapture -%}
{%- assign sizes_text = sizes_text | strip -%}
{%- for i in (1..6) -%}
      {%- assign q_key = 'question_' | append: i -%}
      {%- assign a_key = 'answer_' | append: i -%}
      {%- if bs[q_key] != blank and bs[a_key] != blank -%}
        <details class="sgs-faq__item">
          <summary class="sgs-faq__summary">
            <span class="sgs-faq__question">{{ bs[q_key] | escape }}</span>
            <span class="sgs-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="sgs-faq__answer">{{ bs[a_key] | replace: '[sizes]', sizes_text | escape | newline_to_br }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}

  {%- comment -%} FAQPage structured data built from the same questions and answers {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for i in (1..6) -%}
          {%- assign q_key = 'question_' | append: i -%}
          {%- assign a_key = 'answer_' | append: i -%}
          {%- if bs[q_key] != blank and bs[a_key] != blank -%}
            {%- unless first -%},{%- endunless -%}
            {%- assign first = false -%}
            {
              "@type": "Question",
              "name": {{ bs[q_key] | strip | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ bs[a_key] | replace: '[sizes]', sizes_text | strip_newlines | strip | json }}
              }
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>

{% stylesheet %}
  .sgs-faq {
    width: 100%;
  }

  .sgs-faq__heading {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 500;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .sgs-faq__item {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .sgs-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  .sgs-faq__summary::-webkit-details-marker {
    display: none;
  }

  .sgs-faq__question {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb));
  }

  .sgs-faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
  }

  .sgs-faq__icon::before,
  .sgs-faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .sgs-faq__icon::after {
    transform: rotate(90deg);
  }

  .sgs-faq__item[open] .sgs-faq__icon::after {
    transform: rotate(0deg);
  }

  .sgs-faq__answer {
    padding: 0 28px 20px 0;
    font-size: 15px;
    line-height: 1.65;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-faq__icon::before,
    .sgs-faq__icon::after {
      transition: none;
    }
  }
{% endstylesheet %}
