{%- liquid
  # SixthGear: what the print is, in a short understated list (no ticks or badges)
  assign bs = block.settings
  assign product_resource = closest.product

  # Paper: some prints use fine art paper on some sizes (e.g. 20 x 10 in on the Mindset posters).
  # The item about semi-gloss paper then follows the chosen variant.
  assign has_fine = false
  assign has_semi = false
  for v in product_resource.variants
    capture v_paper
      render 'sgs-variant-paper', variant: v
    endcapture
    if v_paper contains 'fine'
      assign has_fine = true
    else
      assign has_semi = true
    endif
  endfor
  capture current_paper
    render 'sgs-variant-paper', variant: product_resource.selected_or_first_available_variant
  endcapture
  assign current_paper = current_paper | strip
  assign item_count = 0
  for i in (1..5)
    assign key = 'item_' | append: i
    if bs[key] != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- if item_count > 0 and closest.product.gift_card? != true -%}
  <div class="sgs-specs" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-specs__heading">{{ bs.heading | escape }}</h2>
    {%- endif -%}
    {%- if bs.statement != blank -%}
      <p class="sgs-specs__statement">{{ bs.statement | escape }}</p>
    {%- endif -%}
    <ul class="sgs-specs__list" role="list">
      {%- for i in (1..5) -%}
        {%- assign key = 'item_' | append: i -%}
        {%- if bs[key] != blank -%}
          {%- liquid
            assign item_lower = bs[key] | downcase | replace: '-', ' '
            assign is_paper_item = false
            if item_lower contains 'semi gloss' or item_lower contains 'semigloss'
              assign is_paper_item = true
            endif
          -%}
          {%- if is_paper_item and has_fine and bs.paper_fine_text != blank -%}
            {%- if has_semi -%}
              <li class="sgs-specs__item" data-sgs-paper="semi"{% if current_paper == 'fine' %} hidden{% endif %}>{{ bs[key] | escape }}</li>
            {%- endif -%}
            <li class="sgs-specs__item" data-sgs-paper="fine"{% if current_paper != 'fine' %} hidden{% endif %}>{{ bs.paper_fine_text | escape }}</li>
          {%- else -%}
            <li class="sgs-specs__item">{{ bs[key] | escape }}</li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
  {%- if has_fine and has_semi -%}{% render 'sgs-paper-sync' %}{%- endif -%}
{%- endif -%}

{% stylesheet %}
  .sgs-specs {
    width: 100%;
    font-family: var(--sgs-font-body, Inter, sans-serif);
    color: var(--sgs-text, #111111);
  }

  .sgs-specs .sgs-specs__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 18px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .sgs-specs__statement {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-specs__list {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  /* A small square marker in place of ticks */
  .sgs-specs__item[hidden] {
    display: none;
  }

  .sgs-specs__item {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.5;
  }

  .sgs-specs__item::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 2px;
    width: 5px;
    height: 5px;
    background: var(--sgs-text, #111111);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Print details list",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium automotive wall art"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Line under the heading",
      "default": "Automotive art prints, designed for enthusiasts."
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
      "default": "Premium semi-gloss paper"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Item 2",
      "default": "Professionally printed in the UK"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Item 3",
      "default": "Carefully packaged for safe delivery"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Item 4"
    },
    {
      "type": "text",
      "id": "paper_fine_text",
      "label": "Paper item on fine art variants",
      "default": "Printed on fine art paper",
      "info": "Replaces the item that mentions semi-gloss paper while a fine art variant (Paper: Fine Art) is chosen."
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Item 5"
    }
  ],
  "presets": [
    {
      "name": "Print details list"
    }
  ]
}
{% endschema %}
