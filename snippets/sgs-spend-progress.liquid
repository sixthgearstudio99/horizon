{%- doc -%}
  SixthGear Studios: spend progress in the cart drawer and cart page, e.g. "Add £12 more of unframed
  prints to get 25% off", then "You've unlocked 25% off. It's applied at checkout." Counts cart lines,
  at their line price, whose product has the tag set in Theme settings > SixthGear: cart spend offer
  (default "sale eligible"; any case, a hyphen or underscore counts as a space) and not the tag
  "framed". The collection handle there is only a fallback, for products without that tag.
  Two spend phases (Theme settings > SixthGear: cart spend offer): phase 1 until the switch time,
  phase 2 until the end time, each with its own threshold, discount text and "Ends …" line. Then
  phase 3, the bundle offer, from its start date: a message by the number of those prints in the
  cart ("add 2 more prints and your 3rd is half price"), hidden while there are none. All phases
  are in the page and the visitor's UK clock picks one (snippets/sgs-spend-phase-head.liquid), so
  it changes over by itself. Display only: the discounts themselves are set up in Shopify.
  Hidden when switched off, when the cart is empty, and after the end.

  @example
  {% render 'sgs-spend-progress' %}
{%- enddoc -%}

{%- liquid
  assign show = false
  if settings.sgs_spend_enabled or settings.sgs_buy2_enabled
    assign show = true
  endif
  assign switch_at = settings.sgs_spend_switch | strip
  assign ends = settings.sgs_spend_end | strip
  assign now = 'now' | date: '%Y-%m-%d %H:%M'

  # Which phases this cart line needs; the visitor's clock picks the one shown
  # (html[data-sgs-spend-phase], set by snippets/sgs-spend-phase-head.liquid).
  # Buy 2 offer on: only phase 3 (counts prints), in place of the spend offer.
  assign phases = ''
  assign server_phase = 'off'
  if settings.sgs_buy2_enabled
    assign phases = '3'
    assign server_phase = '3'
  elsif settings.sgs_spend_enabled
    assign spend_on = true
    if ends.size == 16 and now > ends
      assign spend_on = false
    endif
    if spend_on
      assign phases = '1'
      assign server_phase = '1'
      if switch_at.size == 16
        assign phases = '1,2'
        if now >= switch_at
          assign server_phase = '2'
        endif
      endif
    endif
  endif
  if phases == '' or cart.item_count == 0
    assign show = false
  endif
  assign phases = phases | split: ','

  if show
    # Eligible prints: tagged (default "sale eligible") and not framed. Spend at their line price,
    # count by quantity.
    assign eligible = 0
    assign eligible_count = 0
    for item in cart.items
      # The same rule as the product page offer ticker (snippets/sgs-spend-eligible.liquid)
      capture item_counts
        render 'sgs-spend-eligible', product_resource: item.product
      endcapture
      assign counts = false
      if item_counts contains 'true'
        assign counts = true
      endif
      if counts
        assign eligible = eligible | plus: item.final_line_price
        assign eligible_count = eligible_count | plus: item.quantity
      endif
    endfor
  endif
-%}

{%- if show -%}
  <div class="sgs-spendprog">
    {%- for phase in phases -%}
      {%- liquid
        assign ends_text = ''
        if phase == '3'
          if eligible_count == 0
            continue
          endif
          if eligible_count == 1
            assign message = settings.sgs_bundle_text_1 | default: 'Complete the garage: add 2 more prints and your 3rd is half price'
          elsif eligible_count == 2
            assign message = settings.sgs_bundle_text_2 | default: "Add 1 more print and it's half price"
          else
            assign message = settings.sgs_bundle_text_3 | default: 'Garage complete. Your cheapest print is half price, shown at checkout.'
          endif
          assign fill = eligible_count | at_most: 3 | times: 100.0 | divided_by: 3 | round: 1
        else
          if phase == '2'
            assign threshold = settings.sgs_spend_threshold_2 | default: 50 | plus: 0
            assign discount_text = settings.sgs_spend_discount_2 | strip | default: '25% off'
            assign ends_text = settings.sgs_spend_ends_2 | strip
          else
            assign threshold = settings.sgs_spend_threshold | default: 50 | plus: 0
            assign discount_text = settings.sgs_spend_discount | strip | default: '20% off'
            assign ends_text = settings.sgs_spend_ends_1 | strip
          endif
          assign threshold_pence = threshold | times: 100
          if threshold_pence < 1
            assign threshold_pence = 1
          endif
          if eligible >= threshold_pence
            assign message = settings.sgs_spend_text_met | default: "You've unlocked [discount]. It's applied at checkout."
            assign fill = 100
          else
            assign remaining = threshold_pence | minus: eligible | money_without_trailing_zeros
            assign message = settings.sgs_spend_text_below | default: 'Add [amount] more of unframed prints to get [discount]'
            assign message = message | replace: '[amount]', remaining
            assign fill = eligible | times: 100.0 | divided_by: threshold_pence | round: 1
          endif
          assign message = message | replace: '[discount]', discount_text
        endif
      -%}
      <div class="sgs-spendprog__phase" data-phase="{{ phase }}"{% if phase == server_phase %} data-server-current{% endif %}>
        <p class="sgs-spendprog__message">{{ message | escape }}</p>
        <div
          class="sgs-spendprog__bar"
          role="progressbar"
          aria-label="{{ message | escape }}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ fill | round }}"
        >
          <span class="sgs-spendprog__fill" style="width: {{ fill }}%;"></span>
        </div>
        {%- if ends_text != blank -%}
          <p class="sgs-spendprog__ends">{{ ends_text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* One line and a thin bar, like the Buy 2, Get 1 Free progress */
  .sgs-spendprog {
    margin: 0 0 20px;
    padding: 14px 0 16px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    container-type: inline-size;
  }

  /* Only the current phase's wording shows; nothing at all after the end (html[data-sgs-spend-phase]) */
  .sgs-spendprog__phase {
    display: none;
  }

  :root:not([data-sgs-spend-phase]) .sgs-spendprog__phase[data-server-current],
  html[data-sgs-spend-phase='1'] .sgs-spendprog__phase[data-phase='1'],
  html[data-sgs-spend-phase='2'] .sgs-spendprog__phase[data-phase='2'],
  html[data-sgs-spend-phase='3'] .sgs-spendprog__phase[data-phase='3'] {
    display: block;
  }

  /* Nothing at all (no rule, no gap) when the current phase has nothing to say */
  html[data-sgs-spend-phase='off'] .sgs-spendprog,
  :root:not([data-sgs-spend-phase]) .sgs-spendprog:not(:has([data-server-current])),
  html[data-sgs-spend-phase='1'] .sgs-spendprog:not(:has([data-phase='1'])),
  html[data-sgs-spend-phase='2'] .sgs-spendprog:not(:has([data-phase='2'])),
  html[data-sgs-spend-phase='3'] .sgs-spendprog:not(:has([data-phase='3'])) {
    display: none;
  }

  .sgs-spendprog__message {
    margin: 0;
    font-size: clamp(12px, 3.9cqi, 14px);
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
    color: rgb(var(--color-foreground-rgb));
  }

  .sgs-spendprog__ends {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .sgs-spendprog__bar {
    position: relative;
    height: 3px;
    margin-top: 12px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.1);
  }

  .sgs-spendprog__fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background: var(--sgs-text);
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
{% endstylesheet %}
