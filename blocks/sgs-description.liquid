{%- liquid
  assign bs = block.settings
  assign product_resource = closest.product
  assign uid = 'SgsDesc-' | append: block.id
  capture description
    render 'sgs-description-html', product_resource: product_resource
  endcapture
  assign description = description | strip

  # Bullet lists repeat the paragraphs and the What you get list, so they can be left out
  if bs.remove_lists
    for list_tag in (1..2)
      if list_tag == 1
        assign open_tag = '<ul'
        assign close_tag = '</ul>'
      else
        assign open_tag = '<ol'
        assign close_tag = '</ol>'
      endif
      if description contains open_tag
        assign chunks = description | split: open_tag
        assign kept = chunks.first
        for chunk in chunks offset: 1
          if chunk contains close_tag
            assign after_list = chunk | split: close_tag | slice: 1, 99 | join: close_tag
            assign kept = kept | append: after_list
          endif
        endfor
        assign description = kept | strip
      endif
    endfor
  endif

  # First paragraph, and the rest behind Read more
  assign intro = description
  assign rest = ''
  if bs.layout == 'first_paragraph' and description contains '</p>'
    assign parts = description | split: '</p>'
    assign intro = parts.first | append: '</p>'
    assign rest = description | remove_first: intro | strip
    if rest == '</p>'
      assign rest = ''
    endif
  endif
  assign rest_text = rest | strip_html | strip

  # The older layout: long descriptions start collapsed to about five lines
  assign collapsible = false
  if bs.layout != 'first_paragraph'
    assign plain_length = description | strip_html | strip | size
    if plain_length > bs.collapse_after
      assign collapsible = true
    endif
  endif
-%}

{%- if description != blank -%}
  <div class="sgs-desc{% if collapsible %} sgs-desc--collapsible{% endif %}" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-desc__heading sgs-label">{{ bs.heading | escape }}</h2>
    {%- endif -%}
    {%- if bs.spec_line != blank -%}
      <p class="sgs-desc__spec">
        <span>{{ bs.spec_line | escape }}</span>
      </p>
    {%- endif -%}
    {%- if bs.layout == 'first_paragraph' -%}
      <div class="sgs-desc__body rte">{{ intro }}</div>
      {%- if rest_text != blank -%}
        <div class="sgs-desc__body sgs-desc__more rte" id="{{ uid }}" hidden>{{ rest }}</div>
        <button
          type="button"
          class="sgs-desc__toggle"
          aria-expanded="false"
          aria-controls="{{ uid }}"
          data-more="{{ bs.more_label | escape }}"
          data-less="{{ bs.less_label | escape }}"
          onclick="var o=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',String(!o));this.textContent=o?this.dataset.more:this.dataset.less;document.getElementById(this.getAttribute('aria-controls')).hidden=o;"
        >
          {{- bs.more_label | escape -}}
        </button>
      {%- endif -%}
    {%- else -%}
      <div class="sgs-desc__body rte" id="{{ uid }}">{{ description }}</div>
      {%- if collapsible -%}
        <button
          type="button"
          class="sgs-desc__toggle"
          aria-expanded="false"
          aria-controls="{{ uid }}"
          data-more="{{ bs.more_label | escape }}"
          data-less="{{ bs.less_label | escape }}"
          onclick="var o=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',String(!o));this.textContent=o?this.dataset.more:this.dataset.less;"
        >
          {{- bs.more_label | escape -}}
        </button>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .sgs-desc {
    width: 100%;
  }

  /* One line about the print itself (paper and inks), above the description */
  .sgs-desc__spec {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--sgs-text, #111111);
  }

  .sgs-desc__spec svg {
    flex-shrink: 0;
  }

  .sgs-desc__heading {
    margin: 0 0 14px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-desc__body {
    max-width: 65ch;
    font-family: var(--sgs-font-body);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--sgs-text, #111111);
  }

  .sgs-desc__more {
    margin-top: 1em;
  }

  .sgs-desc__more[hidden] {
    display: none;
  }

  .sgs-desc__body > :first-child {
    margin-top: 0;
  }

  .sgs-desc__body > :last-child {
    margin-bottom: 0;
  }

  .sgs-desc__body :is(p, ul, ol) {
    margin: 0 0 1em;
  }

  .sgs-desc__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Five lines of 16px / 1.6 */
  .sgs-desc--collapsible .sgs-desc__body {
    max-height: 8em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .sgs-desc--collapsible:has(.sgs-desc__toggle[aria-expanded='true']) .sgs-desc__body {
    max-height: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .sgs-desc__toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sgs-text, #111111);
    font-family: var(--sgs-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: rgb(var(--sgs-text-rgb, 242 239 234) / 0.3);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .sgs-desc__toggle:focus-visible {
    outline: 1px solid var(--sgs-text, #111111);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product description",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Label",
      "default": "About this print"
    },
    {
      "type": "text",
      "id": "spec_line",
      "label": "Line about the print",
      "info": "Shown above the description, e.g. the paper and inks. Leave empty to hide."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "first_paragraph",
          "label": "First paragraph, then Read more"
        },
        {
          "value": "collapse",
          "label": "Collapsed to five lines"
        }
      ],
      "default": "first_paragraph"
    },
    {
      "type": "checkbox",
      "id": "remove_lists",
      "label": "Leave out bullet lists",
      "default": true,
      "info": "For descriptions whose bullet points repeat the paragraphs."
    },
    {
      "type": "range",
      "id": "collapse_after",
      "label": "Collapse descriptions longer than",
      "min": 100,
      "max": 1000,
      "step": 50,
      "unit": "chr",
      "default": 350,
      "info": "Longer descriptions show about five lines with a Read more link."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Read less label",
      "default": "Read less"
    }
  ],
  "presets": [
    {
      "name": "Product description"
    }
  ]
}
{% endschema %}
