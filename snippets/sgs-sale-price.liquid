{%- doc -%}
  SixthGear Studios: no longer shows reduced prices (see the note below); kept so its callers keep
  working. With part 'note', the open offer window's short message, hidden by CSS unless the
  visitor's device agrees the same window is open (html[data-sgs-sale]).

  @param {product} product_resource - The product
  @param {string} window - The open window, 1 or 2 (from sgs-sale-window)
  @param {string} [part] - 'price' (default), 'now' (sale price only) or 'note'
  @param {number} [amount] - Price in pence that the discount applies to (part 'price')
  @param {boolean} [from] - Show "From" before the prices (part 'price')
  @param {boolean} [save] - Show the saving as a percentage, e.g. "20% off" (product cards, and the product page price)

  @example
  {% render 'sgs-sale-price', product_resource: product, window: sgs_sale_win, amount: 2500 %}
{%- enddoc -%}

{%- liquid
  assign part = part | default: 'price'
  assign message_key = 'sgs_sale' | append: window | append: '_message'
  assign short_key = 'sgs_sale' | append: window | append: '_short'

  assign in_sale = true
  if product_resource == blank or product_resource.gift_card?
    assign in_sale = false
  endif
  assign excluded = settings.sgs_sale_excluded_handles | strip_newlines | remove: ' ' | split: ','
  if excluded contains product_resource.handle
    assign in_sale = false
  endif
  # Framed prints are never discounted
  if in_sale
    capture sgs_framed
      render 'sgs-is-framed', product_resource: product_resource
    endcapture
    if sgs_framed contains 'true'
      assign in_sale = false
    endif
  endif
-%}

{%- comment -%}
  Prices are never shown reduced. The offers are taken off at checkout (e.g. 25% off unframed prints
  when the unframed prints in the cart reach £50), so a product's own price is what one item costs;
  showing it already reduced would not match what the customer is charged. A genuine compare-at
  price set in Shopify still shows as a sale (snippets/price.liquid). Only the offer's short note
  can be output here.
{%- endcomment -%}
{%- if in_sale and part == 'note' -%}
  {%- assign message = settings[short_key] | strip | default: settings[message_key] -%}
  {%- if message != blank -%}
    <p class="sgs-sale-note" data-sgs-sale-win="{{ window }}">{{ message | escape }}</p>
  {%- endif -%}
{%- endif -%}
