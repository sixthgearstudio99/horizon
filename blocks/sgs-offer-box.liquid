{%- liquid
  # SixthGear: the product page offer box, as a scrolling strip (a ticker) under the price. It loops
  # right to left: the offer for the current phase first, in the accent colour, then the trust
  # points and, while Theme settings > SixthGear: Christmas has a date, the order-by line.
  #
  # The offer comes from the same phase settings as the cart line (Theme settings > SixthGear: cart
  # spend offer): phase 1 and 2 ("Pre Black Friday · 20% off unframed over £50 · Ends Thursday
  # midnight"), then the bundle offer from its start date. Every phase this page may need is in the
  # strip, and the visitor's UK clock picks one (html[data-sgs-spend-phase], set by
  # snippets/sgs-spend-phase-head.liquid), so it switches over by itself. The offer only shows on
  # products that count towards it (snippets/sgs-spend-eligible.liquid: never framed prints).
  # Paused while hovered, touched or focused; with "reduce motion" on it doesn't move and shows the
  # offer line on its own instead.
  assign bs = block.settings
  assign product_resource = closest.product
  assign now = 'now' | date: '%Y-%m-%d %H:%M'
  assign today = 'now' | date: '%Y-%m-%d'

  capture eligible
    render 'sgs-spend-eligible', product_resource: product_resource
  endcapture
  assign eligible = eligible | strip

  # Phases still to come or running on Shopify's clock (as in snippets/sgs-spend-progress.liquid)
  assign switch_at = settings.sgs_spend_switch | strip
  assign ends = settings.sgs_spend_end | strip
  assign bundle_from = settings.sgs_bundle_start | strip
  assign bundle_end = settings.sgs_bundle_end | strip
  assign phases = ''
  if settings.sgs_spend_enabled and eligible == 'true'
    assign spend_on = true
    if ends.size == 16 and now > ends
      assign spend_on = false
    endif
    if spend_on
      assign phases = '1'
      if switch_at.size == 16
        assign phases = '1,2'
      endif
    endif
    if bundle_from.size == 16
      assign bundle_on = true
      if bundle_end.size == 16 and now > bundle_end
        assign bundle_on = false
      endif
      if bundle_on
        if phases == ''
          assign phases = '3'
        else
          assign phases = phases | append: ',3'
        endif
      endif
    endif
  endif
  assign phases = phases | split: ','

  assign server_phase = 'off'
  if switch_at.size == 16 and now >= switch_at
    assign server_phase = '2'
  else
    assign server_phase = '1'
  endif
  if ends.size == 16 and now > ends
    assign server_phase = 'off'
  endif
  if bundle_from.size == 16 and now >= bundle_from
    assign server_phase = '3'
  endif

  # The offer text for each phase
  capture offers
    for phase in phases
      if phase == '3'
        assign text = settings.sgs_ticker_bundle_text | default: 'Buy 3 prints · your 3rd is half price'
      else
        if phase == '2'
          assign phase_name = settings.sgs_spend_name_2
          assign discount = settings.sgs_spend_discount_2 | default: '25% off'
          assign threshold = settings.sgs_spend_threshold_2 | default: 50 | times: 100 | money_without_trailing_zeros
          assign phase_ends = settings.sgs_spend_ends_2 | strip
        else
          assign phase_name = settings.sgs_spend_name_1
          assign discount = settings.sgs_spend_discount | default: '20% off'
          assign threshold = settings.sgs_spend_threshold | default: 50 | times: 100 | money_without_trailing_zeros
          assign phase_ends = settings.sgs_spend_ends_1 | strip
        endif
        assign text = settings.sgs_ticker_spend_text | default: '[name] · [discount] unframed over [threshold] · [ends]'
        if phase_ends == blank
          assign text = text | remove: ' · [ends]' | remove: '[ends]'
        endif
        if phase_name == blank
          assign text = text | remove: '[name] · ' | remove: '[name]'
        endif
        assign text = text | replace: '[name]', phase_name | replace: '[discount]', discount | replace: '[threshold]', threshold | replace: '[ends]', phase_ends
      endif
      assign text = text | strip
      if text != blank
        echo '<span class="sgs-ticker__item sgs-ticker__offer" data-phase="' | append: phase | append: '"'
        if phase == server_phase
          echo ' data-server-current'
        endif
        assign text_safe = text | escape
        echo '>' | append: text_safe | append: '</span>'
      endif
    endfor
  endcapture

  # Christmas order-by line, while the date is set and not past (UK)
  assign xmas_day = settings.sgs_xmas_last_order | strip
  assign xmas_text = ''
  if xmas_day.size == 10 and today <= xmas_day
    assign xmas_date = xmas_day | append: ' 12:00' | date: '%a %-d %b'
    assign xmas_text = settings.sgs_xmas_text | default: 'Order by [date] for Christmas delivery' | replace: '[date]', xmas_date
  endif

  capture group
    echo offers
    for i in (1..4)
      assign point_key = 'point_' | append: i
      assign point = bs[point_key] | strip
      if point != blank
        assign point_safe = point | escape
        echo '<span class="sgs-ticker__item">' | append: point_safe | append: '</span>'
      endif
    endfor
    if xmas_text != blank
      assign xmas_safe = xmas_text | escape
      assign xmas_day_safe = xmas_day | escape
      echo '<span class="sgs-ticker__item" data-sgs-xmas-until="' | append: xmas_day_safe | append: '">' | append: xmas_safe | append: '</span>'
    endif
  endcapture
  assign group = group | strip

  # Reduced motion: the offer on its own; with no offer for this product, the trust points
  capture fallback
    for i in (1..4)
      assign point_key = 'point_' | append: i
      assign point = bs[point_key] | strip
      if point != blank
        echo point | escape
        unless forloop.last
          echo ' · '
        endunless
      endif
    endfor
  endcapture
  assign fallback = fallback | strip | remove_last: ' ·'
-%}

{%- if group != blank and product_resource.gift_card? != true -%}
  <div class="sgs-ticker" tabindex="0" role="region" aria-label="{{ bs.label | default: 'Offers and delivery' | escape }}" data-sgs-ticker {{ block.shopify_attributes }}>
    <div class="sgs-ticker__track">
      {%- for i in (1..4) -%}
        <div class="sgs-ticker__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>{{ group }}</div>
      {%- endfor -%}
    </div>
    <p class="sgs-ticker__static">
      {{- offers -}}
      {%- if fallback != blank -%}<span class="sgs-ticker__fallback">{{ fallback }}</span>{%- endif -%}
    </p>
  </div>
  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      if (!root || !root.matches('[data-sgs-ticker]')) return;
      // Paused while touched
      var pause = function () { root.classList.add('is-paused'); };
      var play = function () { root.classList.remove('is-paused'); };
      root.addEventListener('touchstart', pause, { passive: true });
      root.addEventListener('touchend', play);
      root.addEventListener('touchcancel', play);
      // The Christmas line goes once its date has passed on the visitor's UK clock
      try {
        var p = {};
        new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', year: 'numeric', month: '2-digit', day: '2-digit' })
          .formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
        var today = p.year + '-' + p.month + '-' + p.day;
        root.querySelectorAll('[data-sgs-xmas-until]').forEach(function (el) {
          if (today > el.getAttribute('data-sgs-xmas-until')) el.remove();
        });
      } catch (e) {}
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .sgs-ticker {
    --sgs-ticker-duration: 30s;

    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    width: 100%;
    height: 40px;
    overflow: hidden;
    border: 1px solid #2a2a2a;
    border-radius: 999px;
    background: #1a1a1a;
    color: #f2efea;
    font-family: var(--sgs-font-body);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    /* The scrolling track is several thousand pixels long: it must never set the width of the
       product column (that pushed the desktop layout off the screen) */
    min-width: 0;
    max-width: 100%;
    contain: inline-size;
  }

  /* Soft fade at both ends, inside the border so the outline stays crisp */
  .sgs-ticker::before,
  .sgs-ticker::after {
    content: '';
    position: absolute;
    inset-block: 0;
    z-index: 1;
    width: 28px;
    pointer-events: none;
  }

  .sgs-ticker::before {
    inset-inline-start: 0;
    border-radius: 999px 0 0 999px;
    background: linear-gradient(90deg, #1a1a1a 30%, rgb(26 26 26 / 0));
  }

  .sgs-ticker::after {
    inset-inline-end: 0;
    border-radius: 0 999px 999px 0;
    background: linear-gradient(270deg, #1a1a1a 30%, rgb(26 26 26 / 0));
  }

  .sgs-ticker:focus-visible {
    outline: 2px solid #f2efea;
    outline-offset: 3px;
  }

  /* Four copies in a row; moving by one copy loops seamlessly */
  .sgs-ticker__track {
    /* Out of the flow, so its length doesn't count towards any layout width */
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    width: max-content;
    animation: sgs-ticker var(--sgs-ticker-duration) linear infinite;
  }

  .sgs-ticker:hover .sgs-ticker__track,
  .sgs-ticker:focus-within .sgs-ticker__track,
  .sgs-ticker.is-paused .sgs-ticker__track {
    animation-play-state: paused;
  }

  @keyframes sgs-ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }

  .sgs-ticker__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  /* Each item carries its own separator after it, so hidden items take theirs with them */
  .sgs-ticker__item {
    display: inline-flex;
    align-items: center;
  }

  .sgs-ticker__item::after {
    content: '✦';
    margin-inline: 14px;
    font-size: 9px;
    letter-spacing: 0;
    color: #9a9a9a;
  }

  /* The offer: the accent, and only the current phase's (as the cart line) */
  .sgs-ticker__offer {
    display: none;
    color: #ec6238;
  }

  :root:not([data-sgs-spend-phase]) .sgs-ticker__offer[data-server-current],
  html[data-sgs-spend-phase='1'] .sgs-ticker__offer[data-phase='1'],
  html[data-sgs-spend-phase='2'] .sgs-ticker__offer[data-phase='2'],
  html[data-sgs-spend-phase='3'] .sgs-ticker__offer[data-phase='3'] {
    display: inline-flex;
  }

  /* Reduced motion: no scrolling, the offer line on its own (or the trust points when this product
     has no offer right now) */
  .sgs-ticker__static {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sgs-ticker {
      justify-content: center;
      height: auto;
      min-height: 40px;
      padding: 8px 18px;
      white-space: normal;
    }

    .sgs-ticker::before,
    .sgs-ticker::after {
      content: none;
    }

    .sgs-ticker__track {
      display: none;
    }

    .sgs-ticker__static {
      display: block;
      margin: 0;
      line-height: 1.4;
      text-align: center;
      text-wrap: balance;
    }

    .sgs-ticker__static .sgs-ticker__item::after {
      content: none;
    }

    :root:not([data-sgs-spend-phase]) .sgs-ticker__static:has(.sgs-ticker__offer[data-server-current]) .sgs-ticker__fallback,
    html[data-sgs-spend-phase='1'] .sgs-ticker__static:has([data-phase='1']) .sgs-ticker__fallback,
    html[data-sgs-spend-phase='2'] .sgs-ticker__static:has([data-phase='2']) .sgs-ticker__fallback,
    html[data-sgs-spend-phase='3'] .sgs-ticker__static:has([data-phase='3']) .sgs-ticker__fallback {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Offer ticker",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "A scrolling strip: the current offer in the accent colour (wording and dates in Theme settings > SixthGear: cart spend offer > Product page offer ticker; only on products that count towards it), then the points below, then the Christmas order-by line while Theme settings > SixthGear: Christmas has a date."
    },
    {
      "type": "text",
      "id": "point_1",
      "label": "Point 1",
      "default": "Free UK delivery"
    },
    {
      "type": "text",
      "id": "point_2",
      "label": "Point 2",
      "default": "Printed in the UK"
    },
    {
      "type": "text",
      "id": "point_3",
      "label": "Point 3",
      "default": "Free replacement if damaged"
    },
    {
      "type": "text",
      "id": "point_4",
      "label": "Point 4",
      "info": "Leave empty for none."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Name for screen readers",
      "default": "Offers and delivery"
    }
  ],
  "presets": [
    {
      "name": "Offer ticker"
    }
  ]
}
{% endschema %}
