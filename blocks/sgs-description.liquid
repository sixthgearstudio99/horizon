{%- liquid
  assign bs = block.settings
  assign product_resource = closest.product
  assign uid = 'SgsDesc-' | append: block.id
  assign description = product_resource.description

  # On a framed print, a paragraph or list item saying the frame is only for styling (or not
  # included) is left out
  capture sgs_framed
    render 'sgs-is-framed', product_resource: product_resource
  endcapture
  if sgs_framed contains 'true' and description != blank
    for tag in (1..2)
      if tag == 1
        assign close_tag = '</p>'
        assign open_tag = '<p'
      else
        assign close_tag = '</li>'
        assign open_tag = '<li'
      endif
      assign description = description | strip
      assign tail_from = close_tag.size | times: -1
      assign tail = description | slice: tail_from, close_tag.size
      assign pieces = description | split: close_tag
      assign kept = ''
      for piece in pieces
        assign has_close = true
        if forloop.last and tail != close_tag
          assign has_close = false
        endif
        # Only the element this close tag ends: the text after its opening tag
        assign piece_lower = piece | split: open_tag | last | append: '' | strip_html | downcase
        assign drop = false
        if has_close
          if piece_lower contains 'for styling' or piece_lower contains 'styling only' or piece_lower contains 'styling purposes' or piece_lower contains 'frame not included' or piece_lower contains 'frame is not included'
            assign drop = true
          endif
        endif
        if drop
          # Keep anything before the dropped element's opening tag (e.g. an opening <ul>)
          assign parts = piece | split: open_tag
          assign last_index = parts.size | minus: 1
          for part in parts
            if forloop.index0 == last_index
              break
            endif
            unless forloop.first
              assign kept = kept | append: open_tag
            endunless
            assign kept = kept | append: part
          endfor
        else
          assign kept = kept | append: piece
          if has_close
            assign kept = kept | append: close_tag
          endif
        endif
      endfor
      assign description = kept
    endfor
  endif

  # Long descriptions start collapsed to about five lines. Decided here from the text length,
  # so the toggle is there from the first paint and nothing shifts.
  assign plain_length = description | strip_html | strip | size
  assign collapsible = false
  if plain_length > bs.collapse_after
    assign collapsible = true
  endif
-%}

{%- if description != blank -%}
  <div class="sgs-desc{% if collapsible %} sgs-desc--collapsible{% endif %}" {{ block.shopify_attributes }}>
    {%- if bs.heading != blank -%}
      <h2 class="sgs-desc__heading sgs-label">{{ bs.heading | escape }}</h2>
    {%- endif -%}
    <div class="sgs-desc__body rte" id="{{ uid }}">{{ description }}</div>
    {%- if collapsible -%}
      <button
        type="button"
        class="sgs-desc__toggle"
        aria-expanded="false"
        aria-controls="{{ uid }}"
        data-more="{{ bs.more_label | escape }}"
        data-less="{{ bs.less_label | escape }}"
        onclick="var o=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',String(!o));this.textContent=o?this.dataset.more:this.dataset.less;"
      >
        {{- bs.more_label | escape -}}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .sgs-desc {
    width: 100%;
  }

  .sgs-desc__heading {
    margin: 0 0 14px;
    color: var(--sgs-text-2, #6b6b6b);
  }

  .sgs-desc__body {
    max-width: 65ch;
    font-family: var(--sgs-font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--sgs-text, #111111);
  }

  .sgs-desc__body > :first-child {
    margin-top: 0;
  }

  .sgs-desc__body > :last-child {
    margin-bottom: 0;
  }

  .sgs-desc__body :is(p, ul, ol) {
    margin: 0 0 1em;
  }

  .sgs-desc__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Five lines of 16px / 1.6 */
  .sgs-desc--collapsible .sgs-desc__body {
    max-height: 8em;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .sgs-desc--collapsible:has(.sgs-desc__toggle[aria-expanded='true']) .sgs-desc__body {
    max-height: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .sgs-desc__toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sgs-text, #111111);
    font-family: var(--sgs-font-mono, monospace);
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: none;
    text-decoration: underline;
    text-decoration-color: rgb(17 17 17 / 0.3);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .sgs-desc__toggle:focus-visible {
    outline: 1px solid var(--sgs-text, #111111);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product description",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Label",
      "default": "About this print"
    },
    {
      "type": "range",
      "id": "collapse_after",
      "label": "Collapse descriptions longer than",
      "min": 100,
      "max": 1000,
      "step": 50,
      "unit": "chr",
      "default": 350,
      "info": "Longer descriptions show about five lines with a Read more link."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Read less label",
      "default": "Read less"
    }
  ],
  "presets": [
    {
      "name": "Product description"
    }
  ]
}
{% endschema %}
